---
/**
 * CtaDual — セクション中間に挟む「電話＋LINE」2択CTA。
 * 計測: data-cta="{id}_tel"（phone_click→Google Ads CV）/ "{id}_line"（line_click→Google Ads CV）。
 * 配色: 電話=橙グラデ（ヒーローCTAと同系）/ LINE=#06C755。
 */
import { company } from "../data/company";
interface Props { id: string; lead?: string; }
const { id, lead = "お急ぎはお電話、写真でのお見積りはLINEが便利です" } = Astro.props;
---
<div class="xcta">
  <p class="xcta-lead">{lead}</p>
  <div class="xcta-btns">
    <a href={company.phoneTelLink} class="xcta-btn xcta-tel" data-cta={`${id}_tel`}>
      <svg viewBox="0 0 24 24" class="xcta-ic" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></svg>
      <span class="xcta-t"><b class="num">{company.phoneDisplay}</b><small>24時間365日・通話無料・タップで発信</small></span>
    </a>
    <a href={company.lineUrl} class="xcta-btn xcta-line" data-cta={`${id}_line`} target="_blank" rel="noopener">
      <span class="xcta-badge">LINE</span>
      <span class="xcta-t"><b>LINEで相談する</b><small>写真を送るだけで無料見積</small></span>
    </a>
  </div>
  <p class="xcta-rea"><span>相談だけでもOK</span><span>しつこい営業なし</span><span>見積・出張・ｷｬﾝｾﾙ0円</span></p>
  <p class="xcta-flow">お電話 → <b>最短30分</b>で到着 → その場で<b>確定見積</b> → ご納得後に作業</p>
</div>
<style>
  .xcta { max-width:480px; margin-inline:auto; padding:20px 16px; }
  .xcta-lead { text-align:center; font-weight:800; font-size:.84rem; color:#a60101; margin:0 0 11px; line-height:1.5; }
  .xcta-btns { display:flex; flex-direction:column; gap:10px; }
  .xcta-btn { display:flex; align-items:center; justify-content:center; gap:.6rem; padding:.82rem 1rem; border-radius:14px;
    text-decoration:none; color:#fff; box-shadow:0 6px 16px rgba(0,0,0,.16); text-shadow:0 1px 2px rgba(0,0,0,.32); }
  .xcta-btn:active { transform:translateY(1px); }
  .xcta-ic { width:1.7rem; height:1.7rem; flex-shrink:0; }
  .xcta-t { display:flex; flex-direction:column; line-height:1.12; align-items:flex-start; }
  .xcta-t small { font-size:.6rem; opacity:1; margin-top:2px; font-weight:700; }
  .xcta-tel { background:linear-gradient(180deg,#e8590c,#c4150c); }
  .xcta-tel .num { font-size:1.5rem; font-weight:900; letter-spacing:.01em; font-variant-numeric:tabular-nums; }
  /* 電話を主・LINEを従に：LINEは一段細く */
  .xcta-line { background:#047d36; padding-top:.55rem; padding-bottom:.55rem; }
  .xcta-line b { font-size:1rem; font-weight:900; }
  .xcta-badge { background:#fff; color:#057a35; font-weight:900; font-size:.8rem; padding:.18rem .48rem; border-radius:8px; flex-shrink:0; }
  /* 電話不安の解消＋押した後の道筋 */
  .xcta-rea { display:flex; flex-wrap:wrap; justify-content:center; gap:.25rem .7rem; margin:.75rem 0 0; padding:0; }
  .xcta-rea span { font-size:.7rem; font-weight:800; color:#0a7d28; }
  .xcta-rea span::before { content:"✓ "; }
  .xcta-flow { text-align:center; font-size:.66rem; font-weight:700; color:#6b5d4a; margin:.45rem 0 0; line-height:1.55; }
  .xcta-flow b { color:#c4150c; }
  /* PC: 横並び＋幅拡大（モバイル不変） */
  @media (min-width:900px){
    .xcta { max-width:820px; padding:26px 16px; }
    .xcta-btns { flex-direction:row; }
    .xcta-btn { flex:1; padding:1rem 1rem; }
  }
</style>
