---
/**
 * 現場スタッフ紹介カード（実在性・顔出しの信頼ブロック）
 * 記載は事実のみ: 氏名・経歴年数は確定値。資格・件数などの未確定値は書かない。
 */
import { assetPath } from "../lib/site";
---

<div class="xstaff">
  <img class="xstaff-ph" src={assetPath("images/staff/takimoto.webp")} width="640" height="640"
    alt="専用防護服を着用した現場スタッフの瀧本" loading="lazy" decoding="async" />
  <div class="xstaff-bd">
    <p class="xstaff-role">現場スタッフ</p>
    <p class="xstaff-name">瀧本<small>（たきもと）</small><span class="xstaff-exp">蜂駆除歴5年</span></p>
    <p class="xstaff-msg">「お伺いしたら、まず巣の場所と蜂の種類を確かめ、<b>作業前に確定金額をご説明します</b>。ご納得いただくまで作業は始めません。お子さまやペットのいるお宅では、安全の段取りをいちばん丁寧に。蜂が怖いのは当たり前です。<b>近づかずに、そのままお任せください</b>。」</p>
    <ul class="xstaff-pts" aria-label="現場対応の約束">
      <li>専用防護服・機材で安全第一</li>
      <li>現地で確定見積・ご納得後に作業</li>
      <li>ご家族へ総額を電話共有・立ち会いOK</li>
    </ul>
  </div>
</div>

<style>
  .xstaff { display: flex; gap: 14px; align-items: flex-start; background: #fff; border: 1px solid #eadfce; border-radius: 14px; padding: 14px; margin-top: 14px; box-shadow: 0 2px 10px rgba(60, 40, 10, .06); }
  .xstaff-ph { width: 112px; height: 112px; border-radius: 12px; object-fit: cover; flex: none; display: block; }
  .xstaff-bd { min-width: 0; }
  .xstaff-role { font-size: 11px; color: #8a6d3b; letter-spacing: .08em; margin: 0 0 2px; font-weight: 700; }
  .xstaff-name { font-size: 18px; font-weight: 900; margin: 0 0 6px; line-height: 1.3; }
  .xstaff-name small { font-size: 11px; font-weight: 600; color: #777; margin-left: 3px; }
  .xstaff-exp { display: inline-block; font-size: 11px; font-weight: 800; color: #b3541e; background: #fdf1e3; border-radius: 999px; padding: 2px 9px; margin-left: 8px; vertical-align: 2px; white-space: nowrap; }
  .xstaff-msg { font-size: 13px; line-height: 1.75; margin: 0 0 8px; }
  .xstaff-pts { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .xstaff-pts li { font-size: 11px; font-weight: 700; background: #f6f1e7; border-radius: 6px; padding: 3px 8px; color: #5c4a22; }
  @media (max-width: 430px) {
    .xstaff { padding: 12px; gap: 12px; }
    .xstaff-ph { width: 92px; height: 92px; }
    .xstaff-name { font-size: 16px; }
    .xstaff-exp { margin-left: 6px; }
  }
</style>
