---
/**
 * SiteFooter — 法的リンク＋著作権（軽量）。
 * 会社情報（運営/所在地/電話/事業/対応/支払）は重複を避け
 * プライバシーポリシー・会社情報ページ(/privacy-policy/)に集約。
 */
import { company } from "../data/company";
import { assetPath } from "../lib/site";
const year = 2026;
---
<footer class="xfoot">
  <div class="xfoot-inner">
    <p class="xfoot-brand">{company.name}</p>
    <p class="xfoot-sub">{company.serviceArea}のハチ駆除専門</p>
    <nav class="xfoot-links" aria-label="コラム・会社情報・法的情報">
      <a href={assetPath("column/")}>蜂の知識コラム</a>
      <a href={assetPath("privacy-policy/")}>プライバシーポリシー・会社情報</a>
      <a href={assetPath("legal/")}>特定商取引法に基づく表示</a>
    </nav>
    <p class="xfoot-copy">© {year} {company.legalName}</p>
  </div>
</footer>
<style>
  .xfoot { background:#241a0e; color:#cfc4b2; }
  .xfoot-inner { max-width:480px; margin:0 auto; padding:26px 18px 30px; }
  .xfoot-brand { color:#fff; font-weight:900; font-size:.98rem; margin:0 0 4px; }
  .xfoot-sub { margin:0 0 16px; font-size:.7rem; color:#9a8c74; }
  .xfoot-links { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; margin:0 0 14px; }
  .xfoot-links a { color:#f0e6d4; text-decoration:underline; font-weight:700; font-size:.78rem; }
  .xfoot-copy { margin:0; color:#b3a489; font-size:.66rem; }
  @media (max-width:767px){ .xfoot-inner { padding-bottom:86px; } }
</style>
