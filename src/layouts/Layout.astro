---
interface Props {
  title: string;
  description: string;
  extraJsonLd?: Record<string, unknown>[];
  /** 広告専用着地ページ等で検索インデックスを抑止（doorway回避） */
  noindex?: boolean;
  /** モバイルLCP画像。各ページの実ヒーロー画像を高優先preloadするため上書き。既定は汎用 hero-mob-photo */
  lcpMobileImage?: string;
}

import "../styles/global.css";
import { assetPath, homePath, siteConfig } from "../lib/site";
import { faqsToJsonLd } from "../data/faq";
import { company, tracking } from "../data/company";
import { rates } from "../data/rates";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";

const { title, description, extraJsonLd = [], noindex = false, lcpMobileImage = "images/generated/hero-mob-photo.webp" } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(homePath, siteUrl).toString();
const ogImage = new URL(assetPath(siteConfig.ogImage), siteUrl).toString();
const faviconUrl = assetPath("favicon.svg");
const logoUrl = new URL(assetPath("logo.svg"), siteUrl).toString();

// LocalBusiness（@id 参照型）
const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${homeUrl}#localbusiness`,
  name: company.name,
  legalName: company.legalName,
  alternateName: "蜂の巣駆除ファクトリー東海",
  slogan: "名古屋・愛知の蜂の巣駆除を、自社施工と明朗会計で即日対応。",
  description:
    "愛知県全域・名古屋近郊（岐阜県南部・三重県北部）でアシナガバチ・スズメバチ（オオスズメバチ含む）の駆除に年中無休で対応（電話受付7:00〜21:00・LINEは24時間）。ご相談が最も多いアシナガバチと、危険なスズメバチをメインに、その他の蜂も対応。最短30分で緊急出動、標準ケースは上限つき（アシナガ19,800円・スズメ29,800円）で事前見積金額厳守・追加請求なし、1年再発保証。",
  telephone: company.phone,
  url: homeUrl,
  image: ogImage,
  logo: {
    "@type": "ImageObject",
    "@id": `${homeUrl}#logo`,
    url: logoUrl,
    width: 360,
    height: 360,
    caption: `${company.name} ロゴ`,
  },
  priceRange: "標準ケース上限: アシナガバチ¥19,800・スズメバチ¥29,800",
  knowsAbout: [
    "スズメバチ駆除",
    "オオスズメバチ駆除",
    "アシナガバチ駆除",
    "ミツバチ駆除",
    "クマバチ駆除",
    "ドロバチ駆除",
    "蜂の巣撤去",
    "再発防止施工",
    "害虫駆除",
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "07:00",
      closes: "21:00",
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    addressRegion: company.address.region,
    postalCode: company.address.postal,
    addressCountry: "JP",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: company.geo.lat,
    longitude: company.geo.lng,
  },
  areaServed: areas.flatMap((area) =>
    area.cities
      .filter((c) => !c.includes("他全市町村"))
      .map((city) => ({
        "@type": "City",
        name: city.replace(/全区$/, ""),
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: area.prefecture,
        },
      }))
      .slice(0, 6)
  ),
  contactPoint: {
    "@type": "ContactPoint",
    telephone: company.phone,
    contactType: "customer service",
    areaServed: ["JP"],
    availableLanguage: ["Japanese"],
    hoursAvailable: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "07:00",
      closes: "21:00",
    },
  },
  // NOTE: aggregateRating は実レビュー収集後に復活。架空データでの送信は Manual Action リスクのため当面削除。
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "蜂駆除サービスメニュー",
    itemListElement: rates.map((r) => {
      // アシナガ/スズメは標準ケース上限（19,800/29,800）を確定priceとして出力。
      // ミツバチ/オオスズメバチ/クマバチ等（basicPrice==='現地見積'）は確定額を持たないため
      // price を出さない（青天井ではなく現地確定＝虚偽の確定額表示を避ける）。
      const hasFixedPrice = r.basicPrice !== "現地見積";
      const offer: Record<string, unknown> = {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: `${r.beeType}駆除`,
          description: `${r.rangePrice}（巣の大きさ・場所により変動）。事前見積金額の範囲内で作業し、追加請求なし（範囲変更時は事前確認）。`,
          provider: { "@id": `${homeUrl}#localbusiness` },
          areaServed: "愛知県・名古屋近郊（岐阜県南部・三重県北部）",
        },
        url: `${homeUrl}#price`,
      };
      if (hasFixedPrice) {
        offer.priceCurrency = "JPY";
        offer.price = r.basicPriceNum;
      }
      return offer;
    }),
  },
};

// Organization
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${homeUrl}#organization`,
  name: company.name,
  legalName: company.legalName,
  url: homeUrl,
  logo: logoUrl,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: company.phone,
    contactType: "customer service",
  },
};

// HowTo（駆除の流れ）
const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "蜂駆除のご依頼から完了までの流れ",
  description:
    "電話・LINE相談から最短30分で現地到着、確定見積、駆除作業、完了・1年保証まで。",
  totalTime: "PT2H",
  step: flowSteps.map((step, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: step.title,
    text: step.description,
    url: `${homeUrl}#flow-step-${step.num}`,
  })),
};

// BreadcrumbList（3階層 — リッチリザルト最適化）
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "ホーム",
      item: homeUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "蜂駆除サービス",
      item: `${homeUrl}#price`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "愛知・名古屋近郊エリア",
      item: `${homeUrl}#area`,
    },
  ],
};

// FAQPage
const faqJsonLd = faqsToJsonLd();

const allJsonLd = [
  localBusinessJsonLd,
  organizationJsonLd,
  howToJsonLd,
  breadcrumbJsonLd,
  faqJsonLd,
  ...extraJsonLd,
];
---

<!doctype html>
<html lang="ja-JP">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta
      name="keywords"
      content="蜂駆除,ハチ駆除,蜂の巣駆除,スズメバチ,オオスズメバチ,アシナガバチ,ミツバチ,愛知,名古屋,岐阜,三重,東海,即日対応"
    />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.google.co.jp https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://www.clarity.ms https://c.clarity.ms https://c.bing.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.google.co.jp https://www.googleadservices.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net https://ad.doubleclick.net https://*.clarity.ms https://formspree.io; frame-src https://td.doubleclick.net; form-action 'self' https://formspree.io"
    />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang (日本のみだが明示でシグナル強化) -->
    <link rel="alternate" hreflang="ja-JP" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" href={assetPath("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <link rel="icon" href={assetPath("favicon-96.png")} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={assetPath("apple-touch-icon.png")} />
    <link rel="manifest" href={assetPath("site.webmanifest")} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${company.name}｜名古屋・愛知の蜂の巣駆除`} />
    <meta property="og:site_name" content={`${company.name}｜名古屋・愛知の蜂の巣駆除`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- LCP高速化: 実LCP要素を高優先で先読み。
         mobile(<900px)=HTMLヒーロー実写真 hero-mob-photo / PC(≥900px)=HTMLヒーロー背景 hero-pc-bg。media属性で該当幅だけ先読み -->
    <link rel="preload" as="image" type="image/webp" fetchpriority="high"
      href={assetPath(lcpMobileImage)} media="(max-width: 899px)" />
    <link rel="preload" as="image" type="image/webp" fetchpriority="high"
      href={assetPath("images/generated/hero-pc-bg.webp")} media="(min-width: 900px)" />

    <!-- 初期表示制御：トップへリセット -->
    <script is:inline>
      (function () {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";

        // 初期スクロール制御:
        //  - ハッシュ無し → 従来どおりトップ表示にリセット
        //  - ハッシュ有り（例: Google広告サイトリンク /#price）→ 該当セクションへ
        //    スクロール（ヘッダーオフセット考慮）。ハッシュは保持し、トップ強制しない。
        var hash = window.location.hash;
        var hasHash = !!(hash && hash.length > 1);
        var toTop = function () { window.scrollTo(0, 0); };
        var scrollToHash = function () {
          var el = null;
          try { el = document.querySelector(hash); } catch (_) { return; }
          if (!el) return;
          var headerH =
            (document.querySelector(".header") ? document.querySelector(".header").offsetHeight : 0) +
            (document.querySelector(".topbar") ? document.querySelector(".topbar").offsetHeight : 0);
          var top = el.getBoundingClientRect().top + window.pageYOffset - headerH - 8;
          window.scrollTo({ top: top, behavior: "auto" });
        };

        if (!hasHash) {
          toTop();
          document.addEventListener("DOMContentLoaded", toTop);
          window.addEventListener("load", toTop);
        } else {
          document.addEventListener("DOMContentLoaded", scrollToHash);
          window.addEventListener("load", function () { setTimeout(scrollToHash, 150); });
        }
        window.addEventListener("pageshow", function (e) {
          if (!e.persisted) return;
          if (hasHash) { scrollToHash(); } else { toTop(); }
        });
      })();
    </script>

    <!-- Performance: DNS Prefetch / Preconnect for 3rd parties -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://formspree.io" />

    <!-- Fonts: self-host subset（Google Fonts全廃＝render-blocking CSS 208KB除去・46→数req・same-origin）。
         実HTML使用文字のみ subset / 生成: scripts/build-fonts.py。欠落字は font-family stack の system フォントへ fallback（tofu化しない）。
         Noto可変1ファイル(400-900)を高優先 preload。M PLUS 1p/Reggae One は per-use（PCヒーロー/legalページでのみ実ロード）。 -->
    <link rel="preload" as="font" type="font/woff2"
      href={assetPath("fonts/notosansjp-var.woff2")} crossorigin />
    <style is:inline>
      @font-face{font-family:"Noto Sans JP";font-style:normal;font-weight:400 900;font-display:swap;src:url("/fonts/notosansjp-var.woff2") format("woff2")}
      @font-face{font-family:"Inter";font-style:normal;font-weight:700;font-display:swap;src:url("/fonts/inter-700.woff2") format("woff2")}
      @font-face{font-family:"M PLUS 1p";font-style:normal;font-weight:900;font-display:swap;src:url("/fonts/mplus1p-900.woff2") format("woff2")}
      @font-face{font-family:"Reggae One";font-style:normal;font-weight:400;font-display:swap;src:url("/fonts/reggaeone-400.woff2") format("woff2")}
    </style>

    <!-- 計測タグ: GTM / GA4 / Google Ads（src/data/company.ts の tracking で管理） -->
    <!-- GTM_ID 未設定でも GA4_ID 単体で動作。CWV保護のため 3秒遅延ロード。 -->
    <script is:inline define:vars={{ tracking }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };

      // === CV計測タグ(gtag.js)は eager 初期化＆ロード ===
      // 旧実装は gtag.js を 800ms/初回操作まで遅延 → 「初回操作がいきなり電話タップ」だと
      // gtag未ロード＋dataLayer順序崩れで 電話タップCV ping が消失（LP_電話タップ=0/要確認 の原因）。
      // Ads/GA4 を即時初期化（タップ前に準備＋順序保証＋Googleのタグ検証が通る）。重いClarity/GTMのみ遅延維持。
      window.gtag("js", new Date());
      if (tracking.gadsConversionId) {
        window.gtag("config", tracking.gadsConversionId);
      }
      if (tracking.ga4Id) {
        window.gtag("config", tracking.ga4Id, { send_page_view: true });
      }
      (function () {
        var primaryId = tracking.ga4Id || tracking.gadsConversionId;
        if (!primaryId) return;
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + primaryId;
        document.head.appendChild(s);
      })();

      // 共通 CV イベント送信関数（電話/LINE/フォームから呼び出し）
      // - GA4: 標準 event として送信
      // - Google Ads: conversion label が設定されていれば conversion event として送信
      window.trackConversion = function (eventName, params) {
        params = params || {};
        // 1) dataLayer に push（GTM 経由用）
        window.dataLayer.push(Object.assign({ event: eventName }, params));
        // 2) gtag 直接送信（GA4 用、GTM未設定でも動く）
        //    transport_type:'beacon' で tel: 遷移時も sendBeacon により ping を取りこぼさない
        if (window.gtag && typeof window.gtag === "function") {
          var ga4Params = Object.assign({}, params);
          delete ga4Params.event_callback;
          delete ga4Params.event_timeout;
          ga4Params.transport_type = "beacon";
          window.gtag("event", eventName, ga4Params);
        }
        // 3) Google Ads conversion event 発火（コンバージョンラベル設定時のみ）
        //    beacon + event_callback で tel: 遷移前に CV ping を確実に送る
        if (window.gtag && tracking.gadsConversionId && tracking.gadsConversionLabels) {
          var labelMap = {
            phone_click: tracking.gadsConversionLabels.phoneClick,
            line_click: tracking.gadsConversionLabels.lineClick,
            form_submit: tracking.gadsConversionLabels.formSubmit,
          };
          var label = labelMap[eventName];
          // 受動要素（data-cta が *_dial）は探索タップであり発信意図の証明にならないため
          // Ads CV には送らない（GA4 へは上で送信済み）。明示 CTA のみが Ads CV 対象。
          if (label && params.cta_id && params.cta_id.indexOf("_dial") !== -1) {
            if (typeof params.event_callback === "function") {
              params.event_callback(); // Ads ping なし → 発信を待たせない
            }
            label = null;
          }
          if (label) {
            window.gtag("event", "conversion", {
              send_to: tracking.gadsConversionId + "/" + label,
              value: 0.0,
              currency: "JPY",
              transaction_id: "",
              transport_type: "beacon",
              event_callback: params.event_callback,
              event_timeout: params.event_timeout || 1000,
            });
          }
        }
      };

      // 電話/LINE/フォーム CTA の自動計測（クリック委譲）
      document.addEventListener("click", function (e) {
        var target = e.target.closest("[data-cta]");
        if (!target) return;
        var ctaId = target.getAttribute("data-cta");
        var href = target.getAttribute("href");
        var isTel = href && href.indexOf("tel:") === 0;
        var eventName = isTel ? "phone_click"
                      : ctaId.indexOf("line") !== -1 ? "line_click"
                      : "cta_click";

        // tel: のみ: CV ping を遷移前に保証しつつ、発信は fail-safe で必ず実行する
        if (isTel && href && href.indexOf("tel:") === 0) {
          e.preventDefault();
          // gtag は上部で eager ロード済み。ここでの先読みは不要。
          var navigated = false;
          var go = function () {
            if (navigated) return;
            navigated = true;
            window.location.href = href; // 電話発信
          };
          try {
            window.trackConversion(eventName, {
              cta_id: ctaId,
              page_path: location.pathname,
              event_callback: go,    // ping 完了後に発信
              event_timeout: 1000,
            });
          } finally {
            // ping 遅延/失敗/未ロードでも必ず発信（電話を絶対に阻害しない）
            setTimeout(go, 1100);
          }
          return;
        }

        // tel: 以外は従来通り（遷移を妨げない）
        window.trackConversion(eventName, {
          cta_id: ctaId,
          page_path: location.pathname,
        });
      });

      // CWV保護: 重いタグ（Clarity/GTM）のみ遅延ロード。
      // CV計測の要 gtag.js は上部で eager ロード済み（遅延しない）。
      var heavyLoaded = false;
      function loadHeavyTags() {
        if (heavyLoaded) return;
        heavyLoaded = true;

        // Microsoft Clarity — CLARITY_PROJECT_ID 設定時のみ
        if (tracking.clarityProjectId) {
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", tracking.clarityProjectId);
        }

        // GTM — GTM_ID 設定時のみ
        if (tracking.gtmId) {
          (function (w, d, s, l, i) {
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l !== "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", tracking.gtmId);
        }
      }
      setTimeout(loadHeavyTags, 2000);
      ["scroll", "click", "touchstart", "keydown"].forEach(function (ev) {
        window.addEventListener(ev, loadHeavyTags, { once: true, passive: true });
      });

      // 受付バッジ: 電話受付(7〜21時)は「ただ今受付中」、夜間はLINE表記へ切替（深夜の不正確表示を是正＋夜間はLINE誘導）
      document.addEventListener("DOMContentLoaded", function () {
        var now = new Date();
        var jst = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Tokyo" }));
        var h = jst.getHours();
        var inPhoneHours = h >= 7 && h < 21;
        var txt = inPhoneHours ? "ただ今受付中" : "LINE受付中";
        var els = document.querySelectorAll(".xh-now-tx");
        for (var i = 0; i < els.length; i++) els[i].textContent = txt;
        if (!inPhoneHours) {
          var floatEl = document.querySelector(".xfloat");
          if (floatEl) floatEl.classList.add("xfloat-night");
          var telMain = document.querySelector(".xfloat-tel .xfloat-tx b");
          var telSub = document.querySelector(".xfloat-tel .xfloat-tx small");
          var lineMain = document.querySelector(".xfloat-line .xfloat-tx b");
          var lineSub = document.querySelector(".xfloat-line .xfloat-tx small");
          if (lineMain) lineMain.textContent = "LINEで写真見積り";
          if (lineSub) lineSub.textContent = "24時間受付";
          if (telMain) telMain.textContent = "朝7時から電話受付";
          if (telSub) telSub.textContent = "番号を保存";
        }
      });
    </script>

    <!-- JSON-LD: 構造化データ6種（LocalBusiness/Organization/HowTo/BreadcrumbList/FAQPage/OfferCatalog内蔵） -->
    {
      allJsonLd.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body>
    <slot />

    <!-- JS有効化マーカー（reveal の初期非表示はこのクラスがある時だけ適用） -->
    <script is:inline>
      document.documentElement.classList.add("js-ready");
      document.body.classList.add("js-ready");
    </script>
  </body>
</html>
