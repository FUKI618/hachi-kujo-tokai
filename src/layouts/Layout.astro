---
interface Props {
  title: string;
  description: string;
  extraJsonLd?: Record<string, unknown>[];
}

import "../styles/global.css";
import { assetPath, homePath, siteConfig } from "../lib/site";
import { faqsToJsonLd } from "../data/faq";
import { company } from "../data/company";
import { rates } from "../data/rates";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";

const { title, description, extraJsonLd = [] } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(homePath, siteUrl).toString();
const ogImage = new URL(assetPath(siteConfig.ogImage), siteUrl).toString();
const faviconUrl = assetPath("favicon.svg");
const logoUrl = new URL(assetPath("logo.svg"), siteUrl).toString();

// LocalBusiness（@id 参照型）
const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${homeUrl}#localbusiness`,
  name: company.name,
  legalName: company.legalName,
  alternateName: "Tokai Hachi Kyukyutai",
  slogan: "蜂の巣、今すぐ救急出動。",
  description:
    "東海エリア（愛知・岐阜・三重・静岡）で24時間365日救急対応の蜂・蜂の巣駆除サービス。最短30分で緊急出動、基本料金3,300円〜、事前見積金額厳守、1年再発保証。請負業者賠償責任保険1億円加入。",
  telephone: company.phone,
  url: homeUrl,
  image: ogImage,
  logo: {
    "@type": "ImageObject",
    "@id": `${homeUrl}#logo`,
    url: logoUrl,
    width: 360,
    height: 360,
    caption: `${company.name} ロゴ`,
  },
  priceRange: "¥3,300〜",
  knowsAbout: [
    "スズメバチ駆除",
    "オオスズメバチ駆除",
    "アシナガバチ駆除",
    "ミツバチ駆除",
    "クマバチ駆除",
    "ドロバチ駆除",
    "蜂の巣撤去",
    "再発防止施工",
    "害虫駆除",
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "00:00",
      closes: "23:59",
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    addressRegion: company.address.region,
    postalCode: company.address.postal,
    addressCountry: "JP",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: company.geo.lat,
    longitude: company.geo.lng,
  },
  areaServed: areas.flatMap((area) =>
    area.cities
      .filter((c) => !c.includes("他全市町村"))
      .map((city) => ({
        "@type": "City",
        name: city.replace(/全区$/, ""),
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: area.prefecture,
        },
      }))
      .slice(0, 6)
  ),
  contactPoint: {
    "@type": "ContactPoint",
    telephone: company.phone,
    contactType: "customer service",
    areaServed: ["JP"],
    availableLanguage: ["Japanese"],
    hoursAvailable: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "00:00",
      closes: "23:59",
    },
  },
  // NOTE: aggregateRating は実レビュー収集後に復活。架空データでの送信は Manual Action リスクのため当面削除。
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "蜂駆除サービスメニュー",
    itemListElement: rates.map((r) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: `${r.beeType}駆除`,
        description: `基本料金${r.basicPrice}・想定価格帯${r.rangePrice}。事前見積金額厳守で1円も追加請求なし。`,
        provider: { "@id": `${homeUrl}#localbusiness` },
        areaServed: "東海地方（愛知・岐阜・三重・静岡）",
      },
      priceCurrency: "JPY",
      price: company.basicPrice,
      url: `${homeUrl}#price`,
    })),
  },
};

// Organization
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${homeUrl}#organization`,
  name: company.name,
  legalName: company.legalName,
  url: homeUrl,
  logo: logoUrl,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: company.phone,
    contactType: "customer service",
  },
};

// HowTo（駆除の流れ）
const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "蜂駆除のご依頼から完了までの流れ",
  description:
    "電話・LINE相談から最短30分で現地到着、確定見積、駆除作業、完了・1年保証まで。",
  totalTime: "PT2H",
  step: flowSteps.map((step, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: step.title,
    text: step.description,
    url: `${homeUrl}#flow-step-${step.num}`,
  })),
};

// BreadcrumbList（3階層 — リッチリザルト最適化）
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "ホーム",
      item: homeUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "蜂駆除サービス",
      item: `${homeUrl}#price`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "東海エリア（愛知・岐阜・三重・静岡）",
      item: `${homeUrl}#areas`,
    },
  ],
};

// FAQPage
const faqJsonLd = faqsToJsonLd();

const allJsonLd = [
  localBusinessJsonLd,
  organizationJsonLd,
  howToJsonLd,
  breadcrumbJsonLd,
  faqJsonLd,
  ...extraJsonLd,
];
---

<!doctype html>
<html lang="ja-JP">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="蜂駆除,ハチ駆除,蜂の巣駆除,スズメバチ,オオスズメバチ,アシナガバチ,ミツバチ,愛知,岐阜,三重,静岡,名古屋,東海,即日対応,24時間"
    />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://fonts.googleapis.com https://fonts.gstatic.com https://formspree.io; form-action 'self' https://formspree.io"
    />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang (日本のみだが明示でシグナル強化) -->
    <link rel="alternate" hreflang="ja-JP" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={faviconUrl} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${company.name}｜東海エリア蜂駆除サービス`} />
    <meta property="og:site_name" content={`${company.name}｜東海エリア蜂駆除`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ヒーロー画像プリロード -->
    <link
      rel="preload"
      as="image"
      href={assetPath("images/hero/hero-main-1400.webp")}
      imagesrcset={`${assetPath("images/hero/hero-main-480.webp")} 480w, ${assetPath("images/hero/hero-main-800.webp")} 800w, ${assetPath("images/hero/hero-main-1400.webp")} 1400w`}
      imagesizes="(max-width: 880px) 100vw, 50vw"
    />

    <!-- 初期表示制御：トップへリセット -->
    <script is:inline>
      (function () {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        if (window.location.hash) {
          history.replaceState(null, "", window.location.pathname + window.location.search);
        }
        var toTop = function () { window.scrollTo(0, 0); };
        toTop();
        document.addEventListener("DOMContentLoaded", toTop);
        window.addEventListener("load", toTop);
        window.addEventListener("pageshow", function (e) { if (e.persisted) toTop(); });
      })();
    </script>

    <!-- Performance: DNS Prefetch / Preconnect for 3rd parties -->
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://formspree.io" />

    <!-- Fonts: 非同期読み込み（preload+noscript方式は禁止：Astro が noscript の link を外に出す問題回避） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      (function () {
        var l = document.createElement("link");
        l.rel = "stylesheet";
        l.href =
          "https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap";
        document.head.appendChild(l);
      })();
    </script>

    <!-- Alpine.js（FAQ・Floating CTA で使用） -->
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- GTM: 3秒遅延（Core Web Vitals 保護）— DIFF-POINT: GTM-ID を確定後に置換 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      // GTM-XXXXXXX を実IDに差し替え
      var GTM_ID = "GTM-XXXXXXX";
      if (GTM_ID && GTM_ID !== "GTM-XXXXXXX") {
        setTimeout(function () {
          (function (w, d, s, l, i) {
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l !== "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", GTM_ID);
        }, 3000);
      }
    </script>

    <!-- JSON-LD: 構造化データ6種（LocalBusiness/Organization/HowTo/BreadcrumbList/FAQPage/OfferCatalog内蔵） -->
    {
      allJsonLd.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body>
    <slot />

    <!-- JS有効化マーカー（reveal の初期非表示はこのクラスがある時だけ適用） -->
    <script is:inline>
      document.documentElement.classList.add("js-ready");
      document.body.classList.add("js-ready");
    </script>
  </body>
</html>
