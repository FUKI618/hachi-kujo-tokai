---
/**
 * スズメバチ特化 集客LP (/suzumebachi)
 * AG7-スズメバチ特化（スズメバチ 駆除 系KW）の着地。クエリ⇄LP関連性を最大化しLP体験QSを上げる。
 * - index.astro / nagoya.astro / ashinagabachi.astro は一切改変しない（独立ページ）
 * - Layout / CtaDual / StaffCard を流用、デザインは nagoya/ashinagabachi と同一（.xhero / .ng トークン）
 * - コンテンツは suzumebachi-tokushu / suzumebachi-kujo-ryokin 記事＋競合専門性調査を凝縮
 * - 「スズメバチを知り尽くしたプロ」= 4種判別・巣の進化・場所別・施工6手順で専門性を証明
 * - honest厳守：捏造数値なし。ヒーロー写真は実LPのマーブル巣撤去写真を流用（蜂ゼロ=施工手順どおり）
 * - noindex：広告専用着地のためdoorway/重複回避
 */
import Layout from "../layouts/Layout.astro";
import CtaDual from "../components/CtaDual.astro";
import StaffCard from "../components/StaffCard.astro";
import LocationCard from "../components/LocationCard.astro";
import NestGrowthChart from "../components/NestGrowthChart.astro";
import { company } from "../data/company";
import { rates } from "../data/rates";
import {
  suzumeAreas,
  suzumeAreaNote,
  suzumeCases,
  suzumeVoices,
  suzumeSpecies,
  suzumeSteps,
} from "../data/suzumebachi";
import { assetPath, homePath } from "../lib/site";

const title = "スズメバチ駆除は名古屋の自社施工が最短30分｜追加0円・1年保証｜蜂の巣駆除ファクトリー東海";
const description =
  "スズメバチの巣の駆除は東海の自社スタッフが最短30分で直接対応。名古屋の相場15,000〜30,000円が中心、上限つきの明朗会計・見積後の追加請求0円・1年保証。オオスズメバチ・キイロスズメバチ・屋根裏・軒下・土の中の巣まで防護装備の専門対応。受付は電話7時〜21時・LINE24時間。";
const a = company.address;
const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi",
  "スズメバチ": "suzumebachi",
  "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi",
  "クマバチ・その他": "kumabachi",
};
/** スズメバチLPなのでスズメバチ系を先頭に並べ替え（データは共通SSOT） */
const rateOrder = ["スズメバチ", "オオスズメバチ", "アシナガバチ", "ミツバチ", "クマバチ・その他"];
const sortedRates = [...rates].sort((x, y) => rateOrder.indexOf(x.beeType) - rateOrder.indexOf(y.beeType));
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(homePath, siteUrl).toString();

/** 巣の大きさ×料金の視覚図（早い＝小さい＝安い）。相場: 名古屋実測15,000〜30,000中心＋巣サイズ加算 */
const suzumeStages = [
  { term: "4〜6月", size: "とっくり型・〜10cm", price: "基本料金のみ", tone: "ok" as const, dot: 34 },
  { term: "7〜8月", size: "球体に急成長・20〜30cm", price: "目安 +8,000〜9,000円", tone: "warn" as const, dot: 58 },
  { term: "9〜10月", size: "最大級・40cm〜", price: "上限29,800円まで", tone: "danger" as const, dot: 82 },
];

const faq = [
  {
    q: "スズメバチを一匹殺すと仲間が来るというのは本当ですか？",
    a: "本当です。スズメバチは攻撃時に警報フェロモンを出し、近くの仲間を一斉に呼び寄せます。巣の近くで叩いたり潰したりは絶対に避け、静かにその場を離れてください。飛んでいる蜂を見かけたら、巣が近くにある可能性が高いのでご相談ください。",
  },
  {
    q: "小さい巣なら市販スプレーで自分で駆除できますか？",
    a: "スズメバチはおすすめしません。初期のとっくり型でも女王蜂は反撃しますし、7月以降の巣は働き蜂が集団で襲ってきます。毒性・攻撃性ともに蜂の中で最も高く、毎年死亡事故が起きているのはほぼスズメバチです。当社なら初期の巣は費用も抑えられます。",
  },
  {
    q: "天井や壁から羽音がします。スズメバチでしょうか？",
    a: "屋根裏や壁の中はキイロスズメバチ・モンスズメバチがよく巣を作る場所です。閉め切った室内で蜂を見かける場合も屋内側の営巣が疑われます。巣が見えなくても、蜂の出入り口から位置を特定できますので、そのままご相談ください。",
  },
  {
    q: "駆除した後、蜂が戻ってきませんか？",
    a: "駆除時に外出していた「戻り蜂」が数日間、巣のあった場所に集まることがあります。当社は薬剤処理とトラップで戻り蜂まで対処し、巣跡の処理と侵入口の封鎖も実施。1年以内に同じ場所に再発した場合は無償で対応します。",
  },
  {
    q: "オオスズメバチかもしれません。対応できますか？",
    a: "対応できます。オオスズメバチは土の中や木の根元に巣を作るため、気づかず踏み込むのが最も危険です。地面から蜂が出入りしている場所には絶対に近づかず、位置だけ覚えてお電話ください。防護装備の専門スタッフが対応します。",
  },
];

const suzumeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "スズメバチ駆除" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "スズメバチ駆除",
    provider: {
      "@type": "LocalBusiness",
      name: company.name,
      telephone: company.phone,
      address: {
        "@type": "PostalAddress",
        postalCode: a.postal,
        addressRegion: a.region,
        addressLocality: a.city,
        streetAddress: a.street,
      },
    },
    areaServed: [
      { "@type": "AdministrativeArea", name: "愛知県" },
      { "@type": "AdministrativeArea", name: "岐阜県南部" },
      { "@type": "AdministrativeArea", name: "三重県北部" },
    ],
    offers: { "@type": "Offer", price: 29800, priceCurrency: "JPY" },
  },
];
---

<Layout title={title} description={description} noindex={true} extraJsonLd={suzumeJsonLd}>
  <!-- sr-only 実h1（スズメバチ・QS） -->
    <h1 class="x-sr">スズメバチ駆除｜東海の自社スタッフが最短30分で現場到着・名古屋の相場15,000〜30,000円が中心・上限つきの明朗会計・追加0円・1年保証・オオスズメバチ・キイロスズメバチ・屋根裏対応・受付は電話7時〜21時／LINE24時間 {company.phoneDisplay}</h1>

    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
      <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    </svg>

    <!-- ===== HERO（元LPの焼込みチラシを流用・スズメバチ化／2:3固定・%絶対配置） ===== -->
    <div class="xhero">
      <img class="xh-photo" src={assetPath("images/generated/hero-mob-photo-suzume.webp")} width="1024" height="418"
        alt="スズメバチ駆除の専門スタッフが薬剤処理後のマーブル模様の巣を軒下から取り外す様子" loading="eager" decoding="async" fetchpriority="high" />
      <div class="xh-bar" aria-hidden="true">スズメバチ駆除・東海対応・<b>最短30分</b>で出動</div>
      <div class="xh-brand">
        <img class="xh-logo" src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" aria-hidden="true" />
        <span class="xh-btext"><b class="xh-bname">{company.name}</b><small class="xh-btag">スズメバチ・蜂の巣駆除の専門対応</small></span>
        <a class="xh-headtel" href={company.phoneTelLink} data-cta="suzume_header_tel">
          <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
          <span class="xh-headtel-tx"><b class="font-num">{company.phoneDisplay}</b><small>受付7時〜21時</small></span>
        </a>
      </div>
      <div class="xh-banner" aria-hidden="true"><span><em>そのまま放置</em><i>すると</i><b>危険！</b></span></div>
      <p class="xh-h1" aria-hidden="true">スズメバチ駆除</p>
      <p class="xh-h2" aria-hidden="true">完全防護・確実撤去・再発防止</p>
      <p class="xh-price" aria-hidden="true">
        <span class="xhp-cell"><small>最短</small><b class="xhp-num">30</b><small>分</small></span>
        <span class="xhp-div"></span>
        <span class="xhp-cell"><small>危険を</small><b class="xhp-num">解消</b></span>
      </p>
      <a class="xh-cta" href={company.phoneTelLink} data-cta="suzume_hero_tel">
        <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="xh-cta-tx">
          <small class="xh-cta-top">＼今すぐお電話で不安も駆除／</small>
          <b class="xh-cta-num font-num">{company.phoneDisplay}</b>
          <small class="xh-cta-bot">通話無料・受付7時〜21時・タップで発信</small>
        </span>
      </a>
      <span class="xh-now" aria-hidden="true"><i class="xh-now-dot"></i><span class="xh-now-tx">ただ今受付中</span></span>
      <span class="xcpn" aria-hidden="true"><span class="xcpn-body"><b class="xcpn-l1">電話で</b><b class="xcpn-l2">10<i>%</i></b><b class="xcpn-l3">OFF</b></span></span>
      <ul class="xh-trust" aria-hidden="true">
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="13" r="8"/><path d="M12 13 V9 M12 13 l3 2 M9 3 h6"/></svg>
          <span><small>最短</small><b>30<em>分</em></b><small>で現場到着</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z"/><path class="xht-chk" d="M8.5 12 l2.5 2.5 L16 9"/></svg>
          <span><small>安心の</small><b>1<em>年</em></b><small>保証</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="12" r="9"/><text x="12" y="15.5" class="xht-y0">¥0</text></svg>
          <span><small>見積後</small><b>追加0<em>円</em></b><small>明朗会計</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M4 11 L12 4 L20 11 V21 H4 Z"/></svg>
          <span><small>当日対応</small><b>98<em>%</em></b><small>迅速対応</small></span>
        </li>
      </ul>
    </div>

    <div class="ng">
    <!-- 夜間導線（深夜客の離脱対策・honest: 電話7時〜21時／LINE24時間） -->
    <div class="ng-night-wrap">
      <p class="ng-night">
        <svg class="ng-night-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z"/></svg>
        <span>夜間・深夜も<b>LINEで受付</b>。今夜が難しくても、<b>翌朝いちばん</b>で伺います。</span>
      </p>
    </div>

    <!-- スズメバチを知り尽くしたプロ（4種判別・専門性の証明） -->
    <section class="ng-sec">
      <h2 class="ng-h2">スズメバチを知り尽くした<br class="spx" />専門チームが対応します</h2>
      <p class="ng-note">スズメバチは種類で<b>巣の場所も駆除の難易度もまったく違います</b>。当社は種類の特定から始めるので、作業も料金の説明も正確です。</p>
      <ul class="ag-judge">
        {suzumeSpecies.map((s) => (
          <li class={`ag-j ${s.danger >= 4 ? "ag-j--danger" : "ag-j--ok"}`}>
            <span class="ag-j-badge">危険度{"★".repeat(s.danger)}</span>
            <span class="ag-j-text"><b>{s.name}</b>（{s.size}）— {s.trait}</span>
          </li>
        ))}
      </ul>
      <p class="ng-mini">※ 種類が分からなくても大丈夫です。巣の形・場所・蜂の見た目を伺えば、お電話の段階でおおよそ特定できます。</p>
    </section>

    <CtaDual id="suzume_species_cta" lead="種類が分からなくてもOK。お電話ください" />

    <!-- 巣の進化・時期（早いほど安い） -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">スズメバチの巣は<br class="spx" />「とっくり型」から急成長します</h2>
      <p class="ng-note">初期は<b>とっくりを逆さにした形</b>、夏以降は<b>マーブル模様の球体</b>へ。巣が育つほど危険も費用も増えるため、<b>早く見つけて対応するほど費用を抑えられます</b>。</p>
      <NestGrowthChart stages={suzumeStages} cap="巣は毎日育ちます。10cm未満の“今”なら基本料金のみ、20〜30cmで目安+8,000〜9,000円と、手間も危険も費用も実際に増えていきます（金額は目安）。早く呼ぶほど、費用も危険も抑えられます。" />
      <p class="ng-note ng-note-follow">巣ができやすいのは<b>軒下・屋根裏・壁の中・土の中・庭木・エアコン室外機</b>。「天井から羽音がする」「地面から蜂が出入りしている」も営巣のサインです。</p>
    </section>

    <!-- 料金（スズメバチ／オオスズメバチのみ・上限＝約束／含む・加算の透明化） -->
    <section class="ng-sec">
      <h2 class="ng-h2">スズメバチ駆除 料金のご案内</h2>
      <p class="ng-note">名古屋の相場は<b>15,000〜30,000円</b>が中心（当社調べ）。当社は標準ケースの<b>上限をはっきり決めて青天井にしません</b>。ご予算のご相談も承ります。出張費・見積り・キャンセルは<b>0円</b>です。</p>
      <div class="ng-rate2">
        <div class="ng-rate2-row">
          <span class="ng-rate2-name">スズメバチ<small>キイロ・コガタ・モンほか</small></span>
          <span class="ng-rate2-price"><small>標準ケース上限</small><b>29,800円</b></span>
          <span class="ng-rate2-cap">青天井なし</span>
        </div>
        <div class="ng-rate2-row">
          <span class="ng-rate2-name">オオスズメバチ<small>土の中・樹洞などの難所</small></span>
          <span class="ng-rate2-price"><b>現地見積</b></span>
          <span class="ng-rate2-cap">難所は要調査</span>
        </div>
      </div>
      <div class="ng-incl">
        <div class="ng-incl-col ng-incl-in">
          <b class="ng-incl-h">この料金に含まれるもの</b>
          <ul>
            <li>出張費・見積り・キャンセル 0円</li>
            <li>蜂の駆除・巣の完全撤去</li>
            <li>戻り蜂対策・巣跡の処理・侵入口の封鎖</li>
            <li>1年再発保証（同じ場所への再営巣に無償で再訪問）</li>
          </ul>
        </div>
        <div class="ng-incl-col ng-incl-add">
          <b class="ng-incl-h">現場によって加算されるもの</b>
          <ul>
            <li>巣の大きさ（10cm未満は基本のみ／育つほど加算）</li>
            <li>高さ・作業のしにくさ（脚立を要する高所・2階の軒下 など）</li>
            <li>殺菌・消毒の程度</li>
            <li>再発防止剤（追加の薬剤）</li>
          </ul>
        </div>
      </div>
      <p class="ng-mini"><b>お電話で概算 → 現地で総額を確定 → ご納得のうえで作業。確定後の追加請求はありません。</b><br />※ 一般的な軒下・屋根裏の巣や戻り蜂の対応は、<b>上限29,800円の範囲内</b>です。上限の対象外になるのは〈点検口から届かない屋根裏の奥・壁内の解体・高所作業車が必要・別建物や別箇所の複数施工〉などの特殊なケースのみで、その場合はお電話の概算時に先にお伝えします。<br />※ 保証の「同じ場所」＝施工箇所とおおむね同一部位への再営巣を指します。<br />※ 電話でお申込みの方は、現地で確定したお見積り金額から10%OFF（上限額からの割引ではありません）。</p>
    </section>
    <style>
      .ng-rate2{border:1px solid #eadfce;border-radius:14px;overflow:hidden;background:#fff;margin:12px 0 0;box-shadow:0 2px 10px rgba(60,40,10,.06)}
      .ng-rate2-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid #f0e8da}
      .ng-rate2-row:last-child{border-bottom:none}
      .ng-rate2-name{font-weight:900;font-size:14.5px;color:#2a2118;display:flex;flex-direction:column}
      .ng-rate2-name small{font-size:10.5px;font-weight:700;color:#8a7c66;margin-top:2px}
      .ng-rate2-price{text-align:right;white-space:nowrap;line-height:1.15}
      .ng-rate2-price small{display:block;font-size:9.5px;color:#8a7c66;font-weight:700}
      .ng-rate2-price b{font-size:20px;font-weight:900;color:#c8321f;font-variant-numeric:tabular-nums}
      .ng-rate2-cap{font-size:11px;font-weight:800;color:#2f8f52;background:#eaf6ee;border-radius:999px;padding:4px 10px;white-space:nowrap}
      .ng-incl{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0 0}
      .ng-incl-col{border:1px solid #eadfce;border-radius:12px;padding:12px 14px;background:#fff}
      .ng-incl-in{border-left:4px solid #2f8f52} .ng-incl-add{border-left:4px solid #d98a1a}
      .ng-incl-h{display:block;font-size:12.5px;font-weight:900;margin-bottom:7px}
      .ng-incl-in .ng-incl-h{color:#2f8f52} .ng-incl-add .ng-incl-h{color:#c07a12}
      .ng-incl-col ul{margin:0;padding:0;list-style:none}
      .ng-incl-col li{font-size:12px;color:#4a3f2e;line-height:1.55;margin:4px 0;padding-left:16px;position:relative}
      .ng-incl-in li::before{content:"✓";position:absolute;left:0;color:#2f8f52;font-weight:900}
      .ng-incl-add li::before{content:"＋";position:absolute;left:0;color:#c07a12;font-weight:900}
      @media(max-width:520px){.ng-incl{grid-template-columns:1fr}}
      @media(max-width:400px){.ng-rate2-row{grid-template-columns:1fr auto;row-gap:4px}.ng-rate2-cap{grid-column:2;justify-self:end}}
    </style>

    <CtaDual id="suzume_rate_cta" lead="早く呼ぶほど、安く・安全に終わります。写真だけの概算もOK" />

    <!-- プロの施工手順（専門性の核） -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">プロの駆除手順（6ステップ）</h2>
      <p class="ng-note">スズメバチ駆除は「巣を落とす」だけでは終わりません。<b>戻り蜂と再発への対処までがプロの仕事</b>です。</p>
      <ol class="sz-steps">
        {suzumeSteps.map((s, i) => (
          <li class="sz-step">
            <span class="sz-step-no">{i + 1}</span>
            <span class="sz-step-tx"><b>{s.step}</b><small>{s.detail}</small></span>
          </li>
        ))}
      </ol>
    </section>

    <CtaDual id="suzume_step_cta" lead="危険な巣ほどプロにお任せください・通話無料" />

    <!-- スズメバチの施工事例 -->
    <section class="ng-sec">
      <h2 class="ng-h2">スズメバチの施工事例</h2>
      <div class="ng-cases">
        {suzumeCases.map((c) => (
