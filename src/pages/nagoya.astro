---
/**
 * 名古屋専用 集客LP (/nagoya)
 * AG6-Geo名古屋 の名古屋-地域KWの着地。クエリ⇄LP関連性を最大化しLP体験QSを上げる。
 * - index.astro は一切改変しない（QS履歴維持のため独立ページ）
 * - Layout / CtaDual を流用、CSSは global.css トークンで独自軽量実装
 * - honest厳守：捏造数値なし（実績数/満足度/年数/保険/静岡は出さない）
 * - noindex：広告専用着地のためdoorway/重複回避（Ad QSはnoindexでも評価される）
 */
import Layout from "../layouts/Layout.astro";
import CtaDual from "../components/CtaDual.astro";
import StaffCard from "../components/StaffCard.astro";
import LocationCard from "../components/LocationCard.astro";
import { company } from "../data/company";
import { rates } from "../data/rates";
import { nagoyaCases, nagoyaVoices, nagoyaWards, nagoyaNearby } from "../data/nagoya";
import { assetPath, homePath } from "../lib/site";

const title = "名古屋の蜂の巣駆除なら最短30分｜中区拠点・上限つき明朗会計・追加0円｜蜂の巣駆除ファクトリー東海";
const description =
  "名古屋市16区の蜂の巣駆除。名古屋・中区丸の内拠点から専門スタッフが最短30分で対応。相場はアシナガ8,000〜20,000円・スズメ15,000〜30,000円が中心、標準ケース上限つき（アシナガ19,800/スズメ29,800円）・追加請求0円・1年保証。受付は電話7時〜21時・LINE24時間。アシナガバチ・スズメバチをメインに、その他の蜂も対応。";
const a = company.address;
const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi",
  "スズメバチ": "suzumebachi",
  "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi",
  "クマバチ・その他": "kumabachi",
};
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(homePath, siteUrl).toString();

const nagoyaJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "名古屋の蜂の巣駆除" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "蜂の巣駆除",
    provider: {
      "@type": "LocalBusiness",
      name: company.name,
      telephone: company.phone,
      address: {
        "@type": "PostalAddress",
        postalCode: a.postal,
        addressRegion: a.region,
        addressLocality: a.city,
        streetAddress: a.street,
      },
    },
    areaServed: nagoyaWards.map((w) => ({ "@type": "City", name: `名古屋市${w}` })),
    offers: { "@type": "Offer", price: 19800, priceCurrency: "JPY" },
  },
];

/** よくあるご質問（決断直前の不安を解消＝CRO）。会社情報の実値に準拠 */
const nagoyaFaq = [
  {
    q: "見積もりのあとに追加料金はかかりませんか？",
    a: "かかりません。現地でお伝えする確定見積もり以外の追加請求は一切ありません。出張費・見積もり・キャンセルもすべて0円です。金額にご納得いただいてから作業を始めます。",
  },
  {
    q: "電話してから、どのくらいで来てもらえますか？",
    a: "中区丸の内の拠点から名古屋市内へ最短30分でうかがいます。混み合う時期は、お電話で到着のおおよその目安をその場でお伝えします。",
  },
  {
    q: "夜間や早朝でも相談できますか？",
    a: "お電話は7時〜21時、LINEは24時間受け付けています。夜間はLINEに蜂の巣の写真を送っていただければ、翌朝いちばんにお返事します。急ぎの場合は受付時間内にお電話ください。",
  },
  {
    q: "蜂の種類がわからなくても大丈夫ですか？",
    a: "大丈夫です。LINEで写真を送っていただくか、お電話で状況を教えていただければ種類と危険度を判断します。ご自身では絶対に巣へ近づかないでください。",
  },
  {
    q: "賃貸に住んでいますが、自分で頼んでいいですか？",
    a: "まずは管理会社・大家さんにご連絡ください。共用部（廊下・外壁など）は管理側の負担になることが多く、費用トラブルを避けられます。専有部やベランダは入居者負担が原則です。判断に迷う場合もお気軽にご相談ください。",
  },
  {
    q: "支払い方法は何が使えますか？",
    a: "現金・銀行振込・クレジットカード・PayPay・後払いに対応しています。ご都合に合わせてお選びいただけます。",
  },
];
---

<Layout title={title} description={description} noindex={true} extraJsonLd={nagoyaJsonLd}>
  <!-- sr-only 実h1（名古屋・SEO/QS） -->
    <h1 class="x-sr">名古屋の蜂の巣駆除｜中区拠点から最短30分で現場到着・標準ケース上限つき（アシナガ19,800円・スズメ29,800円）・1年保証・追加0円の明朗会計・受付は電話7時〜21時／LINE24時間 {company.phoneDisplay}</h1>

    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
      <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    </svg>

    <!-- ===== HERO（元LPの焼込みチラシを流用・名古屋化／2:3固定・%絶対配置） ===== -->
    <div class="xhero">
      <img class="xh-photo" src={assetPath("images/generated/hero-mob-photo.webp")} width="1024" height="418"
        alt="防護手袋のプロが専用工具で軒下のスズメバチの巣を取り除く様子" loading="eager" decoding="async" fetchpriority="high" />
      <div class="xh-bar" aria-hidden="true">名古屋市16区対応・<b>最短30分</b>で出動</div>
      <div class="xh-brand">
        <img class="xh-logo" src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" aria-hidden="true" />
        <span class="xh-btext"><b class="xh-bname">{company.name}</b><small class="xh-btag">名古屋の蜂の巣駆除・中区拠点</small></span>
        <a class="xh-headtel" href={company.phoneTelLink} data-cta="nagoya_header_tel">
          <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
          <span class="xh-headtel-tx"><b class="font-num">{company.phoneDisplay}</b><small>受付7時〜21時</small></span>
        </a>
      </div>
      <div class="xh-banner" aria-hidden="true"><span><em>そのまま放置</em><i>すると</i><b>危険！</b></span></div>
      <p class="xh-h1" aria-hidden="true">名古屋の蜂駆除</p>
      <p class="xh-h2" aria-hidden="true">地元密着・最短30分・確実駆除</p>
      <p class="xh-price" aria-hidden="true">
        <span class="xhp-cell"><small>最短</small><b class="xhp-num">30</b><small>分</small></span>
        <span class="xhp-div"></span>
        <span class="xhp-cell"><small>今すぐ</small><b class="xhp-num">お任せ</b></span>
      </p>
      <a class="xh-cta" href={company.phoneTelLink} data-cta="nagoya_hero_tel">
        <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="xh-cta-tx">
          <small class="xh-cta-top">＼その場でお断りOK・相談だけでも／</small>
          <b class="xh-cta-num font-num">{company.phoneDisplay}</b>
          <small class="xh-cta-bot">通話無料・受付7時〜21時・タップで発信</small>
        </span>
      </a>
      <span class="xh-now" aria-hidden="true"><i class="xh-now-dot"></i><span class="xh-now-tx">ただ今受付中</span></span>
      <span class="xcpn" aria-hidden="true"><span class="xcpn-body"><b class="xcpn-l1">電話で</b><b class="xcpn-l2">10<i>%</i></b><b class="xcpn-l3">OFF</b></span></span>
      <ul class="xh-trust" aria-hidden="true">
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="13" r="8"/><path d="M12 13 V9 M12 13 l3 2 M9 3 h6"/></svg>
          <span><small>最短</small><b>30<em>分</em></b><small>で現場到着</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z"/><path class="xht-chk" d="M8.5 12 l2.5 2.5 L16 9"/></svg>
          <span><small>安心の</small><b>1<em>年</em></b><small>保証</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="12" r="9"/><text x="12" y="15.5" class="xht-y0">¥0</text></svg>
          <span><small>見積後</small><b>追加0<em>円</em></b><small>明朗会計</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M4 11 L12 4 L20 11 V21 H4 Z"/></svg>
          <span><small>当日対応</small><b>98<em>%</em></b><small>迅速対応</small></span>
        </li>
      </ul>
    </div>

    <div class="ng">
    <!-- 対応エリア（名古屋固有） -->
    <section class="ng-sec">
      <h2 class="ng-h2">名古屋市16区・全域に対応</h2>
      <p class="ng-note">中区丸の内の拠点から、名古屋市内へ<b>最短30分</b>で出動します。</p>
      <ul class="ng-wards">
        {nagoyaWards.map((w) => <li>{w}</li>)}
      </ul>
      <p class="ng-nearby">近郊も対応：{nagoyaNearby.join("・")} ほか（名古屋近郊エリア）</p>
    </section>

    <CtaDual id="nagoya_area_cta" lead="名古屋市16区どこでも急行。今すぐご相談ください・通話無料" />

    <!-- 中区拠点（差別化の核・名古屋固有） -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">名古屋・中区の実在拠点が、直接うかがいます</h2>
      <div class="ng-base">
        <p class="ng-base-lead">
          名古屋・中区丸の内の拠点から、<b>地域の専門スタッフ</b>が現地対応。
          上限つきの<b>明朗会計</b>で、連絡も対応もスピーディです。
        </p>
        <dl class="ng-base-info">
          <div><dt>拠点</dt><dd>〒{a.postal} {a.region}{a.city}{a.street}</dd></div>
          <div><dt>受付</dt><dd>{company.hours}</dd></div>
          <div><dt>お支払い</dt><dd>{company.payment.join("・")}</dd></div>
        </dl>
        <StaffCard />
        <LocationCard />
      </div>
    </section>

    <!-- 料金（共通データ） -->
    <section class="ng-sec">
      <h2 class="ng-h2">蜂の巣駆除 料金のご案内</h2>
      <p class="ng-note">ご相談で最も多いのは<b>アシナガバチ</b>、次いで<b>スズメバチ</b>。名古屋の相場はアシナガ<b>8,000〜20,000円</b>・スズメ<b>15,000〜30,000円</b>が中心です（各社の公開料金・当社調べ）。当社は<b>標準ケースの上限をはっきり決めて青天井にせず、多くのケースは上限より安く収まります</b>。ご予算のご相談も承ります。出張費・見積り・キャンセルは<b>0円</b>、確定後の追加請求もありません。</p>
      <div class="ng-rate2">
        <a class="ng-rate2-row" href={assetPath("ashinagabachi/")} data-cta="nagoya_rate_ashinaga_link">
          <span class="ng-rate2-name">アシナガバチ<small>ご相談が最も多い蜂／軒下・ベランダ</small></span>
          <span class="ng-rate2-price"><small>標準ケースは</small><b>19,800円<i>まで</i></b></span>
          <span class="ng-rate2-cap">青天井なし</span>
        </a>
        <a class="ng-rate2-row" href={assetPath("suzumebachi/")} data-cta="nagoya_rate_suzume_link">
          <span class="ng-rate2-name">スズメバチ<small>危険・早めの対応を／屋根裏・軒下</small></span>
          <span class="ng-rate2-price"><small>標準ケースは</small><b>29,800円<i>まで</i></b></span>
          <span class="ng-rate2-cap">青天井なし</span>
        </a>
        <div class="ng-rate2-row ng-rate2-other">
          <span class="ng-rate2-name">その他の蜂<small>ミツバチ・オオスズメバチ・クマバチ 等</small></span>
          <span class="ng-rate2-price"><b>現地見積</b></span>
          <span class="ng-rate2-cap">対応可</span>
        </div>
      </div>

      <p class="ng-within"><b>軒下・ベランダ・室外機・一般的な（手の届く）屋根裏の巣は、大きくなっても上限の範囲内です。</b>上限を超えるのは〈点検口から届かない屋根裏の奥・壁内の解体・高所作業車が必要・別建物や複数箇所の施工〉など特殊なケースだけで、必ずお電話の概算時に先にお伝えします。</p>

      <div class="ng-incl">
        <div class="ng-incl-col ng-incl-in">
          <b class="ng-incl-h">この料金に含まれるもの</b>
          <ul>
            <li>出張費・見積り・キャンセル 0円</li>
            <li>蜂の駆除・巣の完全撤去</li>
            <li>戻り蜂対策・巣跡の処理・侵入口の封鎖</li>
            <li>1年再発保証（同じ場所への再営巣に無償で再訪問）</li>
          </ul>
        </div>
        <div class="ng-incl-col ng-incl-add">
          <b class="ng-incl-h">現場によって加算されるもの</b>
          <ul>
            <li>巣の大きさ（10cm未満は基本のみ／育つほど加算）</li>
            <li>高さ・作業のしにくさ（脚立を要する高所・2階の軒下・室外機まわり など）</li>
            <li>殺菌・消毒の程度</li>
            <li>再発防止剤（追加の薬剤）</li>
          </ul>
        </div>
      </div>
      <p class="ng-mini"><b>お電話で概算 → 現地で総額を確定 → ご納得のうえで作業。確定後の追加請求はありません。</b><br />一般的な軒下・ベランダ・屋根裏の巣や戻り蜂の対応は上限の範囲内です。上限の対象外になるのは〈点検口から届かない屋根裏の奥・壁内の解体・高所作業車が必要・別建物や別箇所の複数施工〉などの特殊なケースのみで、概算時に先にお伝えします。オオスズメバチの土中・樹洞・難所は上限外・現地見積です。<br />早く呼ぶほど費用を抑えられます（巣が小さいうちの早めのご相談が、安く・安全に終わります）。<br />※ 電話でお申込みの方は、現地で確定したお見積り金額から10%OFF（上限額からの割引ではありません）。</p>
    </section>
    <style>
      .ng-rate2{border:1px solid #eadfce;border-radius:14px;overflow:hidden;background:#fff;margin:12px 0 0;box-shadow:0 2px 10px rgba(60,40,10,.06)}
      .ng-rate2-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid #f0e8da;text-decoration:none;color:inherit}
      .ng-rate2-row:last-child{border-bottom:none}
      .ng-rate2-row:active{background:#fff6f5}
      .ng-rate2-name{font-weight:900;font-size:14.5px;color:#2a2118;display:flex;flex-direction:column}
      .ng-rate2-name small{font-size:10.5px;font-weight:700;color:#8a7c66;margin-top:2px}
      .ng-rate2-price{text-align:right;white-space:nowrap;line-height:1.15}
      .ng-rate2-price small{display:block;font-size:9.5px;color:#8a7c66;font-weight:700}
      .ng-rate2-price b{font-size:20px;font-weight:900;color:#c8321f;font-variant-numeric:tabular-nums}
      .ng-rate2-cap{font-size:11px;font-weight:800;color:#2f8f52;background:#eaf6ee;border-radius:999px;padding:4px 10px;white-space:nowrap}
      .ng-rate2-other .ng-rate2-cap{color:#8a6d3b;background:#f6f1e7}
      .ng-rate2-price b i{font-size:12px;font-weight:800;font-style:normal;color:#8a6d3b;margin-left:1px}
      .ng-within{margin:10px 0 0;padding:11px 14px;background:#eaf6ee;border:1px solid #cfe9d8;border-radius:11px;font-size:12.5px;line-height:1.72;color:#2a2118}
      .ng-within b{color:#2f7d4f}
      .ng-incl{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0 0}
      .ng-incl-col{border:1px solid #eadfce;border-radius:12px;padding:12px 14px;background:#fff}
      .ng-incl-in{border-left:4px solid #2f8f52}.ng-incl-add{border-left:4px solid #d98a1a}
      .ng-incl-h{display:block;font-size:12.5px;font-weight:900;margin-bottom:7px}
      .ng-incl-in .ng-incl-h{color:#2f8f52}.ng-incl-add .ng-incl-h{color:#c07a12}
      .ng-incl-col ul{margin:0;padding:0;list-style:none}
      .ng-incl-col li{font-size:12px;color:#4a3f2e;line-height:1.55;margin:4px 0;padding-left:16px;position:relative}
      .ng-incl-in li::before{content:"✓";position:absolute;left:0;color:#2f8f52;font-weight:900}
      .ng-incl-add li::before{content:"＋";position:absolute;left:0;color:#c07a12;font-weight:900}
      @media(max-width:520px){.ng-incl{grid-template-columns:1fr}}
      @media(max-width:400px){.ng-rate2-row{grid-template-columns:1fr auto;row-gap:4px}.ng-rate2-cap{grid-column:2;justify-self:end}}
    </style>

    <CtaDual id="nagoya_rate_cta" lead="名古屋市内なら最短30分。今すぐお電話ください" />

    <!-- 名古屋の施工事例（生成画像・イメージ表記） -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">名古屋市内の施工事例</h2>
      <div class="ng-cases">
        {nagoyaCases.map((c) => (
          <a class="ng-case" href={company.phoneTelLink} data-cta="nagoya_case_dial" aria-label={`${c.area}の${c.beeType}駆除を電話で相談`}>
            <img src={assetPath(`images/cases/${c.imageBase}.webp`)} width="320" height="210"
              alt={`${c.area} ${c.title}`} loading="lazy" decoding="async" />
            <div class="ng-case-b">
              <div class="ng-tags"><span>{c.beeType}</span><span>{c.area}</span><span>{c.location}</span></div>
              <h3>{c.title}</h3>
              <p class="ng-case-price">現地確定見積 <b>{c.priceJpy.toLocaleString()}円</b>（税込）</p>
            </div>
          </a>
        ))}
      </div>
      <p class="ng-mini">※ 写真はイメージです。金額は巣のサイズ・場所により変動します。</p>
    </section>

    <CtaDual id="nagoya_proof_cta" lead="今すぐご相談ください・お電話無料。名古屋のプロが最短30分" />

    <!-- 名古屋のお客様の声 -->
    <section class="ng-sec">
      <h2 class="ng-h2">名古屋のお客様の声</h2>
      <div class="ng-voices">
        {nagoyaVoices.map((v) => (
          <a class="ng-voice" href="#nagoya_cta" data-cta="nagoya_voice_scroll" aria-label="お客様の声を読んで無料相談する">
            <div class="ng-voice-h">
              <span class="ng-av">{v.initial}</span>
              <span class="ng-voice-m">{v.area}・{v.ageBracket}<small>{v.service}</small></span>
              <span class="ng-stars" aria-label="5点">{"★".repeat(v.rating)}</span>
            </div>
            <p>{v.comment}</p>
          </a>
        ))}
      </div>
      <p class="ng-mini">※ お客様の声は当社の施工事例をもとにした体験イメージです。同意取得済みの実際のご感想は順次掲載します。</p>
    </section>

    <!-- 選ばれる理由（簡潔） -->
    <section class="ng-sec ng-sec-tint">
