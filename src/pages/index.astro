---
import Layout from "../layouts/Layout.astro";
import { assetPath, isHornetPeakSeason } from "../lib/site";
import { company } from "../data/company";
import { strengths } from "../data/strengths";
import { troubles } from "../data/troubles";
import { beeTypes } from "../data/bee-types";
import { rates } from "../data/rates";
import { promises } from "../data/promises";
import { compareRows } from "../data/compare";
import { cases } from "../data/cases";
import { voices } from "../data/voices";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";
import { faqs } from "../data/faq";
import { diyOkConditions, diyNgConditions } from "../data/diy-guide";
import { vsGovernmentRows, subsidyNote } from "../data/vs-government";
import { scamSigns, scamWarningSource } from "../data/scam-warning";

const title = `東海の蜂の巣駆除なら最短30分｜基本3,300円〜｜${company.name}`;
const description = `蜂の巣駆除を愛知・岐阜・三重・静岡で最短30分。事前見積金額からの追加請求なしのハチ駆除専門【${company.name}】。スズメバチ・アシナガバチに基本3,300円〜で対応。24時間365日受付・見積り無料・キャンセル料0円・1年再発保証。`;

const fmtJpy = (n: number) =>
  new Intl.NumberFormat("ja-JP").format(n);

const heroImage480 = assetPath("images/hero/hero-main-480.webp");
const heroImage800 = assetPath("images/hero/hero-main-800.webp");
const heroImage1400 = assetPath("images/hero/hero-main-1400.webp");
const heroPattern = assetPath("images/hero/pattern.svg");

const showSeasonalAlert = isHornetPeakSeason();
---

<Layout title={title} description={description}>
  <!-- ===== SVG Icon Sprite ===== -->
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="i-bee" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="13" rx="6" ry="7"/>
      <path d="M12 6 L12 20 M9 6 L9 20 M15 6 L15 20"/>
      <ellipse cx="6" cy="9" rx="3" ry="1.5" transform="rotate(-30 6 9)"/>
      <ellipse cx="18" cy="9" rx="3" ry="1.5" transform="rotate(30 18 9)"/>
    </symbol>
    <symbol id="i-lightning" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 L4 14 H10 L9 22 L20 10 H14 Z"/></symbol>
    <symbol id="i-yen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4 L12 13 L18 4"/><path d="M12 13 L12 21"/><path d="M7 14 L17 14"/><path d="M7 18 L17 18"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L4 6 L4 12 C4 17 7.5 20.5 12 22 C16.5 20.5 20 17 20 12 L20 6 Z"/><path d="M9 12 L11 14 L15 10"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    <symbol id="i-line" viewBox="0 0 24 24" fill="currentColor"><path d="M19 5H5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h2v3.6c0 .3.4.5.7.3l4.3-3.9H19a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 L10 17 L19 7"/></symbol>
    <symbol id="i-check-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12 L11 15 L16 9"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 L18 18 M18 6 L6 18"/></symbol>
    <symbol id="i-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L22 20 L2 20 Z"/><path d="M12 10 L12 15"/><circle cx="12" cy="17.5" r="0.6" fill="currentColor"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22 C16 16 19 13 19 9 A7 7 0 0 0 5 9 C5 13 8 16 12 22 Z"/><circle cx="12" cy="9" r="2.5"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 L14.6 8.6 L21.6 9.3 L16.3 14 L17.9 21 L12 17.3 L6.1 21 L7.7 14 L2.4 9.3 L9.4 8.6 Z"/></symbol>
    <symbol id="i-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9 7 H6 a3 3 0 0 0-3 3 v3 a3 3 0 0 0 3 3 H7 v0 c0 2.2-1.8 4-4 4 v2 c4.4 0 8-3.6 8-8 V8 a1 1 0 0 0-1-1 z"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21 C4 16.6 7.6 13 12 13 C16.4 13 20 16.6 20 21"/></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9"/></symbol>
    <symbol id="i-headset" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14 V12 a8 8 0 0 1 16 0 V14"/><rect x="3" y="14" width="4" height="6" rx="1.2"/><rect x="17" y="14" width="4" height="6" rx="1.2"/></symbol>
    <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 H19 M13 6 L19 12 L13 18"/></symbol>
  </svg>

  <!-- ===== Sticky Topbar（営業情報） ===== -->
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-item">
        <svg class="icon"><use href="#i-headset" /></svg>
        <span><strong>24時間365日</strong> 受付中</span>
      </span>
      <span class="topbar-item">
        <svg class="icon"><use href="#i-check-circle" /></svg>
        <span>通話・出張・見積り <strong>すべて無料</strong></span>
      </span>
      <span class="topbar-item">
        <svg class="icon"><use href="#i-lightning" /></svg>
        <span>最短<strong>30分</strong>で出動</span>
      </span>
    </div>
  </div>

  <!-- ===== Sticky Header ===== -->
  <header class="header">
    <div class="container header-inner">
      <a href="#" class="brand" aria-label="トップへ">
        <span class="brand-mark"><svg class="icon"><use href="#i-bee" /></svg></span>
        <span>{company.name}</span>
      </a>
      <a href={company.phoneTelLink} class="header-tel" data-cta="header_tel">
        <svg class="icon"><use href="#i-phone" /></svg>
        <span>
          <small>365日24時間受付</small>
          {company.phoneDisplay}
        </span>
      </a>
    </div>
  </header>

  {showSeasonalAlert && (
    <div class="seasonal-alert" role="status" aria-live="polite">
      <div class="container seasonal-alert-inner">
        <svg class="icon" aria-hidden="true"><use href="#i-warning" /></svg>
        <span><strong>9月15日〜10月15日はスズメバチ攻撃性ピーク</strong>。新女王誕生で防衛本能が極大化する最危険期です。</span>
      </div>
    </div>
  )}

  <!-- ===== ① Hero ===== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <picture>
        <source media="(max-width: 480px)" srcset={heroImage480} />
        <source media="(max-width: 880px)" srcset={heroImage800} />
        <img
          src={heroImage1400}
          alt=""
          width="1400"
          height="1400"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <!-- Veo3 cinematic 動画 (defer load: preload=none で初期 fetch せず、autoplay 開始時のみ) -->
      <video
        class="hero-bg-video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={heroImage800}
        role="presentation"
        data-src={assetPath("videos/hero-mobile.mp4")}
      >
        <source src={assetPath("videos/hero-mobile.mp4")} type="video/mp4" />
      </video>
    </div>
    <div class="container hero-inner">
      <div class="hero-content reveal">
        <span class="hero-eyebrow">
          <svg class="icon"><use href="#i-pin" /></svg>
          愛知・岐阜・三重・静岡の蜂の巣駆除｜スズメバチ専門
        </span>
        <div class="hero-mascot-wrap">
          <div class="hero-mascot" aria-hidden="true">
            <img src={assetPath("logo.svg")} alt="" width="72" height="72" />
            <div class="speech-bubble">呼んだ？最短<strong>30分</strong>で出動！</div>
          </div>
        </div>
        <h1 id="hero-title" class="headline hero-h1">
          <span class="hero-h1-line"><span class="hl-kw">蜂の巣駆除</span>、</span>
          <span class="hero-h1-line"><span class="hl-num">今日中</span>に完了。</span>
        </h1>
        <p class="hero-sub">
          攻撃性の高い<strong>スズメバチ</strong>も、防護装備の専門隊が<strong>24時間救急対応</strong>。最短<strong>30分</strong>で出動・基本<strong>3,300円〜</strong>・<strong>事前見積金額厳守</strong>・1年再発保証。
        </p>

        <div class="hero-stats reveal-stagger">
          <div class="hero-stat">
            <div class="hero-stat-num font-num"><span data-count="30">0</span><small>分</small></div>
            <div class="hero-stat-label">最短現地到着</div>
          </div>
          <div class="hero-stat is-featured">
            <div class="hero-stat-num font-num">¥<span data-count="3300" data-format="comma">0</span><small>〜</small></div>
            <div class="hero-stat-label">基本料金</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num font-num"><span data-count="1">0</span><small>年</small></div>
            <div class="hero-stat-label">再発保証付き</div>
          </div>
        </div>

        <div class="hero-cta">
          <a href={company.phoneTelLink} class="hero-tel-card" data-cta="hero_tel">
            <span class="hero-tel-card-icon" aria-hidden="true">
              <svg class="icon"><use href="#i-phone" /></svg>
            </span>
            <span class="hero-tel-card-body">
              <span class="hero-tel-card-label">通話無料・24時間365日受付</span>
              <span class="hero-tel-card-num font-num">{company.phoneDisplay}</span>
              <span class="hero-tel-card-note">※ タップで発信</span>
            </span>
            <svg class="hero-tel-card-arrow icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
          </a>
          <div class="hero-cta-row">
            <a href={company.lineUrl} class="btn btn-line cta-glow-line hero-line-cta" data-cta="hero_line">
              <svg class="icon"><use href="#i-line" /></svg>
              LINEで写真を送って相談
            </a>
          </div>
        </div>
      </div>

      <!-- ===== Hero 右側 (PC専用): 保証メダル + 3つの¥0チップ ===== -->
      <aside class="hero-right reveal-stagger" aria-label="保証とキャンペーン">
        <!-- 保証メダル (medal風) -->
        <div class="hero-medal">
          <span class="hero-medal-ribbon">GUARANTEE</span>
          <div class="hero-medal-body">
            <div class="hero-medal-circle" aria-hidden="true">
              <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="medalGold" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#f4d68a"/>
                    <stop offset="50%" stop-color="#c9a14a"/>
                    <stop offset="100%" stop-color="#8b6b1f"/>
                  </linearGradient>
                  <linearGradient id="medalGoldInner" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#fff5d4"/>
                    <stop offset="100%" stop-color="#e8c463"/>
                  </linearGradient>
                </defs>
                <circle cx="40" cy="40" r="38" fill="url(#medalGold)"/>
                <circle cx="40" cy="40" r="32" fill="url(#medalGoldInner)"/>
                <circle cx="40" cy="40" r="32" fill="none" stroke="#a07b2a" stroke-width="1" opacity="0.5"/>
                <text x="40" y="38" text-anchor="middle" font-family="Georgia, serif" font-weight="900" font-size="22" fill="#7a5318">1</text>
                <text x="40" y="52" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="10" fill="#7a5318" letter-spacing="0.1em">YEAR</text>
              </svg>
            </div>
            <div class="hero-medal-text">
              <p class="hero-medal-eyebrow">蜂の巣駆除ファクトリー東海のお約束</p>
              <p class="hero-medal-title" role="heading" aria-level="2">再発防止<span class="hl-num">1年</span>保証</p>
              <p class="hero-medal-note">作業済み箇所で同種のハチが1年以内に再営巣した場合、<strong>無料で再駆除</strong>いたします。</p>
            </div>
          </div>
        </div>

        <!-- 3つの「¥0」チップ -->
        <div class="hero-zero-card">
          <div class="hero-zero-head">
            <span class="hero-zero-eyebrow">東海4県のお住まいの方</span>
            <p class="hero-zero-title" role="heading" aria-level="2">ハチ駆除の<span class="hl">3つの「¥0」</span></p>
          </div>
          <div class="hero-zero-grid">
            <div class="hero-zero-chip">
              <span class="hero-zero-amount">¥0</span>
              <span class="hero-zero-label">出張費</span>
            </div>
            <div class="hero-zero-chip">
              <span class="hero-zero-amount">¥0</span>
              <span class="hero-zero-label">見積り</span>
            </div>
            <div class="hero-zero-chip">
              <span class="hero-zero-amount">¥0</span>
              <span class="hero-zero-label">キャンセル</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== ③ Troubles（お悩み訴求） ===== -->
  <section class="section troubles" id="troubles" aria-labelledby="troubles-title">
    <div class="container">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">CHECK!</span>
      </div>
      <h2 id="troubles-title" class="section-title headline">
        こんな<span class="hl">お悩み</span>、ありませんか？
      </h2>
      <ul class="troubles-grid reveal-stagger">
        {troubles.map((t) => (
          <li class="bubble" set:html={t} />
        ))}
      </ul>
      <div class="troubles-arrow reveal" aria-hidden="true"></div>
      <div class="troubles-resolve reveal">
        <span class="troubles-resolve-lead">その悩み、</span>
        <strong class="troubles-resolve-brand">{company.name}</strong>
        <span class="troubles-resolve-tail">が最短<span class="big">30分</span>で解決します。</span>
      </div>
    </div>
  </section>

  <!-- ===== ④ Strengths（強み3点） ===== -->
  <section class="section" id="strengths" aria-labelledby="strengths-title">
    <div class="container">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">REASONS</span>
      </div>
      <h2 id="strengths-title" class="section-title headline">
        選ばれる<span class="accent">3つの理由</span>
      </h2>
      <p class="section-lead">
        東海4県のハチ駆除専門。<strong>即日駆けつけ・事前見積金額厳守・1年再発保証</strong>の3軸で選ばれています。中間マージンなしの自社直接対応で業界相場より20〜30%お得<small style="font-size:.75em;opacity:.7;">（※自社調べ）</small>。
      </p>
      <div class="strengths reveal-stagger">
        {strengths.map((s) => (
          <article class={`strength-card ${s.featured ? "is-featured" : ""}`}>
            <span class="strength-num font-num">{s.num}</span>
            <div class="strength-icon">
              <svg class="icon"><use href={`#i-${s.iconId}`} /></svg>
            </div>
            <h3 class="strength-title headline" set:html={s.title.replaceAll("<hl>", '<span class="hl">').replaceAll("</hl>", "</span>")} />
            <p class="strength-desc">{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ⑤ BeeTypes（対応する蜂6種） ===== -->
  <section class="section section-soft" id="bee-types" aria-labelledby="bee-title">
    <div class="container">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">BEE TYPES</span>
      </div>
      <h2 id="bee-title" class="section-title headline">
        対応する<span class="accent">蜂の種類</span>
      </h2>
      <p class="section-lead">
        東海で営巣する全種のハチに対応。スズメバチ・オオスズメバチ・アシナガ・ミツバチまで、種類不明の初期巣でも<strong>ハチ駆除のプロ</strong>にご相談ください。
      </p>
      <div class="bee-grid reveal-stagger">
        {beeTypes.map((b) => (
          <article class="bee-card">
            <div class="bee-card-img">
              <img
                src={assetPath(`images/bee-types/${b.imageBase}.webp`)}
                alt={`${b.name}の写真`}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="bee-card-body">
              <span class={`bee-card-tag tag-${b.dangerLevel}`}>
                <svg class="icon"><use href={b.dangerLevel === "low" ? "#i-check" : "#i-warning"} /></svg>
                {b.dangerLabel}
              </span>
              <h3 class="bee-card-title headline">{b.name}</h3>
              <p class="bee-card-desc">{b.description}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- 蜂種比較表（AEO強化） -->
      <div class="bee-compare reveal">
        <div class="bee-compare-scroll">
          <table>
            <thead>
              <tr>
                <th>種類</th>
                <th>危険度</th>
                <th>活動時期</th>
                <th class="hide-mobile">巣の場所</th>
                <th class="hide-mobile">巣の見た目</th>
                <th>料金目安</th>
              </tr>
            </thead>
            <tbody>
              {beeTypes.map((b) => (
                <tr>
                  <th>{b.name}</th>
                  <td><span class={`danger-bar lv${b.dangerBars}`}></span></td>
                  <td>{b.activeMonths}</td>
                  <td class="hide-mobile">{b.nestLocation}</td>
                  <td class="hide-mobile">{b.nestAppearance}</td>
                  <td>{b.priceRange}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ⑤′ DIY-Guide（自分で駆除する前に） ===== -->
  <section class="section" id="diy-guide" aria-labelledby="diy-title">
    <div class="container container-narrow">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">DIY OR PRO</span>
      </div>
      <h2 id="diy-title" class="section-title headline">
        <span class="accent">小さい蜂の巣</span>を自分で駆除する前に
      </h2>
      <p class="section-lead">
        <strong>小さい巣（直径5cm未満）なら自分で駆除できる場合もあります</strong>が、種類とサイズの判断を間違えると刺傷事故に直結します。<strong>プロに任せるべきライン</strong>を症状別に整理しました。
      </p>

      <div class="reveal-stagger" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:1.25rem;margin-top:2rem;">
        <article style="border:2px solid #2e7d32;border-radius:14px;padding:1.5rem 1.25rem;background:#fff;">
          <header style="display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;color:#2e7d32;">
            <svg class="icon" style="width:1.5rem;height:1.5rem;"><use href="#i-check-circle" /></svg>
            <h3 class="headline" style="font-size:1.15rem;margin:0;color:#2e7d32;">自分で駆除を検討できるケース</h3>
          </header>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1rem;">
            {diyOkConditions.map((c) => (
              <li style="display:flex;gap:.75rem;">
                <span aria-hidden="true" style="color:#2e7d32;flex-shrink:0;margin-top:.15rem;">
                  <svg class="icon" style="width:1.1rem;height:1.1rem;"><use href={`#i-${c.iconId}`} /></svg>
                </span>
                <div>
                  <p style="margin:0 0 .25rem;font-weight:700;">{c.label}</p>
                  <p style="margin:0;font-size:.95rem;color:#4a5568;line-height:1.7;">{c.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </article>

        <article style="border:2px solid #c81e1e;border-radius:14px;padding:1.5rem 1.25rem;background:#fff;">
          <header style="display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;color:#c81e1e;">
            <svg class="icon" style="width:1.5rem;height:1.5rem;"><use href="#i-warning" /></svg>
            <h3 class="headline" style="font-size:1.15rem;margin:0;color:#c81e1e;">必ず業者に依頼すべきケース</h3>
          </header>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1rem;">
            {diyNgConditions.map((c) => (
              <li style="display:flex;gap:.75rem;">
