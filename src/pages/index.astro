    background:linear-gradient(180deg,#b81210,#8e0c0a); color:#fff; font-size:2.95cqw; font-weight:800; letter-spacing:-.01em; white-space:nowrap; }
  .xh-bar b { color:#ffd23f; font-weight:900; margin:0 .1em; }

  /* L2 ブランド帯 */
  .xh-brand { left:0; top:3.8%; width:100%; height:9.5%; display:flex; align-items:center; gap:1.5cqw; padding:0 3cqw; }
  .xh-logo { width:9cqw; height:auto; flex-shrink:0; }
  .xh-btext { display:flex; flex-direction:column; line-height:1.05; }
  .xh-bname { font-size:3.3cqw; font-weight:900; color:#111; letter-spacing:-.035em; white-space:nowrap; }
  .xh-btag { font-size:1.7cqw; font-weight:700; color:#5a5a5a; }
