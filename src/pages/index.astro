          </div>
          <div class="plp-area__cols">
            <div><b>愛知県</b><p>{aichiOthers.join("・")} ほか全域</p></div>
            <div><b>岐阜県（南部）</b><p>{gifuCities.join("・")} など</p></div>
            <div><b>三重県（北部）</b><p>{mieCities.join("・")} など</p></div>
          </div>
        </div>
      </div>
