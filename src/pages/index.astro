    }
    .hero-tel-card-label {
      font-size: 0.75rem;
    }
    .hero-tel-card-note {
      font-size: 0.75rem;
    }
    /* LINE CTA 大型化 (電話CTAと同サイズに揃える) */
    .hero-cta-row {
