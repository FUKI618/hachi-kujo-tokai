  .plp-h h2 em{font-style:normal;color:var(--red);font-size:1.25em}
  .plp-h__sub{font-size:.62em;font-weight:800;color:#6d5f4b}
  .plp-h p{margin:10px 0 0;color:var(--muted);font-size:15px;font-weight:700}
  .plp-h--row{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;text-align:left}
  .plp-h--row h2::after{left:0;transform:none}
  .plp-mini{display:inline-flex;align-items:center;gap:7px;border:2px solid var(--red);color:var(--red);border-radius:8px;padding:11px 16px;font-weight:900;white-space:nowrap}
  .plp-secbtn{display:flex;align-items:center;justify-content:center;gap:9px;max-width:460px;margin:24px auto 0;min-height:58px;border-radius:10px;background:linear-gradient(180deg,#ef2b24,var(--red-d));color:#fff;font-size:17px;font-weight:900;box-shadow:0 6px 18px rgba(215,25,32,.3)}

  /* ---------- urgent ---------- */
  .plp-urgent{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .plp-urgent__card{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:0 4px 16px rgba(40,25,0,.08)}
  .plp-urgent__card img{width:100%;height:170px;object-fit:cover;display:block}
  .plp-urgent__card>div{position:relative;padding:16px 16px 16px 54px}
  .plp-urgent__mark{position:absolute;left:14px;top:16px;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--red);color:#fff}
  .plp-urgent__mark svg{width:16px;height:16px}
  .plp-urgent__card h3{margin:0;font-size:17px;font-weight:900;line-height:1.4}
  .plp-urgent__card p{margin:7px 0 0;font-size:13px;font-weight:700;color:var(--muted)}

  /* ---------- zero ---------- */
  .plp-zero{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .plp-zero article{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px 14px;text-align:center;box-shadow:0 4px 14px rgba(40,25,0,.06)}
  .plp-zero__ic{width:40px;height:40px;color:#3f3428;margin-bottom:8px}
  .plp-zero b{display:block;font-size:16.5px;font-weight:900}
  .plp-zero em{font-style:normal;display:block;color:var(--red);font-size:44px;line-height:1.1;font-weight:900;margin:4px 0 6px}
  .plp-zero__ok{font-size:22px !important;padding:11px 0}
  .plp-zero p{margin:0;font-size:12.5px;font-weight:700;color:var(--muted);line-height:1.65}

  /* ---------- price ---------- */
  .plp-price{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .plp-pcard{background:#fff;border-radius:12px;overflow:hidden;border:2px solid var(--line);box-shadow:0 6px 20px rgba(40,25,0,.08);display:flex;flex-direction:column}
  .plp-pcard--gold{border-color:#e5b45c}
  .plp-pcard--red{border-color:#e26a63}
  .plp-pcard header{padding:11px 16px;color:#fff;font-size:19px;font-weight:900;letter-spacing:.02em}
  .plp-pcard--gold header{background:linear-gradient(90deg,var(--gold2),var(--gold))}
  .plp-pcard--red header{background:linear-gradient(90deg,#e02d25,var(--red-d))}
  .plp-pcard__body{display:flex;align-items:center;gap:14px;padding:18px 18px 6px}
  .plp-pcard__body img{width:132px;height:92px;object-fit:cover;border-radius:8px;background:var(--paper)}
  .plp-pcard__body p{margin:0;flex:1;text-align:center}
  .plp-pcard__body small{display:block;font-size:13.5px;font-weight:900;color:#5c4c33}
  .plp-pcard__body b{font-size:clamp(38px,3.4vw,48px);line-height:1.1;color:var(--red);font-weight:900;letter-spacing:0}
  .plp-pcard__body span{font-size:13px;font-weight:900;color:#5c4c33}
  .plp-pcard ul{list-style:none;margin:10px 18px 14px;padding:12px 0 0;border-top:1px dashed var(--line);display:grid;gap:7px}
  .plp-pcard li{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:800;color:#33291c}
  .plp-pcard li svg{color:var(--red);width:1em;height:1em}
  .plp-pcard footer{margin-top:auto;text-align:center;padding:10px;color:#fff;font-size:15px;font-weight:900}
  .plp-pcard--gold footer{background:var(--gold)}
  .plp-pcard--red footer{background:var(--red)}
  .plp-price__note{margin:14px 0 0;font-size:12.5px;font-weight:700;color:var(--muted);text-align:center}
  .plp-ptable{margin-top:18px;overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:#fff}
  .plp-ptable table{width:100%;border-collapse:collapse;min-width:560px}
  .plp-ptable th,.plp-ptable td{border-bottom:1px solid var(--line);padding:11px 14px;font-size:13.5px;text-align:left;line-height:1.6}
  .plp-ptable thead th{background:#211c15;color:#fff;font-weight:900}
  .plp-ptable tbody th{font-weight:900;white-space:nowrap}
  .plp-ptable tr:last-child th,.plp-ptable tr:last-child td{border-bottom:0}

  /* ---------- local ---------- */
  .plp-local{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px;align-items:stretch}
  .plp-local__panel{background:linear-gradient(160deg,#132a4d,#0d1c33);color:#fff;border-radius:12px;padding:30px 28px;display:flex;flex-direction:column;justify-content:center}
  .plp-local__panel h2{margin:0 0 18px;font-size:clamp(22px,2.4vw,29px);font-weight:900;line-height:1.4}
  .plp-local__panel ul{list-style:none;margin:0;padding:0;display:grid;gap:11px}
  .plp-local__panel li{display:flex;align-items:center;gap:9px;font-size:15.5px;font-weight:800}
  .plp-local__panel svg{color:#ffcf5a;width:1.05em;height:1.05em}
  .plp-local__addr{margin:18px 0 0;font-size:12.5px;font-weight:700;color:#b9c6da}
  .plp-local__photos{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .plp-local__photos figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:0 4px 14px rgba(40,25,0,.07);display:flex;flex-direction:column}
  .plp-local__img{width:100%;height:150px;object-fit:cover;display:block}
  .plp-local__photos figcaption{padding:12px 13px 14px}
  .plp-local__photos b{display:block;font-size:14.5px;font-weight:900}
  .plp-local__photos span{display:block;margin-top:4px;font-size:12px;font-weight:700;color:var(--muted);line-height:1.6}

  /* ---------- cases ---------- */
  .plp-cases{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
  .plp-case{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:0 4px 14px rgba(40,25,0,.07)}
  .plp-case__imgwrap{position:relative}
  .plp-case__imgwrap span{position:absolute;left:0;top:0;background:var(--red);color:#fff;font-size:11.5px;font-weight:900;padding:5px 9px;border-radius:0 0 6px 0}
  .plp-case__imgwrap img{width:100%;height:130px;object-fit:cover;display:block}
  .plp-case__body{padding:11px 12px 13px}
  .plp-case__body h3{margin:0;font-size:13.5px;font-weight:900;line-height:1.45}
  .plp-case__body p{margin:5px 0 8px;font-size:11.5px;font-weight:800;color:var(--red)}
  .plp-case__body ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:4px}
  .plp-case__body li{font-size:10.5px;font-weight:800;color:#7a4c13;background:#fdf1da;border-radius:4px;padding:3px 6px}

  /* ---------- danger ---------- */
  .plp-danger{display:grid;grid-template-columns:.72fr 1.28fr;gap:20px;align-items:stretch}
  .plp-danger__left h2{margin:0 0 16px;font-size:clamp(21px,2.3vw,27px);font-weight:900;line-height:1.45}
  .plp-danger__left ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .plp-danger__left li{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:800}
  .plp-danger__left svg{color:var(--red);width:1.05em;height:1.05em}
  .plp-growth{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;box-shadow:0 4px 14px rgba(40,25,0,.06)}
  .plp-growth h3{margin:0 0 14px;text-align:center;font-size:17.5px;font-weight:900}
  .plp-growth h3 span{font-size:12px;font-weight:800;color:var(--muted)}
  .plp-growth__steps{display:flex;align-items:flex-end;gap:6px;justify-content:space-between}
  .plp-growth__steps figure{margin:0;flex:1;text-align:center;min-width:0;display:flex;flex-direction:column;align-items:center}
  .plp-growth__nest{display:flex;align-items:flex-end;justify-content:center;height:clamp(78px,20vw,104px);width:100%;padding:0 2px}
  .plp-growth__nest img{width:auto;max-width:100%;object-fit:contain;filter:drop-shadow(0 5px 7px rgba(0,0,0,.14))}
  .plp-growth__steps figcaption b{display:block;margin-top:10px;font-size:13px;font-weight:900}
  .plp-growth__steps figcaption span{display:block;margin-top:3px;font-size:11.5px;font-weight:700;color:var(--muted);line-height:1.5}
  .plp-growth__arrow{color:#2faf5b;font-size:18px;flex:none;align-self:flex-end;margin-bottom:34px}
  .plp-danger .plp-notouch{display:block;grid-column:auto}
  .plp-danger{grid-template-columns:.72fr 1fr .62fr}
  .plp-notouch{grid-column:auto;position:relative;overflow:hidden;display:none;isolation:isolate;padding:19px 16px 16px 20px;border-radius:16px;color:#ece0d6;background:radial-gradient(120% 82% at 86% 0%,rgba(226,161,60,.10),transparent 58%),linear-gradient(168deg,#191512 0%,#131009 52%,#0d0b08 100%);border:1px solid rgba(214,150,74,.20);box-shadow:0 22px 46px -16px rgba(0,0,0,.62),0 6px 16px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,224,178,.10),inset 0 0 0 1px rgba(0,0,0,.30)}
  .plp-notouch::before{content:"";position:absolute;top:0;bottom:0;left:0;width:4px;z-index:3;background:repeating-linear-gradient(-45deg,#e0972f 0 7px,#241a10 7px 14px);opacity:.92;box-shadow:1px 0 0 rgba(0,0,0,.45),inset -1px 0 1px rgba(0,0,0,.5)}
  .plp-notouch__head{display:flex;align-items:center;gap:9px;margin-bottom:12px}
  .plp-notouch__badge{display:inline-flex;align-items:center;gap:6px;padding:5px 11px 5px 8px;border-radius:8px;font-weight:900;font-size:12.5px;letter-spacing:.10em;line-height:1;color:#f7e6cf;background:linear-gradient(160deg,rgba(226,161,60,.22),rgba(226,161,60,.07));border:1px solid rgba(226,161,60,.42);box-shadow:inset 0 1px 0 rgba(255,224,178,.22),0 1px 2px rgba(0,0,0,.4)}
  .plp-notouch__tri{width:15px;height:15px;color:#f2b34e;flex:none;filter:drop-shadow(0 1px 1px rgba(0,0,0,.4))}
  .plp-notouch__code{font-size:9.5px;font-weight:800;letter-spacing:.24em;color:rgba(228,182,132,.55);white-space:nowrap}
  .plp-notouch h3{margin:0 0 13px;color:#fdf8f2;font-weight:900;font-size:clamp(15.5px,1.15vw,17px);line-height:1.4;letter-spacing:-.01em;text-wrap:balance}
  .plp-notouch__list{list-style:none;margin:0 0 2px;padding:4px 11px;position:relative;z-index:2;background:linear-gradient(180deg,#100d0a,#0c0a08);border:1px solid rgba(255,255,255,.055);border-radius:11px;box-shadow:inset 0 1px 2px rgba(0,0,0,.55),inset 0 0 0 1px rgba(255,255,255,.02)}
  .plp-notouch__list li{display:flex;align-items:center;gap:10px;padding:11px 2px;font-weight:800;font-size:14px;color:#eaded3;border-top:1px solid rgba(255,255,255,.055);box-shadow:inset 0 1px 0 rgba(0,0,0,.45)}
  .plp-notouch__list li:first-child{border-top:0;box-shadow:none}
  .plp-notouch__ic{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:8px;color:#ecb768;background:linear-gradient(158deg,#241c13,#17120d);border:1px solid rgba(230,166,70,.30);box-shadow:inset 0 1px 0 rgba(255,214,150,.16),0 1px 2px rgba(0,0,0,.45)}
  .plp-notouch__ic svg{width:17px;height:17px;display:block}
  .plp-notouch__label{flex:1;min-width:0;line-height:1.35;letter-spacing:.01em;overflow-wrap:anywhere}
  .plp-notouch__x{flex:none;display:grid;place-items:center;width:20px;height:20px;border-radius:6px;font-size:11px;font-weight:900;color:#f0745a;background:rgba(216,84,60,.12);border:1px solid rgba(216,84,60,.42);box-shadow:inset 0 1px 0 rgba(255,150,120,.12)}
  .plp-notouch__specimen{position:relative;margin:14px -16px -16px -20px;overflow:hidden;border-radius:0 0 15px 15px}
  .plp-notouch__specimen::before{content:"";position:absolute;inset:0 0 auto;height:62%;z-index:1;pointer-events:none;background:linear-gradient(180deg,#15120c 3%,rgba(21,18,12,.42) 56%,rgba(21,18,12,0))}
  .plp-notouch__bee{display:block;width:100%;height:clamp(126px,21vw,166px);object-fit:cover;object-position:47% 40%}
  @media (prefers-reduced-motion:no-preference){.plp-notouch__bee{animation:plpNtGlow 10s ease-in-out infinite alternate}}
  @keyframes plpNtGlow{from{transform:scale(1.03)}to{transform:scale(1.09)}}

  /* ---------- compare + faq ---------- */
  .plp-vs{display:grid;grid-template-columns:1.55fr .45fr;gap:20px;align-items:start}
  .plp-vs__main,.plp-faq{min-width:0}
  .plp-vs__scroll{overflow-x:auto;max-width:100%;border:1px solid var(--line);border-radius:10px;background:#fff}
  .plp-vs__scroll table{width:100%;border-collapse:collapse;min-width:680px}
  .plp-vs__scroll th,.plp-vs__scroll td{border-bottom:1px solid var(--line);padding:12px 10px;font-size:13px;line-height:1.55;text-align:center}
  .plp-vs__scroll thead th{background:#211c15;color:#fff;font-weight:900;font-size:12.5px}
  .plp-vs__scroll thead th.is-us{background:var(--red);font-size:13px}
  .plp-vs__scroll tbody th{background:#faf6ee;text-align:left;font-weight:900;white-space:nowrap}
  .plp-vs__scroll td.is-us{background:#fff2f1;color:var(--red);font-weight:900}
  .plp-vs__scroll tr:last-child th,.plp-vs__scroll tr:last-child td{border-bottom:0}
  .plp-faq{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px 16px 8px;box-shadow:0 4px 14px rgba(40,25,0,.05)}
  .plp-faq h3{margin:0 0 8px;font-size:18px;font-weight:900}
  .plp-faq details{border-top:1px solid var(--line)}
  .plp-faq summary{cursor:pointer;list-style:none;position:relative;padding:12px 22px 12px 0;font-size:13.5px;font-weight:900;line-height:1.5}
  .plp-faq summary::after{content:"＋";position:absolute;right:0;top:12px;color:var(--red);font-weight:900}
  .plp-faq details[open] summary::after{content:"−"}
  .plp-faq details p{margin:0 0 12px;font-size:12.5px;font-weight:700;color:var(--muted);line-height:1.75}

  /* ---------- flow ---------- */
  .plp-flow{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
  .plp-flow li{background:#fff;border:1px solid var(--line);border-radius:10px;padding:20px 14px;text-align:center;box-shadow:0 4px 14px rgba(40,25,0,.06)}
  .plp-flow span{display:grid;place-items:center;width:38px;height:38px;margin:0 auto 10px;border-radius:50%;background:var(--red);color:#fff;font-weight:900;font-size:17px}
  .plp-flow b{display:block;font-size:15.5px;font-weight:900}
  .plp-flow small{display:block;margin-top:8px;font-size:12px;font-weight:700;color:var(--muted);line-height:1.7;text-align:left}

  /* ---------- area ---------- */
  .plp-area{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}
  .plp-area__nagoya{background:#fff;border:2px solid #e5b45c;border-radius:12px;padding:20px;box-shadow:0 4px 14px rgba(40,25,0,.06)}
  .plp-area__nagoya>b{display:block;font-size:18px;font-weight:900;margin-bottom:12px;color:#161310}
  .plp-area__nagoya div{display:flex;flex-wrap:wrap;gap:7px}
  .plp-area__nagoya span{background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:12.5px;font-weight:800}
  .plp-area__cols{display:grid;gap:12px}
  .plp-area__cols>div{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px}
  .plp-area__cols b{display:block;font-size:14.5px;font-weight:900;color:var(--red);margin-bottom:5px}
  .plp-area__cols p{margin:0;font-size:12.5px;font-weight:700;color:#443929;line-height:1.8}

  /* ---------- columns links ---------- */
  .plp-cols{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .plp-cols a{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:13px 15px;font-size:13.5px;font-weight:800;color:#2a2118;box-shadow:0 3px 10px rgba(40,25,0,.05);line-height:1.5}
  .plp-cols a::before{content:"›";color:var(--red);font-weight:900;font-size:17px;flex:none;line-height:1}
  .plp-cols__all{display:flex;width:fit-content;margin:16px auto 0}

  /* ---------- final ---------- */
  .plp-final{background:linear-gradient(180deg,#e0212a,#9d0a10);padding:32px 0 0;color:#fff}
  .plp-final__box{display:flex;flex-direction:column;align-items:center;text-align:center;padding-bottom:28px}
  .plp-final__pill{display:inline-flex;align-items:center;gap:6px;background:#ffcf3d;color:#7a1500;font-size:13px;font-weight:900;border-radius:999px;padding:6px 16px;margin-bottom:14px}
  .plp-final__pill svg{width:16px;height:16px}
  .plp-final__lead{margin:0 0 10px;font-size:clamp(16px,2vw,22px);font-weight:900}
  .plp-final__num{display:inline-flex;align-items:center;justify-content:center;gap:12px;max-width:100%;background:#fff;border-radius:14px;padding:12px clamp(20px,3vw,34px);box-shadow:0 12px 30px rgba(90,0,0,.3)}
  .plp-final__num svg{width:clamp(30px,4vw,42px);height:clamp(30px,4vw,42px);flex:none;color:var(--red)}
  .plp-final__num b{font-size:clamp(32px,5.2vw,56px);font-weight:900;letter-spacing:.01em;line-height:1;white-space:nowrap;color:#c00d15}
  .plp-final__hours{margin:10px 0 0;font-size:13px;font-weight:800;color:#ffdedb}
  .plp-final__line{display:flex;align-items:center;justify-content:center;gap:14px;background:linear-gradient(180deg,#0dbf5b,#029343);padding:18px 16px calc(18px + env(safe-area-inset-bottom)*0);color:#fff}
  .plp-final__lineic{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#fff;color:#06b451}
  .plp-final__lineic svg{width:30px;height:30px}
  .plp-final__line span:not(.plp-final__lineic){display:flex;flex-direction:column;line-height:1.25}
  .plp-final__line b{font-size:clamp(17px,2vw,21px);font-weight:900}
  .plp-final__line small{font-size:12.5px;font-weight:800;color:#dcffe9}

  /* ---------- float ---------- */
  .plp-float{position:fixed;left:0;right:0;bottom:0;z-index:70;display:none;gap:8px;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-top:1px solid var(--line);box-shadow:0 -4px 16px rgba(0,0,0,.1)}
  .plp-float a{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;border-radius:10px;color:#fff}
  .plp-float svg{width:24px;height:24px}
  .plp-float span{display:flex;flex-direction:column;line-height:1.15;text-align:left}
  .plp-float b{font-size:15.5px;font-weight:900}
  .plp-float small{font-size:10.5px;font-weight:800}
  .plp-float__tel{flex:1.15;background:linear-gradient(180deg,#ef2b24,var(--red-d))}
  .plp-float__line{flex:.85;background:linear-gradient(180deg,#0dbf5b,var(--green-d))}

  /* ============ mobile (≤899px) ============ */
  @media (max-width: 899px) {
    .plp-in{width:min(100% - 24px,1140px)}
    .plp-head__in{min-height:60px;gap:8px}
    .plp-head__mid{display:none}
    .plp-brand img{width:36px;height:36px}
    .plp-brand b{font-size:13.5px;line-height:1.2}
    .plp-brand .plp-brand__br{display:inline}
    .plp-brand small{display:none}
    .plp-head__cta{margin-left:auto;gap:6px}
    .plp-hbtn{padding:7px 10px;border-radius:7px}
    .plp-hbtn--tel{background:#fff;box-shadow:0 2px 8px rgba(215,25,32,.16);color:var(--red);padding:6px 11px;border:1.6px solid var(--red);border-radius:9px}
    .plp-hbtn--tel svg{width:19px;height:19px}
    .plp-hbtn__pc{display:none}
    .plp-hbtn--tel .plp-hbtn__sp{display:flex;flex-direction:column;line-height:1.05;text-align:left}
    .plp-hbtn__sp b{font-size:19px;font-weight:900;letter-spacing:0}
    .plp-hbtn__sp small{font-size:9px;font-weight:800;color:#555;margin-top:2px}
    .plp-hbtn--line{display:none}

