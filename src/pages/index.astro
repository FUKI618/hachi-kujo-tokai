  /* ===== PC(≥900px)最適化：横幅を使うレイアウト（モバイルは @media 外＝一切不変） ===== */
  .xhero-pc { display:none; }
  @media (min-width:900px){
    .xhero { display:none; }                       /* モバイル焼込み画像はPCで隠す */

    /* === PC専用ヒーロー（AI生成チラシ型モック画像＋透明タップ計測） === */
    .xhero-pc { display:block; background:linear-gradient(180deg,#cfe8fb 0%,#eaf6ff 62%,#f4fbff 100%); padding-bottom:2px; }
    .xhpc-wrap { position:relative; max-width:1320px; margin:0 auto; line-height:0; }
    .xhpc-mock { width:100%; height:auto; display:block; }
    .xhpc-tap { position:absolute; display:block; z-index:2; -webkit-tap-highlight-color:transparent; border-radius:14px; }
    .xhpc-tap-tel  { left:57.5%; top:68.5%; width:41.5%; height:16.5%; }
    .xhpc-tap-line { left:65.5%; top:85%;  width:31.5%; height:10%; }

    /* 下半分：横幅を使う多段グリッド */
    .xb { max-width:1080px; }
    .xb section { padding:46px 30px; }
    .xb-lead, .xb-note { text-align:center; max-width:780px; margin-inline:auto; }
    .xrate-free { max-width:760px; margin-inline:auto; }
    .xrate-card { max-width:760px; margin-inline:auto; }
    .xb-why { display:grid; grid-template-columns:repeat(3,1fr); align-items:stretch; }
    .xdanger-grid { grid-template-columns:1fr 1fr; max-width:880px; margin-inline:auto; gap:20px; }
    .xdanger img { height:300px; }
    .xpromise { grid-template-columns:repeat(3,1fr); }
    .xbee-grid { grid-template-columns:repeat(3,1fr); }
    .xb-cases { grid-template-columns:repeat(4,1fr); }
    .xb-voices { display:grid; grid-template-columns:repeat(3,1fr); align-items:start; }
    .xb-flow { flex-direction:row; align-items:stretch; }
    .xb-flow-step { flex:1; flex-direction:column; align-items:center; text-align:center; }
    .xb-areas { display:grid; grid-template-columns:repeat(3,1fr); }
