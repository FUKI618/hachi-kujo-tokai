---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { assetPath, isHornetPeakSeason } from "../lib/site";
import { company } from "../data/company";
import { strengths } from "../data/strengths";
import { troubles } from "../data/troubles";
import { beeTypes } from "../data/bee-types";
import { rates } from "../data/rates";
import { promises } from "../data/promises";
import { compareRows } from "../data/compare";
import { cases } from "../data/cases";
import { voices } from "../data/voices";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";
import { faqs } from "../data/faq";
import { diyOkConditions, diyNgConditions } from "../data/diy-guide";
import { vsGovernmentRows, subsidyNote } from "../data/vs-government";
import { promiseCards } from "../data/scam-warning";

const title = `名古屋・愛知の蜂の巣駆除なら最短30分｜基本1,680円〜｜${company.name}`;
const description = `蜂の巣駆除を名古屋・愛知＋岐阜・三重の近郊エリアで最短30分。事前見積金額からの追加請求なしのハチ駆除専門【${company.name}】。スズメバチ¥2,680〜・アシナガバチ¥1,680〜、基本1,680円〜で対応。24時間365日受付・見積り無料・キャンセル料0円・1年再発保証。`;

const fmtJpy = (n: number) =>
  new Intl.NumberFormat("ja-JP").format(n);

const heroPattern = assetPath("images/hero/pattern.svg");

// Gemini生成画像（人物/文字なし）。未配置ならブロックごと非表示にしてブロークンリンクを防ぐ。
const publicDir = path.resolve("./public");
const genImage = (rel: string): string | null =>
  fs.existsSync(path.join(publicDir, rel)) ? assetPath(rel) : null;
const generatedEmergencyNest = genImage("images/generated/emergency-nest-eaves.webp");
const generatedEquipment = genImage("images/generated/protective-equipment.webp");
const generatedEstimate = genImage("images/generated/estimate-document-tools.webp");
const generatedCleanEaves = genImage("images/generated/clean-eaves-after-removal.webp");

const showSeasonalAlert = isHornetPeakSeason();
---

<Layout title={title} description={description}>
  <!-- ===== SVG Icon Sprite ===== -->
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="i-bee" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="13" rx="6" ry="7"/>
      <path d="M12 6 L12 20 M9 6 L9 20 M15 6 L15 20"/>
      <ellipse cx="6" cy="9" rx="3" ry="1.5" transform="rotate(-30 6 9)"/>
      <ellipse cx="18" cy="9" rx="3" ry="1.5" transform="rotate(30 18 9)"/>
    </symbol>
    <symbol id="i-lightning" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 L4 14 H10 L9 22 L20 10 H14 Z"/></symbol>
    <symbol id="i-yen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4 L12 13 L18 4"/><path d="M12 13 L12 21"/><path d="M7 14 L17 14"/><path d="M7 18 L17 18"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L4 6 L4 12 C4 17 7.5 20.5 12 22 C16.5 20.5 20 17 20 12 L20 6 Z"/><path d="M9 12 L11 14 L15 10"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    <symbol id="i-line" viewBox="0 0 24 24" fill="currentColor"><path d="M19 5H5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h2v3.6c0 .3.4.5.7.3l4.3-3.9H19a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 L10 17 L19 7"/></symbol>
    <symbol id="i-check-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12 L11 15 L16 9"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 L18 18 M18 6 L6 18"/></symbol>
    <symbol id="i-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L22 20 L2 20 Z"/><path d="M12 10 L12 15"/><circle cx="12" cy="17.5" r="0.6" fill="currentColor"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22 C16 16 19 13 19 9 A7 7 0 0 0 5 9 C5 13 8 16 12 22 Z"/><circle cx="12" cy="9" r="2.5"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 L14.6 8.6 L21.6 9.3 L16.3 14 L17.9 21 L12 17.3 L6.1 21 L7.7 14 L2.4 9.3 L9.4 8.6 Z"/></symbol>
    <symbol id="i-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9 7 H6 a3 3 0 0 0-3 3 v3 a3 3 0 0 0 3 3 H7 v0 c0 2.2-1.8 4-4 4 v2 c4.4 0 8-3.6 8-8 V8 a1 1 0 0 0-1-1 z"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21 C4 16.6 7.6 13 12 13 C16.4 13 20 16.6 20 21"/></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9"/></symbol>
    <symbol id="i-headset" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14 V12 a8 8 0 0 1 16 0 V14"/><rect x="3" y="14" width="4" height="6" rx="1.2"/><rect x="17" y="14" width="4" height="6" rx="1.2"/></symbol>
    <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 H19 M13 6 L19 12 L13 18"/></symbol>
  </svg>

  <!-- ===== Sticky Topbar（営業情報） ===== -->
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-item">
        <svg class="icon"><use href="#i-headset" /></svg>
        <span><strong>24時間365日</strong> 受付中</span>
      </span>
      <span class="topbar-item">
        <svg class="icon"><use href="#i-check-circle" /></svg>
        <span>通話・出張・見積り <strong>すべて無料</strong></span>
      </span>
      <span class="topbar-item">
        <svg class="icon"><use href="#i-lightning" /></svg>
        <span>最短<strong>30分</strong>で出動</span>
      </span>
    </div>
  </div>

  <!-- ===== Sticky Header ===== -->
  <header class="header">
    <div class="container header-inner">
      <a href="#" class="brand" aria-label="トップへ">
        <span class="brand-mark"><svg class="icon"><use href="#i-bee" /></svg></span>
        <span>{company.name}</span>
      </a>
      <a href={company.phoneTelLink} class="header-tel" data-cta="header_tel">
        <svg class="icon"><use href="#i-phone" /></svg>
        <span>
          <small>365日24時間受付</small>
          {company.phoneDisplay}
        </span>
      </a>
    </div>
  </header>

  {showSeasonalAlert && (
    <div class="seasonal-alert" role="status" aria-live="polite">
      <div class="container seasonal-alert-inner">
        <svg class="icon" aria-hidden="true"><use href="#i-warning" /></svg>
        <span><strong>9月15日〜10月15日はスズメバチ攻撃性ピーク</strong>。新女王誕生で防衛本能が極大化する最危険期です。</span>
      </div>
    </div>
  )}

  <!-- ===== ① Hero（反応型・写真主導） ===== -->
  <section class="rhero" aria-labelledby="hero-title">
    <div class="rhero-bg" aria-hidden="true"></div>
    <div class="container rhero-inner">

      <!-- 1. トップ警告フラッグ -->
      <p class="rhero-toptag">
        <span class="rhero-flag"><small>最短</small><b>30</b><small>分</small></span>
        <span class="rhero-toptag-main"><em>そのまま放置すると危険！</em>で駆けつけます</span>
      </p>

      <!-- 2. 特大タイトル（画像の真上） -->
      <h1 class="rhero-title" id="hero-title">
        <img class="rhero-hornet" src={assetPath("images/generated/hornet.webp")} width="300" height="300" alt="" aria-hidden="true" loading="eager" decoding="async" />
        <span class="rhero-title-sub">危険な<span class="rhero-title-kw">蜂の巣</span>・蜂被害を</span>
        <span class="rhero-title-main">
          <span class="rhero-title-day">即日</span>
          <span class="rhero-title-xl" data-text="スピード解決">スピード解決</span>
        </span>
        <span class="rhero-title-area"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg>愛知・岐阜・三重（名古屋近郊エリア）対応 ／ 24時間365日受付</span>
      </h1>

      <!-- 3. アクション主役写真 -->
      <figure class="rhero-action">
        <img src={assetPath("images/generated/hero-action.webp")} width="1536" height="1024"
             alt="防護装備で住宅の軒下の蜂の巣を駆除する専門スタッフ（イメージ）" loading="eager" decoding="async" fetchpriority="high" />
        <span class="rhero-action-badge"><strong>1年</strong><span>再発保証</span></span>
        <figcaption class="rhero-action-cap">※写真はイメージです</figcaption>
      </figure>

      <!-- 4. お悩みサムネ4枚帯 -->
      <ul class="rhero-thumbs" aria-label="よくある蜂被害">
        <li>
          <img src={assetPath("images/generated/emergency-nest-eaves.webp")} width="240" height="180" alt="軒下の蜂の巣（イメージ）" loading="lazy" decoding="async" />
          <span>軒下に<wbr />巣がある</span>
        </li>
        <li>
          <img src={assetPath("images/bee-types/oosuzumebachi.webp")} width="240" height="180" alt="大きな蜂（イメージ）" loading="lazy" decoding="async" />
          <span>大きい蜂が<wbr />出入りする</span>
        </li>
        <li>
          <img src={assetPath("images/cases/case-01.webp")} width="240" height="180" alt="ベランダ・庭木の蜂の巣（イメージ）" loading="lazy" decoding="async" />
          <span>ベランダ・<wbr />庭に巣</span>
        </li>
        <li>
          <img src={assetPath("images/generated/clean-eaves-after-removal.webp")} width="240" height="180" alt="屋根裏・室外機まわりの蜂（イメージ）" loading="lazy" decoding="async" />
          <span>室外機・<wbr />屋根裏に蜂</span>
        </li>
      </ul>

      <!-- 5. 大価格ブロック（捏造演出なし・正直版） -->
      <div class="rhero-price">
        <div class="rhero-price-main">
          <span class="rhero-price-label">基本料金</span>
          <span class="rhero-price-num font-num">¥1,680<small>〜</small></span>
          <span class="rhero-price-tax">（税込）</span>
        </div>
        <div class="rhero-price-free">
          <strong>追加料金&nbsp;0円</strong>
          <span>事前見積の金額を厳守</span>
        </div>
        <p class="rhero-price-note">※ 種類・巣の大きさ・場所で変動。出張・現地調査・見積りもすべて0円。</p>
      </div>

      <!-- 6. CTA帯（モバイル: 価格ブロック直後に前傾。PCはgrid-area "cv"で従来位置） -->
      <div class="rhero-cv">
        <p class="rhero-cv-head"><span class="rhero-cv-zero">現地調査・お見積り<b>0円</b></span>今すぐお問い合わせください！</p>
        <a href={company.phoneTelLink} class="rhero-tel" data-cta="hero_tel">
          <span class="rhero-tel-icon" aria-hidden="true"><svg class="icon"><use href="#i-phone" /></svg></span>
          <span class="rhero-tel-body">
            <span class="rhero-tel-cta">蜂を見たら<em>今すぐ電話</em><span class="rhero-tel-free">無料</span></span>
            <span class="rhero-tel-num font-num">{company.phoneDisplay}</span>
            <span class="rhero-tel-note">最短30分で駆けつけ｜通話料0円・24時間365日受付</span>
          </span>
        </a>
        <a href={company.lineUrl} class="rhero-line" data-cta="hero_line">
          <svg class="icon" aria-hidden="true"><use href="#i-line" /></svg>
          <span>LINEで巣の写真を送る<small>→ 概算をすぐ回答</small></span>
        </a>
      </div>

      <!-- 7. 実績フォトカード3枚（モバイル: CTA後ろへ。PCはgrid-area "benefits"で従来位置） -->
      <ul class="rhero-benefits" aria-label="サービスの特長">
        <li>
          <img src={assetPath("images/generated/staff-onsite.webp")} width="200" height="150" alt="名古屋・愛知で自社対応するスタッフ（イメージ）" loading="lazy" decoding="async" />
          <span>名古屋・愛知で<wbr />自社直接対応</span>
        </li>
        <li>
          <img src={assetPath("images/generated/estimate-document-tools.webp")} width="200" height="150" alt="見積書（イメージ）" loading="lazy" decoding="async" />
          <span>見積後の<wbr />追加請求なし</span>
        </li>
        <li>
          <img src={assetPath("images/generated/protective-equipment.webp")} width="200" height="150" alt="防護装備（イメージ）" loading="lazy" decoding="async" />
          <span>危険な蜂も<wbr />即日駆除対応</span>
        </li>
      </ul>

    </div>
  </section>

  <!-- ===== ①′ 緊急ブロック（Loss aversion + 早期相談誘導） ===== -->
  <section class="urgency-block" aria-labelledby="urgency-title">
    <div class="container urgency-inner">
      <h2 id="urgency-title" class="urgency-headline">
        巣は1日で<span class="urgency-num">約3cm</span>拡大します
      </h2>
      <p class="urgency-sub">
        今日の電話が、明日の費用を<strong>半分以下</strong>にすることがあります。蜂の巣は1日で2〜3cm成長し、サイズが2倍になれば作業時間も費用も比例して増えます。<br /><strong>今この瞬間が、いちばん小さい巣です。</strong>
      </p>
      <a href={company.phoneTelLink} class="urgency-cta" data-cta="urgency_tel">
        <svg class="icon" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="urgency-cta-body">
          <span class="urgency-cta-lead">今すぐ電話で相談する</span>
          <span class="urgency-cta-number font-num">{company.phoneDisplay}</span>
          <span class="urgency-cta-label">迷う時間が、費用に変わる前に</span>
        </span>
      </a>
      <p class="urgency-note">※成長速度は蜂種・季節・環境により異なります</p>
    </div>
  </section>

  <!-- ===== ②′ Trust strip（Hero直下の安心材料バー） ===== -->
  <section
    class={`trust-strip${generatedEmergencyNest ? "" : " is-no-image"}`}
    aria-label="ご相談前の安心材料"
  >
    <div class="container trust-strip-inner">
      <div class="trust-strip-copy">
        <span class="trust-strip-eyebrow">FIRST CHECK</span>
        <h2 class="headline trust-strip-title">
          急ぎの蜂の巣駆除でも、<wbr /><span>作業前に金額を確認</span><wbr />できます。
        </h2>
        <p>
          出張・見積り・キャンセル料は無料。蜂の種類、巣の大きさ、高さ、場所を確認し、
          作業内容と金額をご説明してから駆除します。
        </p>
        <ul class="trust-strip-points">
          <li><svg class="icon"><use href="#i-check" /></svg>自社直接施工（仲介マージン0）</li>
          <li><svg class="icon"><use href="#i-shield" /></svg>1年再発保証（戻り蜂も無料）</li>
          <li><svg class="icon"><use href="#i-yen" /></svg>出張・見積り無料</li>
          <li><svg class="icon"><use href="#i-check-circle" /></svg>作業前に金額提示</li>
          <li><svg class="icon"><use href="#i-headset" /></svg>24時間365日受付</li>
        </ul>
      </div>
      {generatedEmergencyNest && (
        <figure class="trust-strip-visual">
          <img
            src={generatedEmergencyNest}
            alt="住宅の軒下にできた蜂の巣のイメージ"
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </section>

  <!-- ===== ③ Troubles（お悩み訴求） ===== -->
  <section class="section troubles" id="troubles" aria-labelledby="troubles-title">
    <div class="container">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">CHECK!</span>
      </div>
      <h2 id="troubles-title" class="section-title headline">
        こんな<span class="hl">お悩み</span>、<wbr />ありませんか？
      </h2>
      <ul class="troubles-grid reveal-stagger">
        {troubles.map((t) => (
          <li class="bubble" set:html={t} />
        ))}
      </ul>
      <div class="troubles-arrow reveal" aria-hidden="true"></div>
      <div class="troubles-resolve reveal">
        <span class="troubles-resolve-lead">その悩み、</span>
        <strong class="troubles-resolve-brand">{company.name}</strong>
        <span class="troubles-resolve-tail">が最短<span class="big">30分</span>で解決します。</span>
      </div>

      <!-- ④ 強み3点（troublesセクションへ統合） -->
      <h2 id="strengths-title" class="section-title headline" style="margin-top:2.75rem;">
        選ばれる<span class="accent">3つの理由</span>
      </h2>
      <p class="section-lead">
        名古屋・愛知のハチ駆除専門。<strong>基本1,680円〜・即日駆けつけ・事前見積金額厳守・1年再発保証</strong>で選ばれています。広告代理店も中間業者も挟まない<strong>自社直接対応</strong>だから、品質はそのままにこの価格を実現しています。
      </p>
      <div class="strengths reveal-stagger">
        {strengths.map((s) => (
          <article class={`strength-card ${s.featured ? "is-featured" : ""}`}>
            <span class="strength-num font-num">{s.num}</span>
            <div class="strength-icon">
              <svg class="icon"><use href={`#i-${s.iconId}`} /></svg>
            </div>
            <h3 class="strength-title headline" set:html={s.title.replaceAll("<hl>", '<span class="hl">').replaceAll("</hl>", "</span>")} />
            <p class="strength-desc">{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ④′ Equipment proof（装備で専門性補強） ===== -->
  <section
    class={`section equipment-proof${generatedEquipment ? "" : " is-no-image"}`}
    aria-labelledby="equipment-proof-title"
  >
    <div class="container equipment-proof-inner">
      {generatedEquipment && (
        <figure class="equipment-proof-image">
          <img
            src={generatedEquipment}
            alt="蜂駆除に使用する防護装備と専用機材のイメージ"
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
      <div class="equipment-proof-copy">
        <span class="section-eyebrow">SAFETY CHECK</span>
        <h2 id="equipment-proof-title" class="headline equipment-proof-title">
          種類と巣の場所を確認してから作業します
        </h2>
        <p>
          スズメバチ・アシナガバチ・ミツバチなど、種類や営巣場所によって危険度と作業内容は変わります。
          現地で状況を確認し、作業内容と金額をご説明してから駆除します。
        </p>
        <div class="equipment-proof-note">
          <svg class="icon"><use href="#i-warning" /></svg>
          <span>種類が分からない場合や、巣が見えない場所にある場合も、無理に近づかずご相談ください。</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ⑤ BeeTypes（対応する蜂6種） ===== -->
  <section class="section section-soft" id="bee-types" aria-labelledby="bee-title">
    <div class="container">
      <div class="section-eyebrow-wrap">
        <span class="section-eyebrow">BEE TYPES</span>
      </div>
      <h2 id="bee-title" class="section-title headline">
        対応する<span class="accent">蜂の種類</span>
      </h2>
      <p class="section-lead">
        名古屋・愛知で営巣する全種のハチに対応。スズメバチ・オオスズメバチ・アシナガ・ミツバチまで、種類不明の初期巣でも<strong>ハチ駆除のプロ</strong>にご相談ください。
      </p>
      <div class="bee-grid reveal-stagger">
        {beeTypes.map((b) => (
          <article class="bee-card">
            <div class="bee-card-img">
              <img
                src={assetPath(`images/bee-types/${b.imageBase}.webp`)}
                alt={`${b.name}の写真`}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="bee-card-body">
              <span class={`bee-card-tag tag-${b.dangerLevel}`}>
