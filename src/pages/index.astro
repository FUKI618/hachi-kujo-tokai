    -webkit-text-stroke:.45cqw #fff; paint-order:stroke fill; text-shadow:0 .4cqw .55cqw rgba(0,0,0,.2); }

  /* L6 価格行 */
  .xh-price { left:0; top:31.9%; width:100%; height:8.8%; margin:0; display:flex; align-items:center; justify-content:center; gap:2.4cqw; }
  .xhp-cell { display:flex; align-items:baseline; gap:.4cqw; color:#1a1a1a; font-weight:900; }
  .xhp-cell small { font-size:3.6cqw; }
  .xhp-num { font-size:8.6cqw; font-weight:900; color:#d4151c; letter-spacing:-.02em; line-height:1; }
  .xhp-tilde { font-size:5cqw; color:#d4151c; }
  .xhp-tax { font-size:2.2cqw; color:#6b6b6b; font-style:normal; font-weight:700; }
  .xhp-div { width:.4cqw; height:7cqw; background:#cfc7ba; align-self:center; }

  /* L7 電話CTA帯 */
  .xh-cta { left:5%; top:42.6%; width:90%; height:13.4%; display:flex; align-items:center; gap:2cqw;
    text-decoration:none; color:#fff; background:linear-gradient(180deg,#f06a0c 0%,#e64805 45%,#cd1000 100%);
    border-radius:3cqw; padding:0 3.5cqw; box-shadow:0 1.4cqw 3cqw rgba(170,30,4,.4), inset 0 .3cqw 0 rgba(255,255,255,.25); }
  .xh-cta .xic { width:8cqw; height:8cqw; flex-shrink:0; filter:drop-shadow(0 .2cqw .3cqw rgba(0,0,0,.3)); }
  .xh-cta-tx { display:flex; flex-direction:column; align-items:flex-start; line-height:1.05; flex:1; min-width:0; }
  .xh-cta-top { font-size:2.7cqw; font-weight:900; color:#ffe39a; letter-spacing:.02em; }
  .xh-cta-num { font-size:7.6cqw; font-weight:900; letter-spacing:0; line-height:1.02; }
  .xh-cta-bot { font-size:2cqw; font-weight:700; }

  /* 緑ドット ただ今受付中 */
  .xh-now { top:51.2%; left:80%; width:14.5%; height:4.2%; display:flex; align-items:center; justify-content:center; gap:.5cqw; color:#fff; font-size:1.85cqw; font-weight:800; }
  .xh-now-dot { width:1.6cqw; height:1.6cqw; border-radius:50%; background:#27d24a; box-shadow:0 0 0 .4cqw rgba(255,255,255,.5); }

  /* L9 信頼4列 */
  .xh-trust { list-style:none; margin:0; left:0; top:86.7%; width:100%; height:13.3%; padding:0 1.5cqw;
    display:grid; grid-template-columns:repeat(4,1fr); align-items:center; background:#fefdf7; }
  .xh-trust li { display:flex; align-items:center; justify-content:center; gap:1cqw; }
  .xht-ic { width:7.6cqw; height:7.6cqw; flex-shrink:0; fill:none; stroke:#c0151c; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .xht-ic.xht-fill { fill:#c0151c; stroke:none; }
  .xht-chk { stroke:#fff; stroke-width:2.2; fill:none; }
  .xht-y0 { fill:#c0151c; stroke:none; font-size:9px; font-weight:900; text-anchor:middle; font-family:sans-serif; }
  .xh-trust span { display:flex; flex-direction:column; line-height:1.05; color:#333; }
  .xh-trust small { font-size:1.7cqw; font-weight:700; }
  .xh-trust b { font-size:3.4cqw; font-weight:900; color:#1a1a1a; }
  .xh-trust b em { color:#c0151c; font-style:normal; font-size:.72em; }

  /* 通話無料 金シール（CTA右上・cqw） */
  .xseal { top:39.6%; left:82.5%; width:13.5%; aspect-ratio:1/1; transform:rotate(-8deg); pointer-events:none; z-index:6; }
  .xseal-body { position:absolute; inset:0; border-radius:50%;
    background:radial-gradient(110% 110% at 32% 24%, #fdf0c2 0%, #f7d785 34%, #eab63f 64%, #cf9220 100%);
    box-shadow:0 .6cqw 1.8cqw rgba(60,30,0,.42), inset 0 0 0 .3cqw #fff7e0, inset 0 0 0 .7cqw #b9831a;
    display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .xseal-l1 { font-size:2.4cqw; font-weight:900; color:#7a1208; line-height:1; letter-spacing:.04em; }
  .xseal-l2 { font-size:5.6cqw; font-weight:900; color:#a60101; line-height:.9; }
  .xseal-ring { position:absolute; inset:0; border-radius:50%; border:.4cqw solid #f2c14e; opacity:0;
    animation:xsealring 1.9s cubic-bezier(.22,.61,.36,1) infinite; }
  @keyframes xsealring { 0%{ transform:scale(1); opacity:.6; } 70%{ transform:scale(1.4); opacity:0; } 100%{ opacity:0; } }
  @media (prefers-reduced-motion:reduce){ .xseal-ring,.xh-now-dot { animation:none; } }

  /* 電話10%OFF クーポンバッジ（CTA右上・旧通話料無料シール跡／赤地黄文字） */
  .xcpn { position:absolute; top:38.6%; left:81.3%; width:15.5%; aspect-ratio:1/1; transform:rotate(8deg); pointer-events:none; z-index:7; }
  .xcpn-body { position:absolute; inset:0; border-radius:50%;
    background:radial-gradient(112% 112% at 32% 24%, #ff7a4d 0%, #ef2f12 44%, #bd0a08 100%);
    box-shadow:0 .6cqw 1.8cqw rgba(80,0,0,.45), inset 0 0 0 .3cqw #fff, inset 0 0 0 .8cqw #ffd23f;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.1cqw; }
  .xcpn-l1 { font-size:2.5cqw; font-weight:900; color:#fff; line-height:1; letter-spacing:.02em; }
  .xcpn-l2 { font-size:5.8cqw; font-weight:900; color:#ffe200; line-height:.82; text-shadow:0 .2cqw .2cqw rgba(0,0,0,.25); }
  .xcpn-l2 i { font-size:.6em; font-style:normal; }
  .xcpn-l3 { font-size:3.6cqw; font-weight:900; color:#ffe200; line-height:.9; letter-spacing:.08em; }

  /* ===== 下半分 共通（ヒーロー基調） ===== */
  .xb { --red:#a60101; --red2:#c81e1e; --ink:#241608; --cream:#fdfcf6; --line:rgba(20,12,4,.10);
    max-width:480px; margin-inline:auto; background:var(--cream); color:var(--ink);
    font-family:"Noto Sans JP","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif; }
  .xb section { padding:26px 16px; }
  .xb-sec-tint { background:#fff6ec; }
  .xb-h { display:flex; justify-content:center; margin:0 0 16px; }
  .xb-h span { display:inline-block; background:linear-gradient(180deg,#b81810,#8c1108); color:#fff;
    font-size:1.06rem; font-weight:900; letter-spacing:.01em; padding:.62rem 1.5rem; border-radius:16px;
    line-height:1.45; text-align:center; text-wrap:balance; word-break:auto-phrase; max-width:90%;
    box-shadow:0 4px 12px rgba(150,20,12,.28); }
  /* 全体テキスト監査：日本語の文節折返しで途中改行・不格好を解消 */
  .xb h3 { text-wrap:balance; word-break:auto-phrase; }
  .xb p, .xb li, .xb figcaption, .xb dd, .xb dt { word-break:auto-phrase; text-wrap:pretty; }
  .xb-lead { font-size:.86rem; line-height:1.75; margin:0 0 14px; word-break:auto-phrase; text-wrap:pretty; }
  .xb-lead b, .xb-note b { color:var(--red); font-weight:900; }
  .xb-note { font-size:.72rem; color:#6b5d4a; line-height:1.6; margin:12px 2px 0; word-break:auto-phrase; text-wrap:pretty; }
  .xb-card { background:#fff; border:1px solid var(--line); border-radius:14px; box-shadow:0 3px 12px rgba(20,12,4,.06); }
  .xb-chip { background:linear-gradient(180deg,#ff7a1a,#e2231a); color:#fff; font-weight:900;
    padding:.28rem .7rem; border-radius:9999px; font-size:.96rem; white-space:nowrap; box-shadow:0 2px 6px rgba(200,40,10,.25); }
  .xb-chip-sm { font-size:.78rem; padding:.18rem .55rem; }
  .font-num { font-variant-numeric:tabular-nums; letter-spacing:.01em; }

  /* 料金（作り込み版） */
  .xrate-free { list-style:none; margin:0 0 14px; padding:0; display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  .xrate-free li { display:flex; flex-direction:column; align-items:center; gap:2px; background:#fff; border:1px solid var(--line);
    border-radius:12px; padding:.55rem .2rem .5rem; box-shadow:0 2px 8px rgba(20,12,4,.05); }
  .xrate-free-l { font-size:.6rem; font-weight:800; color:#5b4f3d; }
  .xrate-free-z { font-size:1.45rem; font-weight:900; color:#0a7d28; line-height:1; }
  .xrate-free-z small { font-size:.62rem; margin-left:1px; }

  .xrate-card { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; box-shadow:0 3px 12px rgba(20,12,4,.06); }
  .xrate-row { display:flex; align-items:center; gap:.85rem; padding:.95rem .95rem; border-bottom:1px solid var(--line); text-decoration:none; color:inherit; cursor:pointer; -webkit-tap-highlight-color:rgba(226,35,26,.12); }
  .xrate-row:active { background:#fff6f5; }
  .xrate-row:last-child { border-bottom:0; }
  .xrate-thumb { width:74px; height:48px; border-radius:8px; object-fit:contain; flex-shrink:0; border:1px solid var(--line); background:#fff; padding:2px; }
  .xrate-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
  .xrate-name { font-size:1rem; font-weight:900; line-height:1.2; }
  .xrate-cond { font-size:.66rem; color:#6b5d4a; line-height:1.5; }
  .xrate-price { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; line-height:1; }
  .xrate-price b { font-size:1.3rem; font-weight:900; color:#e2231a; letter-spacing:.01em; font-variant-numeric:tabular-nums; }
  .xrate-price small { font-size:.58rem; color:#6b5d4a; margin-top:4px; font-weight:700; }

  /* 選ばれる理由 / 流れ 共通 num */
  .xb-num { flex-shrink:0; width:2.1rem; height:2.1rem; border-radius:50%; display:grid; place-items:center;
    background:linear-gradient(180deg,#e8392c,#a60101); color:#fff; font-weight:900; font-size:.95rem; box-shadow:0 3px 8px rgba(166,1,1,.3); }
  .xb-why { display:flex; flex-direction:column; gap:10px; }
  .xb-why-card { display:flex; gap:.7rem; padding:.85rem .9rem; align-items:flex-start; }
  .xb-why-body h3 { margin:.1rem 0 .25rem; font-size:.96rem; font-weight:900; line-height:1.35; }
  .xb-why-body h3 hl { color:var(--red); }
  .xb-why-body p { margin:0; font-size:.8rem; line-height:1.65; color:#3f3526; }

  /* 放置の危険（問題提起・2カラム） */
  .xdanger-grid { display:grid; grid-template-columns:1fr; gap:12px; align-items:stretch; }
  .xdanger { margin:0; overflow:hidden; display:flex; flex-direction:column; }
  .xdanger img { width:100%; height:200px; object-fit:cover; display:block; }
  .xdanger-cap { margin:0; padding:.7rem .8rem .85rem; font-size:.78rem; line-height:1.6; color:#46402f; font-weight:600; }

  /* 他社見積もり比較（中間マージンゼロ） */
  .xvs-off { color:#ffd23f; font-size:1.22em; font-weight:900; text-shadow:0 1px 2px rgba(80,6,4,.55); }
  .xvs { display:grid; grid-template-columns:1fr 1fr; gap:10px; max-width:880px; margin:14px auto 0; }
  .xvs-card { background:#fff; border:1px solid var(--line); border-radius:12px; padding:.9rem .7rem; text-align:center; }
  .xvs-ours { border-color:var(--red); box-shadow:0 4px 14px rgba(226,35,26,.12); }
  .xvs-tag { display:inline-block; font-size:.72rem; font-weight:800; color:#6b5d4a; background:#f1ece3; border-radius:999px; padding:.25rem .7rem; }
  .xvs-tag-on { color:#fff; background:var(--red); }
  .xvs-pt { margin:.6rem 0 0; font-size:.78rem; line-height:1.65; color:#3f3526; word-break:auto-phrase; text-wrap:pretty; }
  .xvs-lead2 { text-align:center; font-size:.84rem; line-height:1.7; color:#46402f; margin:1rem auto 0; max-width:780px; font-weight:600; word-break:auto-phrase; text-wrap:pretty; }

  /* 地元の実在企業（差別化トラストバッジ） */
  .xlocal-badges { list-style:none; margin:14px auto 0; padding:0; max-width:680px; display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }
  .xlocal-badges li { display:flex; align-items:center; gap:.4rem; background:#fff; border:1px solid var(--line); border-radius:9999px;
    padding:.5rem .9rem; font-size:.82rem; font-weight:800; color:#3f3526; box-shadow:0 2px 8px rgba(20,12,4,.05); }
  .xlb-ic { width:1.35rem; height:1.35rem; flex-shrink:0; }
  .xlocal-note { text-align:center; }
  .xlocal-note a { color:var(--red); font-weight:800; text-decoration:underline; }

  /* 安心の3つのお約束 */
  .xpromise { display:grid; grid-template-columns:1fr; gap:12px; max-width:880px; margin-inline:auto; }
  .xpromise-card { display:flex; gap:.7rem; align-items:flex-start; padding:1rem .9rem; }
  .xpromise-ic { flex-shrink:0; width:1.9rem; height:1.9rem; border-radius:50%; background:var(--red); color:#fff; font-weight:900; display:flex; align-items:center; justify-content:center; font-size:1.05rem; line-height:1; }
  .xpromise-body h3 { margin:0 0 .3rem; font-size:.92rem; font-weight:800; color:#2a2113; }
  .xpromise-body p { margin:0; font-size:.8rem; line-height:1.7; color:#3f3526; }

  /* こんなお悩み（共感チェックリスト） */
  .xtrouble { max-width:600px; margin:0 auto; display:grid; gap:8px; list-style:none; padding:0; }
  .xtrouble li { position:relative; background:#fff; border:1px solid var(--line); border-radius:10px; padding:.7rem .8rem .7rem 2.3rem; font-size:.84rem; font-weight:600; color:#3f3526; }
  .xtrouble li::before { content:"✓"; position:absolute; left:.6rem; top:50%; transform:translateY(-50%); color:#fff; background:var(--red); width:1.25rem; height:1.25rem; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.72rem; font-weight:900; z-index:1; }
  .xtrouble li a { color:inherit; text-decoration:none; display:block; -webkit-tap-highlight-color:rgba(166,1,1,.10); }
  .xtrouble li a::after { content:""; position:absolute; inset:0; z-index:0; }
  .xtrouble li:active { background:#fdf3f2; }
  .xtrouble-cta { text-align:center; }
  /* 蜂の巣ができやすい場所 */
  .xspots { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; max-width:680px; margin:14px auto 0; list-style:none; padding:0; }
  .xspots li { background:#fff; border:1px solid var(--line); border-radius:9999px; padding:.45rem .9rem; font-size:.82rem; font-weight:700; color:#46402f; box-shadow:0 2px 6px rgba(20,12,4,.05); }
  /* 決済手段 */
  .xpay { text-align:center; font-size:.76rem; color:#6b5d4a; margin:10px 2px 0; }
  .xpay b { color:#3f3526; font-weight:800; }
  /* 別名アンカー（サイトリンク飛び先一致用） */
  .x-anchor { display:block; height:0; overflow:hidden; scroll-margin-top:8px; }
  /* 市役所 vs 当社 */
  .xgov { max-width:680px; margin:14px auto 0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 3px 12px rgba(20,12,4,.06); }
  .xgov-head, .xgov-row { display:grid; grid-template-columns:.85fr 1.35fr 1.35fr; }
  .xgov-head { background:#f1ece3; font-weight:800; font-size:.74rem; text-align:center; }
  .xgov-head span, .xgov-row span { padding:.6rem .55rem; border-bottom:1px solid var(--line); }
  .xgov-head .xgov-h-us { background:#fff1e8; color:var(--red); }
  .xgov-row:last-child span { border-bottom:0; }
  .xgov-label { font-weight:800; font-size:.72rem; color:#46402f; background:#faf6ef; display:flex; align-items:center; }
  .xgov-cell { font-size:.72rem; line-height:1.55; }
  .xgov-us-ok { color:#0a7d28; font-weight:700; }
  .xgov-warn { color:#8a5e00; }
  .xgov-bad { color:#b3261e; }
  .xgov-note { max-width:680px; margin:14px auto 0; font-size:.74rem; color:#5b4f3d; line-height:1.6; }
  .xgov-note ul { margin:.4rem 0 0; padding-left:1.1rem; }
  .xgov-note li { margin-bottom:.2rem; }

  /* 蜂種（統一カード） */
  .xbee-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; align-items:stretch; }
  .xbee { display:flex; flex-direction:column; background:#fff; border:1px solid var(--line);
    border-radius:14px; overflow:hidden; box-shadow:0 3px 12px rgba(20,12,4,.06); height:100%; }
  .xbee-photo { position:relative; background:#f3efe7; }
  .xbee-photo img { width:100%; height:122px; object-fit:cover; display:block; }
  .xbee-badge { position:absolute; top:8px; right:8px; color:#fff; font-size:.6rem; font-weight:800;
    padding:.16rem .46rem; border-radius:6px; box-shadow:0 2px 5px rgba(0,0,0,.25); white-space:nowrap; }
  .xbee-badge-max  { background:#7e0c0c; }
  .xbee-badge-high { background:#c81e1e; }
  .xbee-badge-mid  { background:#a85400; }
  .xbee-badge-low  { background:#2f7a2f; }
  .xbee-body { display:flex; flex-direction:column; gap:.4rem; padding:.7rem .8rem .85rem; flex:1; }
  .xbee-name { margin:0; font-size:.98rem; font-weight:900; line-height:1.2; }
  .xbee-meter { display:flex; gap:3px; }
  .xbee-meter i { width:14px; height:5px; border-radius:3px; background:#e7e0d4; }
  .xbee-meter i.on-max { background:#7e0c0c; } .xbee-meter i.on-high { background:#c81e1e; }
  .xbee-meter i.on-mid { background:#e07a18; } .xbee-meter i.on-low { background:#3a8a3a; }
  .xbee-desc { margin:0; font-size:.72rem; line-height:1.6; color:#46402f;
    display:-webkit-box; -webkit-line-clamp:3; line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .xbee-meta { margin:auto 0 0; display:flex; flex-direction:column; gap:2px; font-size:.64rem; color:#7a6c58; padding-top:.2rem; }
  .xbee-meta div { display:flex; gap:.4rem; }
  .xbee-meta dt { margin:0; font-weight:800; color:#6b5d4a; min-width:2.4em; flex-shrink:0; }
  .xbee-meta dd { margin:0; }

  /* 事例 */
  .xb-cases { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .xb-case-card { overflow:hidden; }
  .xb-case-card img { width:100%; height:120px; object-fit:cover; display:block; }
  .xb-case-body { padding:.55rem .65rem .7rem; }
  .xb-case-tags { display:flex; flex-wrap:wrap; gap:.25rem; margin-bottom:.3rem; }
  .xb-tag { font-size:.6rem; background:#fbe6df; color:#a02414; padding:.08rem .4rem; border-radius:5px; font-weight:700; }
  .xb-case-body h3 { margin:.1rem 0 .35rem; font-size:.78rem; font-weight:800; line-height:1.4; }
  .xb-case-status { margin:0; font-size:.7rem; font-weight:800; color:#0a7d28; display:flex; align-items:center; gap:.25rem; line-height:1.4; }
  .xb-case-check { display:inline-grid; place-items:center; width:1rem; height:1rem; border-radius:50%; background:#0a7d28; color:#fff; font-size:.62rem; flex-shrink:0; }

  /* 声 */
  .xb-voices { display:flex; flex-direction:column; gap:10px; }
  .xb-voice-card { padding:.8rem .9rem; }
  .xb-voice-head { display:flex; align-items:center; gap:.55rem; margin-bottom:.4rem; }
  .xb-avatar { width:2.1rem; height:2.1rem; border-radius:50%; background:#f0d9a8; color:#7a5a14; display:grid; place-items:center; font-weight:900; flex-shrink:0; }
  .xb-voice-meta { display:flex; flex-direction:column; font-size:.78rem; font-weight:800; line-height:1.2; }
  .xb-voice-meta small { font-size:.64rem; color:#7a6c58; font-weight:600; }
  .xb-stars { margin-left:auto; color:#f5a623; font-size:.85rem; letter-spacing:1px; }
  .xb-voice-card p { margin:0; font-size:.8rem; line-height:1.65; color:#3f3526; }

  /* 比較表 */
  .xb-cmp { overflow:hidden; }
  .xb-cmp table { width:100%; border-collapse:collapse; font-size:.7rem; }
  .xb-cmp th, .xb-cmp td { padding:.5rem .35rem; text-align:center; border-bottom:1px solid var(--line); vertical-align:middle; }
  .xb-cmp thead th { background:#3a2410; color:#fff; font-weight:800; }
  .xb-cmp thead th.xb-cmp-us { background:var(--red); }
  .xb-cmp tbody th { text-align:left; font-weight:800; background:#fff8ef; font-size:.68rem; }
  .xb-cmp td.xb-cmp-us { background:#fff3ee; }
  .xb-st { font-weight:700; }
  .xb-st-us-ok { color:#0a7d28; font-weight:900; } .xb-st-warn { color:#9a6a00; } .xb-st-bad { color:#b02414; }

  /* 流れ */
  .xb-flow { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .xb-flow-step { display:flex; gap:.7rem; align-items:center; padding:.7rem .9rem; }
  .xb-flow-step h3 { margin:0 0 .15rem; font-size:.92rem; font-weight:900; }
  .xb-flow-step p { margin:0; font-size:.78rem; color:#3f3526; line-height:1.55; }

  /* エリア */
