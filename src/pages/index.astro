  .xh-banner { left:0; top:13%; width:100%; height:5%; display:flex; align-items:center; justify-content:center; }
  .xh-banner span { display:inline-flex; align-items:center; gap:.12em; background:linear-gradient(178deg,#cf1512,#9c0d0b);
    color:#ffd23f; font-size:4.4cqw; font-weight:900; padding:.5cqw 6cqw; letter-spacing:-.02em; transform:skewX(-4deg);
    clip-path:polygon(2% 0,98% 0,100% 50%,98% 100%,2% 100%,0 50%); box-shadow:0 1cqw 2cqw rgba(0,0,0,.14);
    text-shadow:0 .2cqw .2cqw rgba(0,0,0,.35); }
  .xh-banner em { font-style:normal; }
  .xh-banner i { font-style:normal; color:#fff; font-size:.72em; }
  .xh-banner b { color:#ffd23f; font-size:1.32em; }

  /* L4/L5 見出し（黒＋白縁・斜体） */
  .xh-h1 { left:0; top:16.1%; width:100%; height:12%; margin:0; display:flex; align-items:center; justify-content:center;
