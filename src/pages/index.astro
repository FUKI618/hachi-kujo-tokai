        <p class="plp-final__lead">蜂の巣を見つけたら、迷わずお電話ください！</p>
        <a class="plp-final__num" href={company.phoneTelLink} data-cta="final_tel">
          <svg><use href="#ic-phone" /></svg><b>{company.phoneDisplay}</b>
        </a>
        <p class="plp-final__hours">受付 {company.phoneHours} 年中無休・通話無料</p>
      </div>
      <a class="plp-final__line" href={company.lineUrl} data-cta="final_line" target="_blank" rel="noopener">
        <span class="plp-final__lineic"><svg><use href="#ic-line" /></svg></span>
        <span><b>LINEで写真を送るだけ・気軽に相談</b><small>24時間受付中・簡単1分・相談だけでもOK</small></span>
      </a>
    </section>

    <!-- ============ モバイル固定CTA ============ -->
    <div class="plp-float" aria-label="固定お問い合わせ">
      <a class="plp-float__tel" href={company.phoneTelLink} data-cta="float_tel"><svg><use href="#ic-phone" /></svg><span><b>今すぐ電話する</b><small>{company.phoneDisplay}</small></span></a>
      <a class="plp-float__line" href={company.lineUrl} data-cta="float_line" target="_blank" rel="noopener"><svg><use href="#ic-line" /></svg><span><b>LINEで相談</b><small>写真を送るだけ</small></span></a>
    </div>

    <!-- 夜間(21時〜7時)はフロートCTAの文言を実態に合わせる（電話受付7〜21時・LINE24時間） -->
    <script is:inline>
      (function () {
        var jst = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Tokyo" }));
        var h = jst.getHours();
        if (h >= 7 && h < 21) return;
        var tb = document.querySelector(".plp-float__tel b");
        var ts = document.querySelector(".plp-float__tel small");
        var lb = document.querySelector(".plp-float__line b");
        var ls = document.querySelector(".plp-float__line small");
        if (tb) tb.textContent = "電話は朝7時から";
        if (ts) ts.textContent = "番号を保存できます";
        if (lb) lb.textContent = "LINEは24時間受付";
        if (ls) ls.textContent = "写真を送って相談";
      })();
    </script>

    <!-- premium motion: scroll reveal (reduced-motion では無効・JS無しでも全表示) -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var groups = [
          { sel: '.plp-h,.plp-urgent__card,.plp-zero article,.plp-pcard,.plp-ptable,.plp-local__panel,.plp-local__photos figure,.plp-case,.plp-danger__left,.plp-growth,.plp-notouch,.plp-vs__main,.plp-faq,.plp-flow li,.plp-area__nagoya,.plp-area__cols,.plp-cols li,.plp-secbtn,.plp-final__box', cls: 'rv' },
          { sel: '.plp-hexbadges li', cls: 'rv-pop' }
        ];
        var all = [];
        groups.forEach(function (g) {
          [].forEach.call(document.querySelectorAll(g.sel), function (el) {
            el.classList.add(g.cls);
            var p = el.parentElement, idx = [].indexOf.call(p.children, el);
            el.style.transitionDelay = Math.min(idx, 6) * 55 + 'ms';
            all.push(el);
          });
        });
        function reveal(el) { el.classList.add('rv-in'); }
        var io = new IntersectionObserver(function (ents) {
          ents.forEach(function (e) { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });
        all.forEach(function (el) { io.observe(el); });
        function sweep() { all.forEach(function (el) { if (!el.classList.contains('rv-in') && el.getBoundingClientRect().top < window.innerHeight * 0.92) reveal(el); }); }
        window.addEventListener('scroll', sweep, { passive: true });
        sweep();
        setTimeout(function () { all.forEach(reveal); }, 6000);
      })();
    </script>
  </main>

  <SiteFooter />
</Layout>

<style>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .plp{--red:#d71920;--red-d:#b80f16;--ink:#1a1a1a;--black:#0b0b0b;--gold:#c98710;--gold2:#e39a12;--green:#06b451;--green-d:#00a640;--paper:#f7f5f0;--line:#e5ded2;--muted:#666;
    font-family:"Noto Sans JP","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;color:var(--ink);background:#fff;font-feature-settings:"palt"}
  .plp *{box-sizing:border-box}
  .plp a{text-decoration:none;color:inherit}
  .plp svg{width:1.15em;height:1.15em;flex:none}
  .plp-in{width:min(1140px,calc(100% - 40px));margin-inline:auto}

  /* ---------- header ---------- */
  .plp-head{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line);box-shadow:0 2px 10px rgba(0,0,0,.06)}
  .plp-head__in{width:min(1220px,calc(100% - 24px));margin-inline:auto;min-height:74px;display:flex;align-items:center;gap:16px}
  .plp-brand{display:flex;align-items:center;gap:9px;min-width:0}
  .plp-brand img{width:46px;height:46px;object-fit:contain}
  .plp-brand b{display:block;font-size:19px;font-weight:900;line-height:1.15;color:#111}
  .plp-brand .plp-brand__br{display:none}
  .plp-brand small{display:block;font-size:11px;font-weight:800;color:#7a6a52;margin-top:2px}
  .plp-head__mid{margin-inline:auto;text-align:center}
  .plp-head__area{margin:0;font-size:12.5px;font-weight:900;color:#333}
  .plp-head__tel{margin:2px 0 0;display:flex;align-items:center;justify-content:center;gap:5px;font-size:15px;font-weight:900;color:#111}
  .plp-head__tel svg{color:var(--red)}
  .plp-head__tel span{font-size:12px;font-weight:800;color:#555;margin-left:4px}
  .plp-head__cta{display:flex;gap:8px}
  .plp-hbtn{display:flex;align-items:center;justify-content:center;gap:7px;border-radius:8px;padding:11px 16px;font-weight:900;color:#fff;white-space:nowrap;box-shadow:0 3px 10px rgba(0,0,0,.16)}
  .plp-hbtn--tel{background:linear-gradient(180deg,#ef2b24,var(--red-d))}
  .plp-hbtn--line{background:linear-gradient(180deg,#0dbf5b,var(--green-d))}
  .plp-hbtn--line .plp-hbtn__pc{display:flex;flex-direction:column;line-height:1.15}
  .plp-hbtn--line small{font-size:10px;font-weight:800;color:#eafff2}
  .plp-hbtn__sp{display:none}

  /* ---------- location bar ---------- */
  .plp-locbar{margin:0;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;background:linear-gradient(90deg,#16294a,#0e1d34);color:#fff;font-size:13px;font-weight:800;padding:10px 16px;text-align:center;line-height:1.4}
  .plp-locbar svg{width:17px;height:17px;color:#ffcf5a;flex:none}
  .plp-locbar b{color:#ffd86b;font-weight:900}
  .plp-locbar__area{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:3px 13px;font-size:12px;font-weight:800;color:#ffe6ad;white-space:nowrap}

  /* ---------- hero ---------- */
  .plp-hero{background:#fff}
  .plp-hero__media{position:relative;width:100%;aspect-ratio:1376/620;max-height:480px;overflow:hidden}
  .plp-hero__media>img{width:100%;height:100%;object-fit:cover;object-position:58% 42%;display:block}
  .plp-hero__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.9) 0%,rgba(255,255,255,.62) 28%,rgba(255,255,255,.1) 52%,transparent 70%)}
  .plp-hero__overlay{position:absolute;top:0;bottom:0;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;justify-content:center;width:min(1180px,100%);padding:0 clamp(20px,4.4vw,60px)}
  .plp-kicker{display:inline-flex;align-self:flex-start;margin:0 0 13px;padding:7px 14px;background:linear-gradient(180deg,var(--red),var(--red-d));color:#fff;border-radius:5px;font-size:clamp(12px,1.5vw,16px);font-weight:900;letter-spacing:.02em;box-shadow:0 4px 14px rgba(215,25,32,.3)}
