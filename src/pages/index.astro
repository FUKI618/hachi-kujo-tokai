  /* ---------- hero CTA + clerk ---------- */
  .plp-hero__ctawrap{display:flex;flex-direction:column;gap:10px;width:min(520px,calc(100% - 24px));margin:58px auto 0}
  .plp-callrow{position:relative}
  .plp-cta-lead{margin:0 0 8px;padding-left:clamp(126px,17vw,158px);text-align:center;font-size:clamp(12px,1.5vw,14px);font-weight:800;color:#3a2f22}
  .plp-cta-lead b{color:var(--red);font-weight:900}
  .plp-clerk{position:absolute;left:-4px;bottom:0;width:clamp(150px,16.5vw,196px);margin:0;z-index:4;pointer-events:none}
  .plp-clerk>img{width:100%;height:auto;display:block;filter:drop-shadow(0 6px 12px rgba(0,0,0,.28))}
  .plp-call{display:flex;align-items:center;justify-content:center;min-height:100px;padding:12px 18px 12px clamp(126px,17vw,158px);background:linear-gradient(180deg,#ef2b24,var(--red-d));border-radius:12px;box-shadow:0 8px 22px rgba(215,25,32,.4)}
  .plp-call span{display:flex;flex-direction:column;align-items:center;text-align:center;line-height:1.16;color:#fff}
  .plp-call small{font-size:13px;font-weight:900;color:#ffe9b8}
  .plp-call b{font-size:clamp(28px,3.3vw,38px);font-weight:900;letter-spacing:.01em}
  .plp-call em{font-style:normal;font-size:11.5px;font-weight:800;margin-top:3px;color:#ffd9d6}
  .plp-linebtn{display:flex;align-items:center;gap:12px;background:linear-gradient(180deg,#0dbf5b,var(--green-d));border-radius:10px;padding:11px 18px;color:#fff;box-shadow:0 6px 18px rgba(6,180,81,.35)}
  .plp-linebtn__badge{display:flex;align-items:center;gap:5px;font-weight:900;font-size:15px}
  .plp-linebtn__badge svg{width:26px;height:26px}
  .plp-linebtn span:not(.plp-linebtn__badge){display:flex;flex-direction:column;line-height:1.2}
  .plp-linebtn b{font-size:19px;font-weight:900}
  .plp-linebtn small{font-size:11.5px;font-weight:800;color:#eafff2}

  /* ---------- sections common ---------- */
  .plp-sec{padding:32px 0}
  .plp-sec--cream{background:var(--paper)}
  .plp-sec--sand{background:#f4efe6}
  .plp-h{text-align:center;margin-bottom:18px}
  .plp-h--left{text-align:left}
  .plp-h h2{margin:0;font-size:clamp(24px,2.8vw,34px);font-weight:900;line-height:1.3;letter-spacing:.01em;padding-bottom:12px;position:relative;display:inline-block}
