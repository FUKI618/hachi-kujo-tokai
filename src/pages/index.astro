---
/**
 * /pro/ — 蜂の巣駆除ファクトリー東海｜緊急・電話ファースト集客LP
 * ヒーロー(モバイル): 承認チラシを実HTML/CSSで99%再現（2:3固定キャンバス・%絶対配置・cqwフォント）。実写真は hero-mob-photo（Gemini生成・人物の顔なし）。
 *   見出し/価格/電話は実テキスト（QS/SEO/AEO）。電話＝実 tel: リンク（data-cta で CV 自動発火）。PC(≥900px)は承認画像 hero-pc-chirashi を継続使用。
 * 下半分: 実HTML（実データSSOT）でSEO/AEO対策。配色はヒーロー基調（赤#a60101 / 橙CTA / クリーム#fdfcf6）。
 *   画像は実写真（cases / bee-types / generated）のみ。FAQは FAQPage 構造化データを併設。
 */
import Layout from "../layouts/Layout.astro";
import { assetPath } from "../lib/site";
import { company } from "../data/company";
import { rates } from "../data/rates";
import { strengths } from "../data/strengths";
import { promiseCards } from "../data/scam-warning";
import { beeTypes } from "../data/bee-types";
import { cases } from "../data/cases";
import { voices } from "../data/voices";
import { compareRows } from "../data/compare";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";
import { vsGovernmentRows, subsidyNote } from "../data/vs-government";
import { faqs } from "../data/faq";
import CtaDual from "../components/CtaDual.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";

// LPに載せるコラムカード（記事は content collection から自動取得・優先順で6本）
const COLUMN_ORDER = [
  "hachi-kujo-ryokin-soba",
  "suzumebachi-tokushu",
  "hachi-su-jibun-de-kujo",
  "hachi-kujo-shiyakusho-muryo",
  "gyosha-irai-handan",
  "hachi-shurui-miwakekata",
];
const _columnAll = await getCollection("column");
const columnPosts = COLUMN_ORDER.map((id) => _columnAll.find((p) => p.id === id)).filter(Boolean);

const title = `名古屋・愛知の蜂の巣駆除なら最短30分｜基本1,680円〜・1年保証｜${company.name}`;
const description = `蜂の巣駆除を名古屋・愛知＋岐阜・三重の近郊エリアで最短30分。事前見積金額からの追加請求なしのハチ駆除専門【${company.name}】。スズメバチ¥2,680〜・アシナガバチ¥1,680〜。24時間365日受付・見積り無料・キャンセル料0円・1年再発保証。`;

const beeShown = beeTypes.slice(0, 6);
const casesShown = cases.slice(0, 4);

// 危険度を全レベルで統一表記＋色に正規化（data の dangerLevel: high/highest/medium/low に対応）
const dangerMap: Record<string, { label: string; cls: string }> = {
  highest: { label: "攻撃性 最大", cls: "max" },
  high: { label: "攻撃性 大", cls: "high" },
  medium: { label: "攻撃性 中", cls: "mid" },
  low: { label: "攻撃性 小", cls: "low" },
};
// 料金行に添える蜂サムネ（rate.beeType 名 → bee-types 画像）
const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi",
  "スズメバチ": "suzumebachi",
  "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi",
  "クマバチ・その他": "kumabachi",
};
const strengthsShown = strengths.slice(0, 6);
// FAQPage 構造化データは Layout（faqsToJsonLd）が注入するため、ここでは重複させない。
---

<Layout title={title} description={description}>
  <h1 class="x-sr">名古屋・愛知の蜂の巣駆除｜即日スピード解決・最短30分で現場到着・基本1,680円〜（税込）・1年保証・追加0円の明朗会計・当日対応98%・24時間365日受付 {company.phoneDisplay}</h1>

  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 L9.5 18 L20 6"/></symbol>
  </svg>

  <!-- HERO＋本文を1枚のカードに（PCで中央に浮かせる／モバイルは無スタイル＝不変） -->
  <main class="lp-card">
  <!-- ===== HERO（焼込みチラシを実HTMLで99%再現／2:3固定キャンバス・%絶対配置） ===== -->
  <div class="xhero">
    <!-- L8 実写真（原画から切出し・背面） -->
    <img class="xh-photo" src={assetPath("images/generated/hero-mob-photo.webp")} width="1024" height="418"
      alt="防護手袋のプロが専用工具で軒下のスズメバチの巣を取り除く様子" loading="eager" decoding="async" fetchpriority="high" />

    <!-- L1 上部赤バー -->
    <div class="xh-bar" aria-hidden="true">24時間365日受付・<b>最短30分</b>で出動</div>

    <!-- L2 ブランド帯 -->
    <div class="xh-brand">
      <img class="xh-logo" src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" aria-hidden="true" />
      <span class="xh-btext"><b class="xh-bname">{company.name}</b><small class="xh-btag">蜂の巣駆除のプロ集団</small></span>
      <a class="xh-headtel" href={company.phoneTelLink} data-cta="header_tel">
        <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="xh-headtel-tx"><b class="font-num">{company.phoneDisplay}</b><small>24時間受付中</small></span>
      </a>
    </div>

    <!-- L3 赤リボンバナー -->
    <div class="xh-banner" aria-hidden="true"><span><em>そのまま放置</em><i>すると</i><b>危険！</b></span></div>

    <!-- L4/L5 見出し -->
    <p class="xh-h1" aria-hidden="true">蜂の巣駆除</p>
    <p class="xh-h2" aria-hidden="true">即日スピード解決</p>

    <!-- L6 価格行 -->
    <p class="xh-price" aria-hidden="true">
      <span class="xhp-cell"><small>最短</small><b class="xhp-num">30</b><small>分</small></span>
      <span class="xhp-div"></span>
      <span class="xhp-cell"><small>基本</small><b class="xhp-num">¥1,680</b><small class="xhp-tilde">〜</small><i class="xhp-tax">（税込）</i></span>
    </p>

    <!-- L7 電話CTA帯 -->
    <a class="xh-cta" href={company.phoneTelLink} data-cta="hero_tel">
      <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
      <span class="xh-cta-tx">
        <small class="xh-cta-top">＼今すぐお電話で不安も駆除／</small>
        <b class="xh-cta-num font-num">{company.phoneDisplay}</b>
        <small class="xh-cta-bot">通話無料・24時間受付・タップで発信</small>
      </span>
    </a>
    <!-- 緑ドット「ただ今受付中」 -->
    <span class="xh-now" aria-hidden="true"><i class="xh-now-dot"></i>ただ今受付中</span>
    <!-- 赤「電話で10%OFF」クーポンバッジ（CTA右上・旧通話料無料シール跡に配置） -->
    <span class="xcpn" aria-hidden="true"><span class="xcpn-body"><b class="xcpn-l1">電話で</b><b class="xcpn-l2">10<i>%</i></b><b class="xcpn-l3">OFF</b></span></span>

    <!-- L9 信頼4列 -->
    <ul class="xh-trust" aria-hidden="true">
      <li>
        <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="13" r="8"/><path d="M12 13 V9 M12 13 l3 2 M9 3 h6"/></svg>
        <span><small>最短</small><b>30<em>分</em></b><small>で現場到着</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z"/><path class="xht-chk" d="M8.5 12 l2.5 2.5 L16 9"/></svg>
        <span><small>安心の</small><b>1<em>年</em></b><small>保証</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="12" r="9"/><text x="12" y="15.5" class="xht-y0">¥0</text></svg>
        <span><small>見積後</small><b>追加0<em>円</em></b><small>明朗会計</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M4 11 L12 4 L20 11 V21 H4 Z"/></svg>
        <span><small>当日対応</small><b>98<em>%</em></b><small>迅速対応</small></span>
      </li>
    </ul>
  </div>

  <!-- ===== PC専用ヒーロー（≥900pxで表示・チラシを実HTMLで再現／16:9固定キャンバス・%絶対配置） ===== -->
  <section class="xhero-pc" aria-label="蜂の巣駆除 即日スピード解決｜最短30分・基本1,680円〜">
    <div class="xpc">
      <!-- 背景：スタッフ＋空（文字なしクリーン下地・原画相当） -->
      <img class="xpc-bg" src={assetPath("images/generated/hero-pc-bg.webp")} width="1376" height="768"
        alt="蜂の巣駆除に対応する防護服のプロスタッフ2名" loading="eager" decoding="async" fetchpriority="high" />

      <!-- 上部白バー -->
      <div class="xpc-bar" aria-hidden="true">
        <span class="xpc-bar-sub">24時間365日受付・最短30分で出動</span>
        <span class="xpc-bar-brand"><img class="xpc-bar-logo" src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" />{company.name}</span>
      </div>

      <!-- リボン -->
      <div class="xpc-ribbon" aria-hidden="true"><span>【最短その日のうちに駆除完了！】</span></div>

      <!-- 見出し -->
      <p class="xpc-h1" aria-hidden="true"><span class="xpc-h1-box">蜂の巣</span><span class="xpc-h1-out">駆除</span></p>
      <p class="xpc-h2" aria-hidden="true">即日スピード解決</p>

      <!-- チェック -->
      <ul class="xpc-checks" aria-hidden="true">
        <li><svg viewBox="0 0 24 24" class="xpc-chk"><path d="M4 12.5 L9.5 18 L20 6"/></svg>安心できる毎日を取り戻します！</li>
        <li><svg viewBox="0 0 24 24" class="xpc-chk"><path d="M4 12.5 L9.5 18 L20 6"/></svg>プロがスピード対応！</li>
      </ul>

      <!-- 最短30分 -->
      <div class="xpc-min" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="xpc-min-ic"><circle cx="12" cy="13" r="8"/><path d="M12 13 V9 M12 13 l3 2 M9 3 h6"/></svg>
        最短<b>30分</b>で到着
      </div>

      <!-- 丸バッジ3つ -->
      <ul class="xpc-seals" aria-hidden="true">
        <li><b>即日</b><b>対応</b></li>
        <li><b>1年</b><b>保証</b></li>
        <li><small>相談・</small><small>調査・見積</small><b>無料</b></li>
      </ul>

      <!-- 価格バブル -->
      <div class="xpc-price" aria-hidden="true">
        <span class="xpc-price-1">基本<b>¥1,680〜</b><i>（税込）</i> /</span>
        <span class="xpc-price-2">見積・出張・キャンセル<b>0円</b></span>
      </div>

      <!-- 電話CTA -->
      <a class="xpc-tel" href={company.phoneTelLink} data-cta="hero_tel">
        <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="xpc-tel-tx"><b class="font-num">{company.phoneDisplay}</b><small>今すぐお電話ください</small></span>
      </a>

      <!-- LINE -->
      <a class="xpc-line" href={company.lineUrl} data-cta="hero_line" target="_blank" rel="noopener">
        <span class="xpc-line-badge">LINE</span>写真を送るだけで無料見積
      </a>
    </div>
  </section>

  <!-- ===== 下半分（実HTML / 実データ / ヒーロー基調） ===== -->
  <div class="xb">

    <!-- 放置の危険（問題提起） -->
    <section class="xb-sec xb-sec-tint" id="danger" aria-labelledby="s-danger">
      <h2 class="xb-h" id="s-danger"><span>その蜂、放置は危険です</span></h2>
      <p class="xb-lead">スズメバチは巣に近づくだけで突然襲ってくることがあり、日本では毎年<b>15〜21人</b>が蜂刺されで亡くなっています（厚労省人口動態統計）。<b>見つけても近づかず、すぐにご相談ください。</b></p>
      <div class="xdanger-grid">
        <figure class="xb-card xdanger">
          <img src={assetPath("images/danger/hornet-menace.webp")} width="1200" height="1200"
            alt="今にも襲いかかるスズメバチ（イメージ）" loading="lazy" decoding="async" />
          <figcaption class="xdanger-cap">刺激しなくても、巣に近づくだけで攻撃してくることがあります。</figcaption>
        </figure>
        <figure class="xb-card xdanger">
          <img src={assetPath("images/danger/resident-flee.webp")} width="1200" height="1200"
            alt="蜂に驚いて逃げる住人（イメージ）" loading="lazy" decoding="async" />
          <figcaption class="xdanger-cap">巣が大きくなる前の早期対応が、いちばん安全で確実です。</figcaption>
        </figure>
      </div>
      <p class="xb-note">※ 写真はイメージです。</p>
    </section>

    <!-- 緊急の資格化：今すぐ電話すべき状況（高単価・緊急客を承認し電話へ誘導） -->
    <section class="xb-sec" id="urgent" aria-labelledby="s-urgent">
      <h2 class="xb-h" id="s-urgent"><span>こんな状況は、今すぐお電話を</span></h2>
      <ul class="xtrouble">
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">蜂に刺された・刺されそうで家族が外に出られない</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">玄関・ベランダなど毎日通る場所に巣がある</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">小さな子ども・お年寄り・ペットがいて危険</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">スズメバチが家のまわりを何匹も飛んでいる</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">とにかく今日中に、この巣をなくしたい</a></li>
      </ul>
      <p class="xb-note xtrouble-cta">ひとつでも当てはまる方は、迷わず<b>お電話ください</b>。最短30分で、プロが駆けつけます。</p>
    </section>

    <!-- こんなお悩み（共感） -->
    <section class="xb-sec" id="trouble" aria-labelledby="s-trouble">
      <h2 class="xb-h" id="s-trouble"><span>こんなお悩みありませんか？</span></h2>
      <ul class="xtrouble">
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">家の周りで蜂をよく見かける</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">軒下・ベランダに巣ができている</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">屋根裏や壁の中から羽音がする</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">市販スプレーで駆除したが減らない</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">去年駆除したのに今年もまた出た</a></li>
        <li><a href={company.phoneTelLink} data-cta="trouble_tel">小さな子ども・ペットがいて不安</a></li>
      </ul>
      <p class="xb-note xtrouble-cta">ひとつでも当てはまれば、無理せず<b>プロにご相談を</b>。最短30分で駆けつけます。</p>
    </section>

    <!-- 料金 -->
    <span id="pricing" class="x-anchor" aria-hidden="true"></span>
    <section class="xb-sec" id="price" aria-labelledby="s-rate">
      <h2 class="xb-h" id="s-rate"><span>蜂の巣駆除 料金のご案内</span></h2>
      <p class="xb-lead">基本<b>1,680円〜</b>。広告代理店も中間業者も挟まない<b>自社直接対応</b>だから実現できる価格です。</p>

      <ul class="xrate-free" aria-label="無料の項目">
        <li><span class="xrate-free-l">出張費</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">見積り</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">キャンセル</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">追加請求</span><span class="xrate-free-z">0<small>円</small></span></li>
      </ul>

      <div class="xrate-card">
        {rates.map((r, i) => (
          <a class="xrate-row" href={company.phoneTelLink} data-cta="rate_row_tel" aria-label={`${r.beeType}の駆除を電話で相談する`}>
            <img class="xrate-thumb" src={assetPath(`images/bee-types/${rateImg[r.beeType] ?? "dorobachi"}.webp`)}
              width="74" height="48" alt={`${r.beeType}の蜂の巣駆除`} loading="lazy" decoding="async" />
            <div class="xrate-info">
              <b class="xrate-name">{r.beeType}</b>
              <span class="xrate-cond">{r.workCondition}</span>
            </div>
            <div class="xrate-price"><b>{r.basicPrice}</b><small>税込</small></div>
          </a>
        ))}
      </div>
      <p class="xb-note">※ 巣のサイズ・高さ・場所により変動。<b>現地で確定見積</b>をお伝えし、ご納得後に作業。事前見積金額からの追加請求はありません。</p>
      <p class="xb-coupon"><b class="xb-coupon-tag">電話割</b><span>このページをご覧の方が<b>お電話でお申込み</b>いただくと、<b class="xb-coupon-off">通常料金から10%OFF</b>。ご予約時に「ホームページを見た」とお伝えください。</span></p>
      <p class="xpay">お支払い：<b>現金・クレジットカード・PayPay・銀行振込・後払い</b> に対応</p>
    </section>

    <CtaDual id="rate_cta" lead="この料金で即日対応。今すぐご相談ください" />

    <!-- 仲介を挟まない自社直接＝適正価格・明朗会計（信頼） -->
    <section class="xb-sec xb-sec-tint" id="vs-quote" aria-labelledby="s-vsquote">
      <h2 class="xb-h" id="s-vsquote"><span>あとから増えない、<b class="xvs-off">明朗会計</b></span></h2>
      <p class="xb-lead">紹介サイトや仲介業者を通すと、<b>仲介手数料</b>が上乗せされます。当社は受付から駆除まで<b>すべて自社で完結</b>。だから余分な費用がのらない<b>適正価格</b>で、料金もわかりやすい。</p>
      <div class="xvs">
        <div class="xvs-card xvs-other">
          <span class="xvs-tag">紹介サイト・仲介経由</span>
          <p class="xvs-pt">受付会社 → 仲介手数料 → 下請け<br /><b>誰が来るか直前までわからない</b></p>
        </div>
        <div class="xvs-card xvs-ours">
          <span class="xvs-tag xvs-tag-on">当社（自社施工）</span>
          <p class="xvs-pt">受付も駆除も<b>自社のスタッフが対応</b><br /><b>仲介手数料 0円</b></p>
        </div>
      </div>
      <p class="xvs-lead2"><b>現地で確定したお見積りの範囲内で作業します。</b><br />ご納得いただいてから着手し、作業後に金額が増えることは一切ありません。</p>
      <CtaDual id="vsquote_cta" lead="料金のご相談・ご質問も、お気軽にどうぞ" />
      <p class="xb-note">※ 料金は蜂の種類・巣の大きさ・場所により変動します。現地調査のうえ確定金額をお伝えし、ご納得後に作業いたします。</p>
    </section>

    <!-- 地元の実在企業（差別化＝名古屋拠点・自社直接） -->
    <section class="xb-sec" id="local" aria-labelledby="s-local">
      <h2 class="xb-h" id="s-local"><span>名古屋の地元会社が、自社で直接うかがいます</span></h2>
