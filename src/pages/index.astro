      .xcol-card:active{transform:translateY(1px)}
      @media(hover:hover){.xcol-card:hover{transform:translateY(-4px);box-shadow:0 18px 34px -22px rgba(120,40,4,.5)}}
      .xcol-photo{position:relative;aspect-ratio:16/9;background:#efe7d6}
      .xcol-photo img{width:100%;height:100%;object-fit:cover;display:block}
      .xcol-cat{position:absolute;left:10px;top:10px;background:var(--red);color:#fff;font-size:11px;font-weight:800;padding:4px 11px;border-radius:999px;letter-spacing:.02em;box-shadow:0 2px 8px rgba(120,10,10,.3)}
      .xcol-body{display:flex;flex-direction:column;gap:7px;padding:13px 15px 15px;flex:1}
      .xcol-title{font-size:1rem;font-weight:900;line-height:1.5;margin:0;color:var(--ink)}
      .xcol-desc{font-size:.78rem;line-height:1.7;color:#6b5d4a;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .xcol-more{margin-top:auto;padding-top:4px;font-size:.82rem;font-weight:800;color:var(--red2)}
      .xcol-all{text-align:center;margin-top:24px}
      .xcol-allbtn{display:inline-block;border:2px solid var(--red);color:var(--red);font-weight:800;text-decoration:none;border-radius:999px;padding:12px 30px;font-size:.9rem;transition:background .18s,color .18s}
      @media(hover:hover){.xcol-allbtn:hover{background:var(--red);color:#fff}}
      /* モバイル〜タブレット：カードを横スクロール（カルーセル）。LPのモバイル版は内容幅が約480px固定でPC化は900px〜のため、900px未満すべてを対象にする。.xb section の左右padding=16pxに合わせて端までbleed */
      @media (max-width:899px){
        .xcol-grid{display:flex;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;
          gap:12px;margin-inline:-16px;padding:2px 16px 14px;scroll-padding-left:16px;
