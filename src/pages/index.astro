  }

  /* ---- 約束カード：黄下線 ---- */
  .promise-card {
    border-bottom: 4px solid var(--color-accent);
    box-shadow: 0 8px 18px rgba(120, 60, 0, 0.12);
  }

  /* ---- 料金表：ヘッダー黒・当社列強調 ---- */
  .price-table thead th {
