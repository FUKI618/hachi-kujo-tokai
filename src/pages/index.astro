<!-- ===== カウントアップ・FAQ展開・スクロール検知の inline JS ===== -->
<script is:inline>
  (function () {
    // カウントアップ
    function animateCount(el) {
      if (el.dataset.counted === "1") return;
      el.dataset.counted = "1";
      var target = parseFloat(el.dataset.count);
      var isFloat = String(target).indexOf(".") >= 0;
      var useComma = el.dataset.format === "comma";
      var duration = 1400;
      var start = performance.now();
      function frame(now) {
        var t = Math.min(1, (now - start) / duration);
        var eased = 1 - Math.pow(1 - t, 3);
        var v = target * eased;
        var display = isFloat ? v.toFixed(1) : Math.floor(v);
        el.textContent = useComma
          ? Number(display).toLocaleString("ja-JP")
          : display;
        if (t < 1) requestAnimationFrame(frame);
        else
          el.textContent = useComma
            ? Number(target).toLocaleString("ja-JP")
            : isFloat
              ? target.toFixed(1)
              : target;
      }
      requestAnimationFrame(frame);
    }

    // IntersectionObserver で reveal + count
    if ("IntersectionObserver" in window) {
      var revealObs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add("is-shown");
              en.target.querySelectorAll("[data-count]").forEach(animateCount);
              revealObs.unobserve(en.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.15 }
      );
      document
        .querySelectorAll(".reveal, .reveal-stagger")
        .forEach(function (el) {
          revealObs.observe(el);
        });

      // ヒーロー内の数字は初回ロード時に即実行
      setTimeout(function () {
        document
          .querySelectorAll(".hero [data-count]")
          .forEach(animateCount);
      }, 200);

      // 2.5秒後に未起動の reveal を強制表示（fallback）
      setTimeout(function () {
        document
          .querySelectorAll(".reveal:not(.is-shown), .reveal-stagger:not(.is-shown)")
          .forEach(function (el) {
            el.classList.add("is-shown");
            el.querySelectorAll("[data-count]").forEach(animateCount);
          });
      }, 2500);
    }

    // Hero 動画: HTML autoplay で即時再生。saveData/低速回線/reduce-motion 時のみ抑制
    (function () {
      var v = document.querySelector("video.hero-bg-video");
      if (!v) return;
      var conn = navigator.connection || {};
      var shouldPause =
        conn.saveData ||
        (conn.effectiveType && /^([23]g|slow-2g)$/i.test(conn.effectiveType)) ||
        matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (shouldPause) {
        v.removeAttribute("autoplay");
        v.preload = "none";
        v.removeAttribute("src");
        v.pause();
      }
    })();

    // 年号
    var yearEl = document.getElementById("copyright-year");
    if (yearEl) yearEl.textContent = new Date().getFullYear();

    // CTA計測フック
    document.querySelectorAll("[data-cta]").forEach(function (el) {
      el.addEventListener("click", function () {
        var id = el.dataset.cta;
        if (window.dataLayer) {
          window.dataLayer.push({ event: "cta_click", cta_id: id });
        }
      });
    });

    // アンカースクロール（topbar/header オフセット考慮）
    document.querySelectorAll('a[href^="#"]').forEach(function (a) {
      a.addEventListener("click", function (e) {
        var id = a.getAttribute("href");
        if (!id || id === "#" || id.length <= 1) return;
        var target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        var headerH =
          (document.querySelector(".header")
            ? document.querySelector(".header").offsetHeight
            : 0) +
          (document.querySelector(".topbar")
            ? document.querySelector(".topbar").offsetHeight
            : 0);
        var top =
          target.getBoundingClientRect().top + window.scrollY - headerH - 8;
        window.scrollTo({ top: top, behavior: "smooth" });
      });
    });
  })();
</script>

