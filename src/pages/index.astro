    .rhero { padding: 1.6rem 0 2.5rem; }
    .rhero-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "toptag  toptag"
        "title   action"
        "price   action"
        "benefits thumbs"
        "cv      cv";
      column-gap: 2rem;
      row-gap: 1rem;
      align-items: start;
    }
    .rhero-toptag { grid-area: toptag; }
    .rhero-action { grid-area: action; align-self: stretch; aspect-ratio: auto; height: 100%; min-height: 360px; }
    .rhero-title { grid-area: title; text-align: left; }
    .rhero-title-main { justify-content: flex-start; }
    .rhero-thumbs { grid-area: thumbs; }
    .rhero-price { grid-area: price; text-align: left; align-self: start; }
    .rhero-price-main { justify-content: flex-start; }
    .rhero-price-free { justify-content: flex-start; }
    .rhero-benefits { grid-area: benefits; }
    .rhero-cv {
      grid-area: cv;
      grid-template-columns: 1.7fr 1fr;
      align-items: stretch;
      gap: 1rem;
    }
    .rhero-cv-head { grid-column: 1 / -1; }
    .rhero-tel { padding: 1.05rem 1.6rem; }
    .rhero-tel-icon { width: 3.5rem; height: 3.5rem; }
    .rhero-tel-icon .icon { width: 1.85rem; height: 1.85rem; }
    .rhero-tel-cta { font-size: 1.9rem; }
    .rhero-tel-free { font-size: 0.8rem; }
    .rhero-tel-num { font-size: 1.7rem; }
    .rhero-tel-note { font-size: 0.72rem; }
    .rhero-line { font-size: 1.02rem; }
  }
</style>

<!-- ===== 反応型デザインシステム 全セクション展開（redesign/response-lp） ===== -->
<style is:global>
  /* ---- セクション見出し：黒タグeyebrow + 太字 + 黄マーカー ---- */
  .section-eyebrow {
    background: var(--color-dark);
    color: var(--color-accent);
    box-shadow: none;
    letter-spacing: 0.16em;
    font-weight: 900;
  }
  .section-title.headline {
    font-weight: 900;
    letter-spacing: 0;
  }
  .section-title .accent,
  .section-title .hl {
    color: var(--color-primary);
    background: linear-gradient(transparent 56%, rgba(255, 224, 0, 0.9) 56%, rgba(255, 224, 0, 0.9) 92%, transparent 92%);
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .section-title.headline::after {
    width: 72px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 6px;
    margin-top: 0.75rem;
  }

  /* ---- セクション背景リズム：softにハニカム微テクスチャ ---- */
  .section-soft {
    background:
      repeating-linear-gradient(60deg, rgba(245, 179, 0, 0.05) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(-60deg, rgba(245, 179, 0, 0.05) 0 1px, transparent 1px 22px),
      var(--color-soft);
  }

  /* ---- お悩みbubble：影とフチを強調 ---- */
  .bubble {
    box-shadow: 4px 4px 0 var(--color-accent), 0 8px 18px rgba(120, 60, 0, 0.1);
