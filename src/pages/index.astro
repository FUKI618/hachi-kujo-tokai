  }

  /* ---- 駆除の流れ：黒×黄STEPバッジ + 下三角 ---- */
  .flow-num {
    background: var(--color-dark);
    border-radius: 0.9rem;
    box-shadow: 0 8px 18px rgba(15, 23, 34, 0.32);
    color: #fff;
    overflow: visible;
  }
  .flow-num::before {
    content: "STEP";
    position: absolute;
    inset: auto auto 100% 50%;
    transform: translate(-50%, 40%);
    background: var(--color-accent);
