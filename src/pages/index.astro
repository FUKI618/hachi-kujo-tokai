  .plp-hexbadges{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(8px,1.7vw,16px);width:min(760px,calc(100% - 24px));margin:clamp(-40px,-4.2vw,-26px) auto 0;padding:0;position:relative;z-index:3}
