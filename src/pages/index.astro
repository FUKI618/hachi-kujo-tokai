  .xb-faq-item[open] summary::after { content:"−"; }
  .xb-faq-item p { margin:0; padding:0 .9rem .85rem; font-size:.78rem; line-height:1.7; color:#3f3526; border-top:1px solid var(--line); padding-top:.7rem; }

  /* 最終CTA（電話＋LINE） */
