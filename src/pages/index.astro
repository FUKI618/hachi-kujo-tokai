---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { assetPath } from "../lib/site";
import { company } from "../data/company";
import { rates } from "../data/rates";
import { cases } from "../data/cases";
import { areas } from "../data/areas";
import { flowSteps } from "../data/flow";
import { faqs } from "../data/faq";

const title = `名古屋・愛知の蜂の巣駆除なら最短30分｜上限つき明朗会計・追加0円・1年保証｜${company.name}`;
const description = `蜂の巣駆除を名古屋・愛知＋岐阜・三重の近郊エリアで最短30分。標準ケース上限つき（アシナガ19,800円/スズメ29,800円）で追加請求なしのハチ駆除専門【${company.name}】。受付は電話7時〜21時・LINE24時間。見積り無料・キャンセル料0円・1年再発保証。`;

const heroImage = "images/generated/hero-bright-team.webp";
const clerkImage = "images/generated/reception-clerk-photo.webp";
const mainRates = rates.slice(0, 2);
const otherRates = rates.slice(2);
const caseCards = cases.slice(0, 5);
const faqShown = faqs.slice(0, 6);

// 料金カード表示用（rates.ts SSOT の上限モデルに準拠）
const priceCards = [
  {
    rate: mainRates[0],
    img: "images/bee-types/ashinagabachi.webp",
    tone: "gold",
    items: ["軒下・ベランダ・庭木などの一般的な巣", "高さ3m程度までの作業", "巣の撤去・処分まで対応"],
  },
  {
    rate: mainRates[1],
    img: "images/bee-types/suzumebachi.webp",
    tone: "red",
    items: ["屋根裏・生垣・地中などの一般的な巣", "高さ3m程度までの作業", "巣の撤去・処分まで対応"],
  },
];

const urgentCards = [
  { img: "images/danger/hornet-menace.webp", title: "蜂が家の周りを\n飛び回っている", note: "攻撃性が高まり危険です" },
  { img: "images/generated/emergency-nest-eaves.webp", title: "軒下・ベランダ・庭木に\n巣を見つけた", note: "放置すると大きくなり危険" },
  { img: "images/danger/resident-flee.webp", title: "子どもや高齢者が\n近くにいる", note: "刺されるリスクが高まります" },
];

const zeroCards = [
  { icon: "ic-truck", label: "出張費", note: "名古屋市中区から\n最短30分で駆けつけ" },
  { icon: "ic-doc", label: "お見積り", note: "現地での見積りは\nもちろん無料" },
  { icon: "ic-cancel", label: "キャンセル", note: "見積り後のキャンセルも\n費用は一切かかりません" },
];

const growthSteps = [
  { img: "images/generated/nest-growth-1.webp", w: 476, h: 590, scale: 50, term: "初期（5〜6月）", note: "女王バチが巣作りを開始" },
  { img: "images/generated/nest-growth-2.webp", w: 620, h: 650, scale: 76, term: "中期（7〜8月）", note: "働き蜂が増え急成長" },
  { img: "images/generated/nest-growth-3.webp", w: 664, h: 680, scale: 100, term: "後期（9〜10月）", note: "攻撃性が高まり危険！" },
];


// 比較表: compare.ts / vs-government.ts の記載内容に準拠（断定は当社列のみ・他社系はぼかし表現を維持）
const compareTable = {
  heads: ["市役所・公的機関", "大手仲介サイト", "他社業者", company.name],
  rows: [
    { label: "対応スピード", cells: ["相談のみ・数日〜", "受付後に手配・翌日以降", "業者により異なる", "最短30分"] },
    { label: "出張費・見積り", cells: ["駆除は対象外が多い", "有料の場合あり", "業者により異なる", "無料"] },
    { label: "料金のわかりやすさ", cells: ["—", "仲介手数料で不透明", "追加費用の可能性", "明朗会計・追加0円"] },
    { label: "対応の専門性", cells: ["紹介先による", "加盟店により差", "業者により差", "蜂駆除の専門スタッフが対応"] },
    { label: "保証", cells: ["原則なし", "業者により異なる", "業者により異なる", "1年保証"] },
    { label: "アフターフォロー", cells: ["—", "業者により異なる", "基本的になし", "再発時も相談OK"] },
  ],
};

const aichiCities = areas[0].cities;
const nagoyaWards = aichiCities.filter((c) => c.startsWith("名古屋市"));
const aichiOthers = aichiCities.filter((c) => !c.startsWith("名古屋市")).slice(0, 14);
const gifuCities = areas[1]?.cities.slice(0, 8) ?? [];
const mieCities = areas[2]?.cities.slice(0, 6) ?? [];
---

<Layout
  title={title}
  description={description}
  lcpMobileImage={heroImage}
  lcpDesktopImage={heroImage}
>
  <h1 class="sr-only">名古屋・愛知の蜂の巣駆除なら最短30分。上限つき明朗会計・追加0円・1年保証の{company.name}</h1>

  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="ic-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3l2 5-2.4 1.8c1.2 2.4 3 4.2 5.6 5.6L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 4 14.7 4 7c0-1.1.9-2 1-3Z"/></symbol>
    <symbol id="ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6"/></symbol>
    <symbol id="ic-line" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.1 8.1 7.8.3.1.7.2.8.5.1.3.1.6 0 .9l-.1.8c0 .3.2.5.5.4 3.2-1.4 5.9-3.2 7.8-5.4 1.8-1.7 2.9-3.5 2.9-5C22 6.6 17.5 3 12 3Z"/></symbol>
    <symbol id="ic-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2.5"/></symbol>
    <symbol id="ic-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 5.8v5.4c0 4.4 3 8.1 7 9.8 4-1.7 7-5.4 7-9.8V5.8L12 3Z"/><path d="m8.8 12 2.3 2.4L15.4 10"/></symbol>
    <symbol id="ic-yen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 4l5 7 5-7M12 11v9M8 13.5h8M8 17h8"/></symbol>
    <symbol id="ic-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="16.5" cy="17.5" r="1.7"/></symbol>
    <symbol id="ic-doc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/></symbol>
    <symbol id="ic-cancel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 8.5 7 7M15.5 8.5l-7 7"/></symbol>
    <symbol id="ic-thumb" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v9H4v-9zM7 11l4-7c1.3 0 2.2 1 2.2 2.2L12.6 10H19c1 0 1.8.9 1.6 1.9l-1.2 6.4c-.2 1-1 1.7-2 1.7H7"/></symbol>
    <symbol id="ic-warn" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 1.5 21h21L12 2Zm1 14.5h-2V18h2v-1.5Zm0-7h-2V15h2V9.5Z"/></symbol>
    <symbol id="ic-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
  </svg>

  <main class="plp">
    <!-- ============ ヘッダー ============ -->
    <header class="plp-head">
      <div class="plp-head__in">
        <a class="plp-brand" href={assetPath("")} aria-label={company.name}>
          <img src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" aria-hidden="true" />
          <span><b>蜂の巣駆除<br class="plp-brand__br" />ファクトリー東海</b><small>名古屋・愛知の蜂の巣駆除専門</small></span>
        </a>
        <div class="plp-head__mid">
          <p class="plp-head__area">名古屋市中区拠点！愛知・岐阜南部・三重北部 対応</p>
          <p class="plp-head__tel"><svg><use href="#ic-phone" /></svg>お電話1本で最短30分で駆けつけ！<span>受付 {company.phoneHours} 年中無休</span></p>
        </div>
        <nav class="plp-head__cta" aria-label="お問い合わせ">
          <a class="plp-hbtn plp-hbtn--tel" href={company.phoneTelLink} data-cta="header_tel">
            <svg><use href="#ic-phone" /></svg>
            <span class="plp-hbtn__pc">今すぐ電話する</span>
            <span class="plp-hbtn__sp"><b>{company.phoneDisplay}</b><small>受付 {company.phoneHours} 年中無休</small></span>
          </a>
          <a class="plp-hbtn plp-hbtn--line" href={company.lineUrl} data-cta="header_line" target="_blank" rel="noopener">
            <svg><use href="#ic-line" /></svg><span class="plp-hbtn__pc">LINEで写真相談<small>写真を送るだけ</small></span>
          </a>
        </nav>
      </div>
    </header>

    <!-- ============ ヒーロー ============ -->
    <section class="plp-hero" aria-labelledby="hero-title">
      <p class="plp-locbar"><svg><use href="#ic-pin" /></svg><span>名古屋市中区の拠点から<b>最短30分</b>でお伺い</span><span class="plp-locbar__area">愛知・岐阜南部・三重北部 対応</span></p>
      <div class="plp-hero__media">
        <img src={assetPath(heroImage)} width="1376" height="768" alt="名古屋・愛知の蜂の巣駆除に対応する専門スタッフ" loading="eager" decoding="async" fetchpriority="high" />
        <div class="plp-hero__scrim" aria-hidden="true"></div>
        <div class="plp-hero__overlay">
          <p class="plp-kicker">名古屋・愛知の蜂の巣駆除専門</p>
          <h2 id="hero-title">蜂の巣を見つけたら、<br /><em>すぐお電話</em>を！</h2>
          <ul class="plp-hero__checks">
            <li><svg><use href="#ic-check" /></svg>作業前に総額を確定・追加請求なし</li>
            <li><svg><use href="#ic-check" /></svg>お断りOK・相談だけでも大丈夫です</li>
          </ul>
        </div>
      </div>
      <ul class="plp-hexbadges" aria-label="選ばれる理由">
        <li><span class="plp-hex plp-hex--red"><svg><use href="#ic-clock" /></svg><b>30分</b><small>最短で到着</small></span></li>
        <li><span class="plp-hex plp-hex--red"><svg><use href="#ic-yen" /></svg><b>0円</b><small>追加料金なし</small></span></li>
        <li><span class="plp-hex"><svg><use href="#ic-shield" /></svg><b>1年</b><small>安心の保証</small></span></li>
        <li><span class="plp-hex"><svg><use href="#ic-thumb" /></svg><b>OK</b><small>相談だけでも</small></span></li>
      </ul>
      <div class="plp-hero__ctawrap">
        <p class="plp-cta-lead">受付スタッフが丁寧に対応します</p>
        <div class="plp-callrow">
          <figure class="plp-clerk">
            <img src={assetPath(clerkImage)} width="958" height="724" alt="" aria-hidden="true" loading="eager" decoding="async" />
          </figure>
          <a class="plp-call" href={company.phoneTelLink} data-cta="hero_tel">
            <span><small>今すぐお電話ください！</small><b>{company.phoneDisplay}</b><em>受付 {company.phoneHours} 年中無休・通話無料</em></span>
          </a>
        </div>
        <a class="plp-linebtn" href={company.lineUrl} data-cta="hero_line" target="_blank" rel="noopener">
          <span class="plp-linebtn__badge"><svg><use href="#ic-line" /></svg>LINE</span>
          <span><b>LINEで写真相談</b><small>写真を送るだけ・24時間受付</small></span>
        </a>
      </div>
    </section>

    <!-- ============ 緊急度チェック ============ -->
    <section class="plp-sec" aria-labelledby="urgent-title">
      <div class="plp-in">
        <div class="plp-h">
          <h2 id="urgent-title">こんな時はすぐにお電話ください</h2>
          <p>すぐに駆除が必要な危険な状況です</p>
        </div>
        <div class="plp-urgent">
          {urgentCards.map((c) => (
            <article class="plp-urgent__card">
              <img src={assetPath(c.img)} width="480" height="300" alt="" loading="lazy" decoding="async" />
              <div>
                <span class="plp-urgent__mark"><svg><use href="#ic-warn" /></svg></span>
                <h3>{c.title.split("\n").map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3>
                <p>{c.note}</p>
              </div>
            </article>
          ))}
        </div>
        <a class="plp-secbtn" href={company.phoneTelLink} data-cta="urgent_tel"><svg><use href="#ic-phone" /></svg>電話で状況を伝える（相談だけでもOK）</a>
      </div>
    </section>

    <!-- ============ 0円対応 ============ -->
    <section class="plp-sec plp-sec--cream" aria-labelledby="zero-title">
      <div class="plp-in">
        <div class="plp-h">
          <h2 id="zero-title">安心の<em>0円</em>対応</h2>
          <p>ご納得いただいてから作業します</p>
        </div>
        <div class="plp-zero">
          {zeroCards.map((c) => (
            <article>
              <svg class="plp-zero__ic"><use href={`#${c.icon}`} /></svg>
              <b>{c.label}</b>
              <em>0円</em>
              <p>{c.note.split("\n").map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
            </article>
          ))}
          <article>
            <svg class="plp-zero__ic"><use href="#ic-thumb" /></svg>
            <b>断ってもOK</b>
            <em class="plp-zero__ok">追加費用なし</em>
            <p>他社と比較してから<br />ご検討いただけます</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ 料金 ============ -->
    <section class="plp-sec" id="price" aria-labelledby="price-title">
      <div class="plp-in">
        <div class="plp-h">
          <h2 id="price-title">標準ケース上限価格<span class="plp-h__sub">（追加費用なし）</span></h2>
          <p>作業前に総額を確定し、確定見積の範囲内で追加請求なく作業します</p>
        </div>
        <div class="plp-price">
          {priceCards.map((card) => (
            <article class={`plp-pcard plp-pcard--${card.tone}`}>
              <header>{card.rate.beeType}の巣</header>
              <div class="plp-pcard__body">
                <img src={assetPath(card.img)} width="320" height="200" alt={card.rate.beeType} loading="lazy" decoding="async" />
                <p><small>標準ケース上限</small><b>{card.rate.basicPrice.replace("上限", "")}</b><span>（税込）</span></p>
              </div>
              <ul>
                {card.items.map((item) => <li><svg><use href="#ic-check" /></svg>{item}</li>)}
              </ul>
              <footer>安心の1年保証つき</footer>
            </article>
          ))}
        </div>
        <p class="plp-price__note">※蜂の大きさ・場所・状況によって上記金額以内で作業します。特殊な高所作業や大規模な巣は事前にご案内します。</p>
        <div class="plp-ptable">
          <table>
            <thead><tr><th>その他の蜂</th><th>料金</th><th>作業条件</th></tr></thead>
            <tbody>
              {otherRates.map((rate) => (
                <tr><th>{rate.beeType}</th><td>{rate.rangePrice}</td><td>{rate.workCondition}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ 地域対応 + 運営 ============ -->
    <section class="plp-sec plp-sec--cream" aria-labelledby="local-title">
      <div class="plp-in plp-local">
        <div class="plp-local__panel">
          <h2 id="local-title">名古屋・愛知の<br />蜂の巣駆除に対応</h2>
          <ul>
            <li><svg><use href="#ic-check" /></svg>経験豊富な専門スタッフが対応</li>
            <li><svg><use href="#ic-check" /></svg>名古屋市中区の拠点から出動</li>
            <li><svg><use href="#ic-check" /></svg>受付から保証まで一貫サポート</li>
            <li><svg><use href="#ic-check" /></svg>お断りOK・相談だけでも歓迎</li>
          </ul>
          <p class="plp-local__addr">運営：{company.legalName}（{company.name}）<br />〒{company.address.postal} {company.address.region}{company.address.city}{company.address.street}</p>
        </div>
        <div class="plp-local__photos">
          <figure>
            <img class="plp-local__img" src={assetPath("images/generated/service-inspect.webp")} width="1408" height="768" alt="現地調査で蜂の巣を確認するスタッフ" style="object-position:64% 32%" loading="lazy" decoding="async" />
            <figcaption><b>無料の現地調査・見積り</b><span>作業前に総額をご提示</span></figcaption>
          </figure>
          <figure>
            <img class="plp-local__img" src={assetPath("images/staff/takimoto.webp")} width="640" height="640" alt="防護装備を着用した駆除スタッフ" loading="lazy" decoding="async" />
            <figcaption><b>防護装備で安全に駆除</b><span>危険な蜂も確実に対応</span></figcaption>
          </figure>
          <figure>
            <img class="plp-local__img" src={assetPath("images/generated/service-remove.webp")} width="1408" height="768" alt="撤去した蜂の巣を処分するスタッフ" style="object-position:44% 44%" loading="lazy" decoding="async" />
            <figcaption><b>巣の撤去・処分・清掃</b><span>再発防止までしっかり</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ 施工事例 ============ -->
    <section class="plp-sec" aria-labelledby="case-title">
      <div class="plp-in">
        <div class="plp-h plp-h--row">
          <div>
            <h2 id="case-title">施工事例</h2>
            <p>すべて専門スタッフが対応。写真は実際の対応現場です</p>
          </div>
          <a class="plp-mini" href={company.phoneTelLink} data-cta="cases_tel"><svg><use href="#ic-phone" /></svg>同じ状況を電話で相談</a>
        </div>
        <div class="plp-cases">
          {caseCards.map((c) => (
            <article class="plp-case">
              <div class="plp-case__imgwrap">
                <span>{c.beeType}</span>
                <img src={assetPath(`images/cases/${c.imageBase}.webp`)} width="320" height="220" alt={c.title} loading="lazy" decoding="async" />
              </div>
              <div class="plp-case__body">
                <h3>{c.title}</h3>
                <p>{c.location}</p>
                <ul>{c.priceBreakdown.slice(1, 4).map((tag) => <li>{tag}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 放置リスク ============ -->
    <section class="plp-sec plp-sec--sand" aria-labelledby="danger-title">
      <div class="plp-in plp-danger">
        <div class="plp-danger__left">
          <h2 id="danger-title">蜂の巣を放置するのは<br />とても危険です</h2>
          <ul>
            <li><svg><use href="#ic-check" /></svg>刺されるリスクが高まる</li>
            <li><svg><use href="#ic-check" /></svg>巣はどんどん大きくなる</li>
            <li><svg><use href="#ic-check" /></svg>蜂の数が増えて被害拡大</li>
            <li><svg><use href="#ic-check" /></svg>お子様やペットにも危険</li>
          </ul>
        </div>
        <div class="plp-growth" aria-label="巣の成長イメージ（スズメバチの例）">
          <h3>巣の成長イメージ<span>（スズメバチの例）</span></h3>
          <div class="plp-growth__steps">
            {growthSteps.map((s, i) => (
              <>
                {i > 0 && <span class="plp-growth__arrow" aria-hidden="true">▶</span>}
                <figure>
                  <span class="plp-growth__nest"><img src={assetPath(s.img)} width={s.w} height={s.h} alt={`${s.term}の蜂の巣`} style={`height:${s.scale}%`} loading="lazy" decoding="async" /></span>
                  <figcaption><b>{s.term}</b><span>{s.note}</span></figcaption>
                </figure>
              </>
            ))}
          </div>
        </div>
        <aside class="plp-notouch">
