    }
    .hero-zero-eyebrow {
      font-size: 0.75rem;
      padding: 0.3rem 0.875rem;
    }
    .hero-zero-title { font-size: 1.3125rem; }
    .hero-zero-grid { gap: 0.625rem; }
    .hero-zero-chip {
      padding: 0.875rem 0.25rem 0.875rem;
      border-radius: 14px;
    }
    .hero-zero-amount { font-size: 2.125rem; }
    .hero-zero-label { font-size: 0.8125rem; }
  }

  /* ============================================ */
  /* === 保証メダル (medal風 品質印) === */
  /* ============================================ */
  .hero-medal {
    position: relative;
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
    border-radius: 16px;
    padding: 1.5rem 1.25rem 1.25rem;
    box-shadow:
      0 24px 48px -8px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: visible;
  }
  /* リボン: 上部「GUARANTEE」 */
  .hero-medal-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, #c81e1e 0%, #9a1414 100%);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    padding: 0.45rem 1.5rem;
    border-radius: 4px;
    white-space: nowrap;
    box-shadow:
      0 4px 12px rgba(200, 30, 30, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .hero-medal-ribbon::before,
  .hero-medal-ribbon::after {
    content: "";
    position: absolute;
    bottom: -6px;
    width: 0;
    height: 0;
    border-style: solid;
  }
  .hero-medal-ribbon::before {
    left: 0;
    border-width: 6px 0 0 6px;
    border-color: #6f0e0e transparent transparent transparent;
  }
  .hero-medal-ribbon::after {
    right: 0;
    border-width: 6px 6px 0 0;
    border-color: #6f0e0e transparent transparent transparent;
  }
  .hero-medal-body {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .hero-medal-circle {
    width: 80px;
    height: 80px;
    filter: drop-shadow(0 6px 12px rgba(160, 123, 42, 0.55));
  }
  .hero-medal-circle svg { width: 100%; height: 100%; }
  .hero-medal-text { min-width: 0; }
  .hero-medal-eyebrow {
    font-size: 0.6875rem;
    color: #6b7280;
    margin: 0 0 0.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero-medal-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: #0f1722;
    margin: 0 0 0.5rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    font-family: "Noto Sans JP", system-ui, sans-serif;
  }
  .hero-medal-title .hl-num {
    color: #c81e1e;
    font-family: var(--font-num);
    font-size: 1.25em;
    font-weight: 900;
    margin: 0 0.05em;
  }
  .hero-medal-note {
    font-size: 0.7rem;
    color: #4a5568;
    line-height: 1.55;
    margin: 0;
  }
  .hero-medal-note strong {
    color: #c81e1e;
    font-weight: 800;
  }

  /* ============================================ */
  /* === 3つの「¥0」チップ === */
  /* ============================================ */
  .hero-zero-card {
    background: linear-gradient(180deg, #fff 0%, #fdfaf6 100%);
    border-radius: 16px;
    padding: 1.25rem 1.25rem 1.375rem;
    box-shadow:
      0 24px 48px -8px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(245, 179, 0, 0.18);
    position: relative;
  }
  .hero-zero-head {
    text-align: center;
    margin-bottom: 0.875rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(200, 30, 30, 0.25);
  }
  .hero-zero-eyebrow {
    display: inline-block;
    background: linear-gradient(180deg, var(--color-accent) 0%, #d49600 100%);
    color: #1a1305;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    box-shadow: 0 2px 6px rgba(245, 179, 0, 0.45);
  }
  .hero-zero-title {
    font-size: 1.0625rem;
    font-weight: 900;
    color: #0f1722;
    margin: 0;
    line-height: 1.3;
  }
  .hero-zero-title .hl {
    color: #c81e1e;
    background: linear-gradient(transparent 60%, rgba(245, 179, 0, 0.4) 60%);
    padding: 0 0.15em;
  }
  .hero-zero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.5rem;
  }
  .hero-zero-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.625rem 0.25rem 0.625rem;
    background: linear-gradient(180deg, #fff 0%, #fef2f2 100%);
    border: 2px solid #c81e1e;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 4px 12px rgba(200, 30, 30, 0.15);
  }
  .hero-zero-amount {
    font-family: var(--font-num);
    font-size: 1.65rem;
    font-weight: 900;
    color: #c81e1e;
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 0 rgba(255,255,255,0.8);
  }
  .hero-zero-label {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #4a5568;
    letter-spacing: 0.02em;
  }

  /* ==================================================== */
  /* === LINE 4ステップガイド (Contact section) === */
  /* ==================================================== */
  .contact-line-guide {
    background: #fff;
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    border: 2px solid #06c755;
  }
  .contact-line-guide > h3.headline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    margin: 0 0 1.25rem;
    color: #0f1722;
  }
  .contact-line-guide > h3.headline .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .line-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .line-step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.875rem;
    align-items: start;
    padding: 0.625rem 0;
    border-bottom: 1px dashed rgba(6, 199, 85, 0.25);
  }
  .line-step:last-child {
    border-bottom: 0;
  }
  .line-step-num {
    width: 32px;
    height: 32px;
    background: #06c755;
    color: #fff;
    border-radius: 50%;
    font-weight: 900;
    font-size: 1.05rem;
    font-family: var(--font-num);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .line-step-body strong {
    display: block;
    font-size: 1rem;
    color: #0f1722;
    margin-bottom: 0.2rem;
    font-weight: 800;
  }
  .line-step-body p {
    margin: 0;
    font-size: 0.85rem;
    color: #5a6470;
    line-height: 1.65;
  }

  /* テキスト切れ防止: 共通 fix */
  .bee-card-title,
  .case-card-title,
  .voice-card-name,
  .flow-step-title,
  .area-block h3,
  .strength-title,
  .scam-card-title,
  .diy-col-title,
  .promise-title {
    word-break: keep-all;
    overflow-wrap: anywhere;
    line-height: 1.35;
  }
  .strength-title { font-size: clamp(1rem, 1.6vw, 1.25rem); }

  /* PC 動画露出: object-position 調整 */
  @media (min-width: 880px) {
    .hero-bg-video {
      object-position: right 25% center !important;
    }
  }

  /* =================================================== */
  /* === 芸術家レベル: 統一 design tokens & 装飾強化 === */
  /* =================================================== */

  /* Section eyebrow: アクセントライン + グラデ風 */
  .section-eyebrow {
    background: linear-gradient(
      135deg,
      rgba(245, 179, 0, 0.18),
      rgba(200, 30, 30, 0.08)
    );
    color: var(--color-primary);
    letter-spacing: 0.18em;
    position: relative;
    padding: 0.375rem 1rem;
    border-radius: 999px;
    font-weight: 900;
    font-size: 0.6875rem;
    box-shadow: inset 0 0 0 1px rgba(245, 179, 0, 0.25);
  }

  /* Section title 装飾 - 下に小さなアクセントライン */
  .section-title.headline {
    position: relative;
    padding-bottom: 0.5rem;
  }
  .section-title.headline::after {
    content: "";
    display: block;
    width: 48px;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary) 0%,
      var(--color-accent) 100%
    );
    border-radius: 3px;
    margin: 0.625rem auto 0;
  }

  /* Bee-types card: softer shadow + hover lift */
  .bee-card {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.025);
    border-radius: 14px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    overflow: hidden;
  }
  .bee-card:active {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.08);
  }

  /* Case card / Voice card 共通 softer */
  .case-card,
  .voice-card {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    border-radius: 14px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Mobile 特化: セクション間 余白の呼吸 + 装飾 */
  @media (max-width: 560px) {
    .section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .section-eyebrow {
      font-size: 0.625rem;
      padding: 0.3rem 0.875rem;
      letter-spacing: 0.16em;
    }
    .section-title.headline {
      font-size: clamp(1.5rem, 6vw, 1.875rem);
    }
    .section-title.headline::after {
      width: 40px;
      height: 2.5px;
    }
    .section-lead {
      font-size: 0.9375rem;
      line-height: 1.75;
      letter-spacing: 0.01em;
    }
  }

  /* =========================================================== */
  /* === PC 大画面 リフォーム (プロデザイナーレベル余白活用)   === */
  /* =========================================================== */

  /* PC ≥1024px : container 拡大、padding 充実 */
  @media (min-width: 1024px) {
    .container { max-width: 1320px; padding: 0 2rem; }
    .container-narrow { max-width: 1080px; padding: 0 2rem; }
    .section { padding: 5rem 0; }

    /* Section heading 大型化 */
    .section-eyebrow {
      font-size: 0.8125rem;
      padding: 0.45rem 1.25rem;
      letter-spacing: 0.2em;
    }
    .section-title.headline {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      margin-bottom: 1rem;
      line-height: 1.25;
    }
    .section-title.headline::after {
      width: 60px;
      height: 4px;
      margin-top: 0.875rem;
    }
    .section-lead {
      font-size: 1.0625rem;
      line-height: 1.9;
      max-width: 760px;
      margin: 0 auto 3rem;
    }

    /* Strengths 3カード PC */
    .strengths {
      gap: 2rem;
    }
    .strength-card {
      padding: 3.5rem 2rem 2.5rem;
    }
    .strength-title {
      font-size: 1.375rem;
      margin: 1rem 0;
    }
    .strength-desc {
      font-size: 1rem;
      line-height: 1.85;
    }
    .strength-icon { width: 5.5rem; height: 5.5rem; }
    .strength-icon .icon { width: 2.75rem; height: 2.75rem; }
    .strength-num { font-size: 1.375rem; width: 3rem; height: 3rem; }

    /* Bee-types カード */
    .bee-card-body { padding: 1.5rem 1.5rem 1.75rem; }
    .bee-card-title { font-size: 1.25rem; margin-bottom: 0.625rem; }
    .bee-card-desc { font-size: 0.9375rem; line-height: 1.85; }

    /* Bee compare table */
    .bee-compare table { font-size: 0.9375rem; }
    .bee-compare th, .bee-compare td {
      padding: 1.125rem 1rem;
    }

    /* Pricing table */
    .rate-table { font-size: 1rem; }
    .rate-table th { padding: 1.25rem 1.5rem; font-size: 0.9375rem; }
    .rate-table td { padding: 1.375rem 1.5rem; font-size: 0.9375rem; }
    .rate-hook { padding: 2rem 2.5rem; }
    .rate-hook .hook-num { font-size: 3rem; }

    /* Promises - 料金にまつわる3つの約束 */
    .promise-card {
      padding: 2rem 1.75rem;
    }
    .promise-title { font-size: 1.125rem; margin: 0.625rem 0 0.75rem; }
    .promise-desc { font-size: 0.9375rem; line-height: 1.9; }

    /* Compare table */
    .compare-table { font-size: 0.9375rem; }
    .compare-table thead th { padding: 2.5rem 1rem 1.375rem; font-size: 0.875rem; }
    .compare-table thead th.is-us { font-size: 1.0625rem; }
    .compare-table tbody th, .compare-table tbody td {
      padding: 1.25rem 1.125rem;
    }
    .compare-cell { font-size: 0.9375rem; }
    .compare-cell .icon { width: 1.375rem; height: 1.375rem; }

    /* Cases */
    .case-grid { gap: 1.75rem; }
    .case-card { padding-bottom: 1.5rem; }
    .case-card-body { padding: 1.25rem 1.5rem 1.5rem; }
    .case-card-title { font-size: 1.125rem; line-height: 1.55; }
    .case-card-price { font-size: 1.375rem; }
    .case-card-meta { font-size: 0.8125rem; }

    /* Voices */
    .voices { gap: 1.75rem; }
    .voice-card { padding: 1.75rem 1.5rem; }
    .voice-card-name { font-size: 1rem; }
    .voice-card-body { font-size: 0.9375rem; line-height: 1.85; }

    /* Flow */
    .flow { gap: 1.5rem; }
    .flow-num { width: 4.5rem; height: 4.5rem; font-size: 1.75rem; }
    .flow-step-title { font-size: 1rem; }
    .flow-step-desc { font-size: 0.8125rem; line-height: 1.7; }

    /* Areas */
    .area-grid { gap: 1.75rem; }
    .area-block { padding: 1.75rem 1.5rem; }
    .area-block h3 { font-size: 1.125rem; margin-bottom: 0.875rem; }
    .area-block ul { font-size: 0.9375rem; }

    /* FAQ */
    .faq-list { gap: 0.875rem; }
    .faq-q { padding: 1.5rem 3.5rem 1.5rem 4rem; }
    .faq-q-mark { font-size: 1.375rem; left: 1.5rem; }
    .faq-q-text { font-size: 1.0625rem; }
    .faq-a-inner { padding: 0 4rem 1.5rem; }
    .faq-a-mark { font-size: 1.375rem; }
    .faq-a p { font-size: 0.9375rem; line-height: 1.95; }

    /* Contact grid: 左右の高さを揃え、左カードの中身を縦中央配置 */
    .contact-grid {
      align-items: stretch;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 3rem;
    }
    .contact-call {
      align-self: stretch;
      padding: 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .contact-call h3 { font-size: 1.625rem; margin-bottom: 1rem; }
    .contact-call h3 .icon { width: 1.75rem; height: 1.75rem; }
    .contact-tel-big { font-size: 3rem; margin-bottom: 0.5rem; }
    .contact-tel-note { font-size: 1rem; margin-bottom: 1.5rem; }
    .contact-perks { gap: 0.875rem; margin: 1.5rem 0 0; }
    .contact-perks li { font-size: 1.0625rem; gap: 0.75rem; padding: 0.125rem 0; }
    .contact-perks .icon { width: 1.375rem; height: 1.375rem; }

    /* LINE 4 ステップガイド: 左カードと同じ視覚密度 */
    .contact-line-guide { padding: 2.5rem 2.25rem; }
    .contact-line-guide > h3.headline { font-size: 1.625rem; margin-bottom: 1.75rem; }
    .contact-line-guide > h3.headline .icon { width: 1.75rem; height: 1.75rem; }
    .line-steps { gap: 1.25rem; }
    .line-step-num { width: 40px; height: 40px; font-size: 1.25rem; }
    .line-step-body strong { font-size: 1.0625rem; }
    .line-step-body p { font-size: 0.9375rem; line-height: 1.75; }

    /* DIY-Guide / Scam-Warning カード PC で間延びさせる */
    #diy-guide .reveal-stagger {
      grid-template-columns: 1fr 1fr !important;
      gap: 2rem !important;
      max-width: 1080px;
      margin: 2.5rem auto 0 !important;
    }
    #diy-guide .reveal-stagger > article {
      padding: 2rem 1.75rem !important;
    }
    #scam-warning .reveal-stagger {
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 1.75rem !important;
      max-width: 1200px;
      margin: 2.5rem auto 0 !important;
    }
    #scam-warning .reveal-stagger article {
      padding: 2rem 1.75rem !important;
    }

    /* VsGov の補助金事情 ボックス */
    #vs-government aside {
      padding: 1.75rem 2rem !important;
    }

    /* MidCTA 大型化 */
    .mid-cta-h2 { font-size: clamp(2rem, 3.5vw, 2.75rem) !important; }
    .mid-cta-tel { padding: 1.5rem 2.5rem !important; }
    .mid-cta-tel .font-num { font-size: clamp(2rem, 3vw, 2.5rem) !important; }

    /* Troubles bubble カード PC */
    .troubles-grid { gap: 1rem 1.5rem; }
    .bubble {
      padding: 1.375rem 1.5rem 1.375rem 4rem;
      font-size: 1rem;
    }
    .bubble::before {
      width: 2.5rem;
      height: 2.5rem;
      left: 1rem;
      font-size: 1.5rem;
    }
    .troubles-resolve {
      padding: 2.5rem 2rem;
      font-size: clamp(1.5rem, 2.5vw, 2rem) !important;
    }
  }

  /* PC ≥1280px : さらに container 拡大 */
  @media (min-width: 1280px) {
    .container { max-width: 1400px; }
    .container-narrow { max-width: 1140px; }
    .section { padding: 6rem 0; }
    .section-title.headline {
      font-size: clamp(2.25rem, 3.5vw, 3rem);
    }
    .section-lead {
      font-size: 1.125rem;
      max-width: 800px;
      margin-bottom: 3.5rem;
    }
    .strengths { gap: 2.5rem; }
    .strength-card { padding: 4rem 2.25rem 2.75rem; }
    .strength-title { font-size: 1.5rem; }
    .strength-desc { font-size: 1.0625rem; }
    .promises-list .promise-card { padding: 2.25rem 2rem; }
    .promise-title { font-size: 1.25rem; }
    .promise-desc { font-size: 1rem; }
    .compare-table { font-size: 1rem; }
    .compare-table thead th.is-us { font-size: 1.125rem; }
    .compare-table tbody th, .compare-table tbody td { padding: 1.5rem 1.25rem; }
    .case-card-title { font-size: 1.1875rem; }
    .case-card-price { font-size: 1.5rem; }
    .voice-card-body { font-size: 1rem; }
    .faq-q-text { font-size: 1.125rem; }
    .faq-a p { font-size: 1rem; }
    .contact-call h3 { font-size: 1.75rem; }
    .contact-tel-big { font-size: 3.5rem; }
    .contact-tel-note { font-size: 1.0625rem; }
    .contact-perks li { font-size: 1.125rem; }
    .contact-line-guide > h3.headline { font-size: 1.75rem; }
    .line-step-body strong { font-size: 1.125rem; }
    .line-step-body p { font-size: 1rem; }
    .troubles-resolve {
      font-size: clamp(1.75rem, 3vw, 2.375rem) !important;
    }
  }

  /* PC ≥1600px : 大型モニタ向け、container さらに広く */
  @media (min-width: 1600px) {
    .container { max-width: 1480px; }
    .section { padding: 7rem 0; }
    .section-title.headline {
      font-size: clamp(2.5rem, 3.5vw, 3.25rem);
    }
  }

  /* ====================================================
     Trust strip / Equipment proof / Estimate proof / Aftercare band
     CV改善ブロック（Hero直下〜Flow後）共通スタイル
     ==================================================== */
  .trust-strip {
    padding: 3rem 0;
    background:
      linear-gradient(90deg, rgba(15, 23, 34, 0.92), rgba(15, 23, 34, 0.72)),
      var(--color-dark);
    color: #fff;
  }
  .trust-strip-inner,
  .equipment-proof-inner,
  .aftercare-band-inner,
  .estimate-proof {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 2rem;
    align-items: center;
  }
  /* 画像が無い場合は1カラムに崩す（broken-link防止） */
  .trust-strip.is-no-image .trust-strip-inner,
  .equipment-proof.is-no-image .equipment-proof-inner,
  .aftercare-band.is-no-image .aftercare-band-inner,
  .estimate-proof.is-no-image {
    grid-template-columns: 1fr;
  }
  .trust-strip-eyebrow {
    display: inline-flex;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .trust-strip-title,
  .equipment-proof-title,
  .aftercare-band-title {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1.25;
  }
  .trust-strip-title span {
    color: var(--color-accent);
  }
  .trust-strip-copy p,
  .equipment-proof-copy p,
  .aftercare-band-copy p,
  .estimate-proof-copy p {
    margin: 0;
    color: inherit;
    line-height: 1.9;
  }
  .trust-strip-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }
  .trust-strip-points li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgba(245, 179, 0, 0.45);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    font-weight: 800;
  }
  .trust-strip-points .icon {
    color: var(--color-accent);
  }
  .trust-strip-visual,
  .equipment-proof-image,
  .aftercare-band-image,
  .estimate-proof-image {
    margin: 0;
    position: relative;
  }
  .trust-strip-visual img,
  .equipment-proof-image img,
  .aftercare-band-image img,
  .estimate-proof-image img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 24px 48px rgba(15, 23, 34, 0.24);
  }
  .equipment-proof {
    background: #fff;
  }
  .equipment-proof-copy {
    padding: 1rem 0;
  }
  .equipment-proof-note {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 1rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 8px;
    background: var(--color-primary-light);
    color: var(--color-dark);
    font-weight: 700;
  }
  .equipment-proof-note .icon {
    color: var(--color-primary);
  }
  .estimate-proof {
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
  }
  .estimate-proof-image img {
    box-shadow: none;
  }
  .estimate-proof-copy {
    padding: 0.5rem 0.5rem 0.5rem 0;
  }
  .estimate-proof-copy h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.25rem, 3vw, 1.8rem);
    color: var(--color-dark);
  }
  .aftercare-band {
    padding: 3.5rem 0;
    background: linear-gradient(135deg, #fff 0%, var(--color-soft) 100%);
  }
  @media (max-width: 880px) {
    .trust-strip {
      padding: 2.5rem 0;
    }
    .trust-strip-inner,
    .equipment-proof-inner,
    .aftercare-band-inner,
    .estimate-proof {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .trust-strip-visual,
    .equipment-proof-image {
      order: -1;
    }
    .trust-strip-points {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .trust-strip-points li {
      min-height: 52px;
      align-items: center;
      font-size: 0.86rem;
      line-height: 1.45;
      padding: 0.65rem 0.85rem;
    }
    .estimate-proof-copy {
      padding: 0;
    }
  }
  @media (max-width: 480px) {
    .trust-strip-title,
    .equipment-proof-title,
    .aftercare-band-title {
      font-size: 1.65rem;
    }
    .trust-strip-points {
      grid-template-columns: 1fr;
    }
  }

  /* ====================================================
     Contact section redesign
     電話CTA本命化 + LINE 補助化 + 左右密度の均一化
     ==================================================== */
  .contact-section .contact-lead {
    text-align: center;
    margin-bottom: 2rem;
  }
  .contact-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* ----- 電話CTAカード（本命） ----- */
  .contact-phone-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #fffaf2 0%, #ffffff 70%);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 16px 36px rgba(200, 30, 30, 0.1);
  }
  /* 薄い斜めストライプの注意感 */
  .contact-phone-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      135deg,
      rgba(200, 30, 30, 0.04),
      rgba(200, 30, 30, 0.04) 14px,
      transparent 14px,
      transparent 28px
    );
    opacity: 0.7;
    z-index: 0;
  }
  .contact-phone-card > * {
    position: relative;
    z-index: 1;
  }

  .contact-phone-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    align-self: flex-start;
  }
  .contact-phone-eyebrow .icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  .contact-phone-title {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    color: var(--color-dark);
    line-height: 1.3;
  }
  .phone-br {
    display: none;
  }
  .contact-phone-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 800;
  }

  /* 大きな赤い電話CTAボタン */
  .contact-phone-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1.1rem 1rem;
    background: linear-gradient(180deg, var(--color-primary) 0%, #a51a1a 100%);
    color: #fff;
    border-radius: 14px;
    text-decoration: none;
    box-shadow: 0 14px 28px rgba(200, 30, 30, 0.32);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    margin-top: 0.25rem;
  }
  .contact-phone-cta:hover,
  .contact-phone-cta:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 20px 36px rgba(200, 30, 30, 0.42);
    color: #fff;
  }
  .contact-phone-cta-row {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .contact-phone-cta .icon {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }
  .contact-phone-number {
    font-size: clamp(1.5rem, 6.5vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .contact-phone-tap {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    opacity: 0.96;
  }

  /* 安心材料 2x2 グリッド */
  .contact-assurance-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }
  .contact-assurance-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.8rem;
    background: #fff;
    border: 1px solid rgba(200, 30, 30, 0.2);
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-dark);
    line-height: 1.35;
  }
  .contact-assurance-item .icon {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* 注意書き */
  .contact-warning-note {
    display: flex;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    background: var(--color-primary-light);
    border-left: 3px solid var(--color-primary);
    border-radius: 8px;
    color: var(--color-dark);
    font-size: 0.83rem;
    font-weight: 700;
    line-height: 1.55;
  }
  .contact-warning-note .icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* ----- LINE カード（補助・トーン抑制） ----- */
  .contact-line-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: 0 6px 20px rgba(15, 23, 34, 0.05);
  }
  .contact-line-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(6, 199, 85, 0.12);
    color: #04a046;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    align-self: flex-start;
  }
  .contact-line-eyebrow .icon {
    width: 0.95rem;
    height: 0.95rem;
    color: #06c755;
  }
  .contact-line-title {
    margin: 0;
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    color: var(--color-dark);
    line-height: 1.45;
  }
  .contact-line-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .contact-line-step {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 0.65rem;
    align-items: start;
  }
  .contact-line-num {
    width: 24px;
    height: 24px;
    background: rgba(6, 199, 85, 0.15);
    color: #04a046;
    border-radius: 50%;
    font-weight: 900;
    font-size: 0.78rem;
    font-family: var(--font-num);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-line-step strong {
    display: block;
    font-size: 0.9rem;
    color: var(--color-dark);
    margin-bottom: 0.1rem;
    font-weight: 800;
  }
  .contact-line-step p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
    line-height: 1.55;
  }
  .contact-line-btn {
    margin-top: 0.25rem;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
  }
  .contact-line-privacy {
    font-size: 0.72rem;
    color: var(--color-muted);
    margin: 0.15rem 0 0;
    text-align: center;
  }

  /* ----- PC レイアウト ----- */
  @media (min-width: 881px) {
    .contact-panel {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 1.75rem;
      align-items: stretch;
    }
    .contact-phone-card {
      padding: 2.5rem 2rem;
      gap: 1.25rem;
    }
    .contact-phone-card,
    .contact-line-card {
      height: 100%;
    }
    .phone-br {
      display: inline;
    }
    .contact-phone-cta {
      padding: 1.4rem 1.25rem;
    }
    .contact-phone-cta .icon {
      width: 1.6rem;
      height: 1.6rem;
    }
    .contact-assurance-grid {
      gap: 0.7rem;
    }
    .contact-assurance-item {
      padding: 0.85rem 1rem;
      font-size: 0.9rem;
    }
    .contact-warning-note {
      font-size: 0.88rem;
      padding: 0.95rem 1.1rem;
    }
    .contact-line-card {
      padding: 2.25rem 1.85rem;
      gap: 1rem;
    }
    .contact-line-title {
      font-size: 1.4rem;
    }
    .contact-line-step strong {
      font-size: 0.95rem;
    }
    .contact-line-step p {
      font-size: 0.85rem;
    }
  }

  /* ----- スマホで電話カードを必ず先頭に ----- */
  @media (max-width: 880px) {
    .contact-phone-card {
      order: 1;
    }
    .contact-line-card {
      order: 2;
    }
  }

  /* ----- 極小幅で電話番号が溢れないように ----- */
  @media (max-width: 380px) {
    .contact-phone-number {
      font-size: 1.45rem;
      letter-spacing: 0.02em;
    }
    .contact-phone-cta .icon {
      width: 1.2rem;
      height: 1.2rem;
    }
    .contact-assurance-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ====================================================
     PC Hero 再設計: 左主役 + 右1枚の安心パネル
     ==================================================== */
  @media (min-width: 981px) {
    .hero {
      min-height: 760px;
    }
    .hero::before {
      background:
        linear-gradient(
          90deg,
          rgba(8, 13, 22, 0.92) 0%,
          rgba(8, 13, 22, 0.78) 38%,
          rgba(8, 13, 22, 0.44) 68%,
          rgba(8, 13, 22, 0.18) 100%
        );
    }
    .hero-bg-video,
    .hero-bg img {
      filter: blur(1.5px) saturate(0.9) brightness(0.82);
      transform: scale(1.03);
    }
    .hero-inner {
      grid-template-columns: minmax(0, 0.98fr) minmax(360px, 0.72fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }
    .hero-content {
      max-width: 680px;
    }
    .hero-mascot-wrap {
      display: none;
    }
    .hero-h1 {
      margin-top: 1.1rem;
      margin-bottom: 1.25rem;
      max-width: 680px;
    }
    .hero-sub {
      max-width: 650px;
      margin-bottom: 1.35rem;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      max-width: 520px;
      margin: 0 0 1.4rem;
    }
    .hero-stat {
      min-height: 92px;
      padding: 0.9rem 0.75rem;
      border-radius: 10px;
      backdrop-filter: blur(10px);
    }
    .hero-stat-num {
      font-size: clamp(1.75rem, 2.5vw, 2.35rem);
      line-height: 1;
    }
    .hero-stat-label {
      margin-top: 0.35rem;
      font-size: 0.78rem;
    }

    /* ===== PC: 電話CTA本命 + LINE 補助 ===== */
    .hero-cta-redesign {
      display: grid;
      gap: 0.85rem;
      max-width: 560px;
    }
    .hero-primary-call {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      padding: 1.05rem 1.2rem;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: #fff;
      text-decoration: none;
      box-shadow:
        0 22px 48px rgba(200, 30, 30, 0.42),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.22);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hero-primary-call:hover,
    .hero-primary-call:focus-visible {
      transform: translateY(-2px);
      box-shadow:
        0 28px 60px rgba(200, 30, 30, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.22);
      color: #fff;
    }
    .hero-primary-call-icon {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
    }
    .hero-primary-call-icon .icon {
      width: 1.55rem;
      height: 1.55rem;
    }
    .hero-primary-call-body {
      display: grid;
      gap: 0.15rem;
      min-width: 0;
    }
    .hero-primary-call-label {
      font-size: 0.84rem;
      font-weight: 800;
      color: #fff3d6;
    }
    .hero-primary-call-number {
      font-size: clamp(2.35rem, 3.6vw, 3.2rem);
      font-weight: 900;
      line-height: 1.0;
      letter-spacing: 0.005em;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    }
    .hero-primary-call-note {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.86);
    }
    .hero-primary-call-arrow {
      width: 1.5rem;
      height: 1.5rem;
    }
    .hero-secondary-line {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: fit-content;
      min-width: 280px;
      padding: 0.78rem 1.25rem;
      border-radius: 999px;
      background: rgba(6, 199, 85, 0.94);
      color: #fff;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 14px 30px rgba(6, 199, 85, 0.24);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .hero-secondary-line:hover,
    .hero-secondary-line:focus-visible {
      filter: brightness(1.05);
      transform: translateY(-1px);
      color: #fff;
    }
    .hero-secondary-line .icon {
      width: 1.1rem;
      height: 1.1rem;
    }

    /* ===== PC: 右側 安心パネル ===== */
    .hero-right.hero-assurance {
      align-self: center;
    }
    .hero-assurance-panel {
      position: relative;
      padding: 2rem;
      border-radius: 16px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.94));
      color: var(--color-dark);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.26);
      border: 1px solid rgba(255, 255, 255, 0.75);
      overflow: hidden;
    }
    .hero-assurance-panel::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 5px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    }
    .hero-assurance-eyebrow {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.7rem;
      margin-bottom: 1rem;
      border-radius: 999px;
      background: var(--color-accent-light);
      color: var(--color-primary-dark);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.06em;
    }
    .hero-assurance-title {
      margin: 0 0 1.25rem;
      font-size: clamp(1.35rem, 2.2vw, 2rem);
      color: var(--color-dark);
      line-height: 1.4;
    }
    .hero-assurance-list {
      display: grid;
      gap: 0.85rem;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    .hero-assurance-list li {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      padding: 0.9rem;
      border-radius: 10px;
      background: #fff8e7;
      border: 1px solid rgba(245, 179, 0, 0.32);
    }
    .hero-assurance-list .icon {
      color: var(--color-primary);
      width: 1.25rem;
      height: 1.25rem;
      margin-top: 0.12rem;
      flex-shrink: 0;
    }
    .hero-assurance-list strong {
      display: block;
      font-size: 0.98rem;
      line-height: 1.35;
      color: var(--color-dark);
      font-weight: 800;
    }
    .hero-assurance-list small {
      display: block;
      margin-top: 0.25rem;
      color: var(--color-muted);
      font-size: 0.78rem;
      line-height: 1.55;
    }
  }

