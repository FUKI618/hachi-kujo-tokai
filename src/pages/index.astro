  .xfloat-btn { display:flex; align-items:center; justify-content:center; gap:.4rem; color:#fff; font-weight:800;
    padding:.6rem .5rem; border-radius:12px; text-decoration:none; box-shadow:0 4px 12px rgba(0,0,0,.2); text-shadow:0 1px 2px rgba(0,0,0,.32); }
  .xfloat-tel { flex:1.5; background:linear-gradient(180deg,#e8590c,#c4150c); }
  .xfloat-line { flex:1; background:#04a847; }
  .xfloat .xic { width:1.3rem; height:1.3rem; }
  .xfloat-tx { display:flex; flex-direction:column; line-height:1.1; align-items:flex-start; }
  .xfloat-tx small { font-size:.58rem; font-weight:700; opacity:1; }
