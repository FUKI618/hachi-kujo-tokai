---
/**
 * /pro/ — 蜂の巣駆除ファクトリー東海｜緊急・電話ファースト集客LP
 * ヒーロー: 承認モック emergency-hero.webp を 100% 画像で使用＝ピクセル完全一致。
 *   社名のみ下地パッチ＋実テキストで上書き。電話＝透明 tel: オーバーレイ（data-cta で CV 自動発火）。
 * 下半分: 実HTML（実データSSOT）でSEO/AEO対策。配色はヒーロー基調（赤#a60101 / 橙CTA / クリーム#fdfcf6）。
 *   画像は実写真（cases / bee-types / generated）のみ。FAQは FAQPage 構造化データを併設。
 */
import Layout from "../layouts/Layout.astro";
import { assetPath } from "../lib/site";
import { company } from "../data/company";
import { rates } from "../data/rates";
import { strengths } from "../data/strengths";
import { promiseCards } from "../data/scam-warning";
import { beeTypes } from "../data/bee-types";
import { cases } from "../data/cases";
import { voices } from "../data/voices";
import { compareRows } from "../data/compare";
import { flowSteps } from "../data/flow";
import { areas } from "../data/areas";
import { faqs } from "../data/faq";
import CtaDual from "../components/CtaDual.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = `名古屋・愛知の蜂の巣駆除なら最短30分｜基本1,680円〜・1年保証｜${company.name}`;
const description = `蜂の巣駆除を名古屋・愛知＋岐阜・三重の近郊エリアで最短30分。事前見積金額からの追加請求なしのハチ駆除専門【${company.name}】。スズメバチ¥2,680〜・アシナガバチ¥1,680〜。24時間365日受付・見積り無料・キャンセル料0円・1年再発保証。`;

const heroImg = assetPath("images/generated/emergency-hero-full.webp");
const beeShown = beeTypes.slice(0, 6);
const casesShown = cases.slice(0, 4);

// 危険度を全レベルで統一表記＋色に正規化（data の dangerLevel: high/highest/medium/low に対応）
const dangerMap: Record<string, { label: string; cls: string }> = {
  highest: { label: "攻撃性 最大", cls: "max" },
  high: { label: "攻撃性 大", cls: "high" },
  medium: { label: "攻撃性 中", cls: "mid" },
  low: { label: "攻撃性 小", cls: "low" },
};
// 料金行に添える蜂サムネ（rate.beeType 名 → bee-types 画像）
const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi",
  "スズメバチ": "suzumebachi",
  "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi",
  "クマバチ・その他": "kumabachi",
};
const strengthsShown = strengths.slice(0, 6);
// FAQPage 構造化データは Layout（faqsToJsonLd）が注入するため、ここでは重複させない。
---

<Layout title={title} description={description}>
  <h1 class="x-sr">名古屋・愛知の蜂の巣駆除｜即日スピード解決・最短30分で現場到着・基本1,680円〜（税込）・1年保証・追加0円の明朗会計・当日対応98%・24時間365日受付 {company.phoneDisplay}</h1>

  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 L9.5 18 L20 6"/></symbol>
  </svg>

  <!-- HERO＋本文を1枚のカードに（PCで中央に浮かせる／モバイルは無スタイル＝不変） -->
  <div class="lp-card">
  <!-- ===== HERO（承認モック画像＝ピクセル完全） ===== -->
  <div class="xhero">
    <img src={heroImg} width="1024" height="1536"
      alt={`蜂の巣駆除 即日スピード解決｜最短30分で現場到着・基本1,680円〜（税込）・1年保証・追加0円の明朗会計・当日対応98%・名古屋・愛知・岐阜・三重対応【${company.name}】電話${company.phoneDisplay}`}
      loading="eager" decoding="async" fetchpriority="high" />
    <div class="xbrand-patch" aria-hidden="true">
      <span class="bname">{company.name}</span>
      <span class="btag">蜂の巣駆除のプロ集団</span>
    </div>
    <!-- 緑ドット下の「ただ今受付中」: ヒーロー画像のAI崩れ文字を実テキストで上書き -->
    <div class="xnow-patch" aria-hidden="true">
      <span>ただ今</span>
      <span>受付中</span>
    </div>
    <a class="xtel xtel-cta" href={company.phoneTelLink} data-cta="hero_tel"
       aria-label={`今すぐ電話で相談 ${company.phoneDisplay}・24時間受付・最短30分で出動`}></a>
    <a class="xtel xtel-head" href={company.phoneTelLink} data-cta="header_tel"
       aria-label={`電話で相談 ${company.phoneDisplay}・24時間受付中`}></a>
  </div>

  <!-- ===== PC専用ヒーロー（≥900pxで表示。モバイルは焼込み画像 .xhero を使用） ===== -->
  <section class="xhero-pc" aria-label="蜂の巣駆除 即日スピード解決｜最短30分・基本1,680円〜">
    <div class="xhpc-wrap">
      <img class="xhpc-mock" src={assetPath("images/generated/hero-pc-chirashi.webp")} width="1376" height="768"
        alt={`蜂の巣駆除 即日スピード解決｜最短30分で到着・基本1,680円〜（税込）・見積出張キャンセル0円・1年保証｜${company.name} 電話${company.phoneDisplay}`}
        loading="eager" decoding="async" fetchpriority="high" />
      <a class="xhpc-tap xhpc-tap-tel" href={company.phoneTelLink} data-cta="hero_tel" aria-label={`今すぐ電話で相談 ${company.phoneDisplay}・24時間受付・タップで発信`}></a>
      <a class="xhpc-tap xhpc-tap-line" href={company.lineUrl} data-cta="hero_line" target="_blank" rel="noopener" aria-label="LINEで無料相談・写真見積"></a>
    </div>
  </section>

  <!-- ===== 下半分（実HTML / 実データ / ヒーロー基調） ===== -->
  <div class="xb">

    <!-- 放置の危険（問題提起） -->
    <section class="xb-sec xb-sec-tint" id="danger" aria-labelledby="s-danger">
      <h2 class="xb-h" id="s-danger"><span>その蜂、放置は危険です</span></h2>
      <p class="xb-lead">スズメバチは巣に近づくだけで突然襲ってくることがあり、日本では毎年<b>15〜21人</b>が蜂刺されで亡くなっています（厚労省人口動態統計）。<b>見つけても近づかず、すぐにご相談ください。</b></p>
      <div class="xdanger-grid">
        <figure class="xb-card xdanger">
          <img src={assetPath("images/danger/hornet-menace.webp")} width="1200" height="1200"
            alt="今にも襲いかかるスズメバチ（イメージ）" loading="lazy" decoding="async" />
          <figcaption class="xdanger-cap">刺激しなくても、巣に近づくだけで攻撃してくることがあります。</figcaption>
        </figure>
        <figure class="xb-card xdanger">
          <img src={assetPath("images/danger/resident-flee.webp")} width="1200" height="1200"
            alt="蜂に驚いて逃げる住人（イメージ）" loading="lazy" decoding="async" />
          <figcaption class="xdanger-cap">巣が大きくなる前の早期対応が、いちばん安全で確実です。</figcaption>
        </figure>
      </div>
      <p class="xb-note">※ 写真はイメージです。</p>
    </section>

    <!-- こんなお悩み（共感） -->
    <section class="xb-sec" id="trouble" aria-labelledby="s-trouble">
      <h2 class="xb-h" id="s-trouble"><span>こんなお悩みありませんか？</span></h2>
      <ul class="xtrouble">
        <li>家の周りで蜂をよく見かける</li>
        <li>軒下・ベランダに巣ができている</li>
        <li>屋根裏や壁の中から羽音がする</li>
        <li>市販スプレーで駆除したが減らない</li>
        <li>去年駆除したのに今年もまた出た</li>
        <li>小さな子ども・ペットがいて不安</li>
      </ul>
      <p class="xb-note xtrouble-cta">ひとつでも当てはまれば、無理せず<b>プロにご相談を</b>。最短30分で駆けつけます。</p>
    </section>

    <!-- 料金 -->
    <section class="xb-sec" id="price" aria-labelledby="s-rate">
      <h2 class="xb-h" id="s-rate"><span>蜂の巣駆除 料金のご案内</span></h2>
      <p class="xb-lead">基本<b>1,680円〜</b>。広告代理店も中間業者も挟まない<b>自社直接対応</b>だから実現できる価格です。</p>

      <ul class="xrate-free" aria-label="無料の項目">
        <li><span class="xrate-free-l">出張費</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">見積り</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">キャンセル</span><span class="xrate-free-z">0<small>円</small></span></li>
        <li><span class="xrate-free-l">追加請求</span><span class="xrate-free-z">0<small>円</small></span></li>
      </ul>

      <div class="xrate-card">
        {rates.map((r, i) => (
          <div class="xrate-row">
            <img class="xrate-thumb" src={assetPath(`images/bee-types/${rateImg[r.beeType] ?? "dorobachi"}.webp`)}
              width="74" height="48" alt={`${r.beeType}の蜂の巣駆除`} loading="lazy" decoding="async" />
            <div class="xrate-info">
              <b class="xrate-name">{r.beeType}</b>
              <span class="xrate-cond">{r.workCondition}</span>
            </div>
            <div class="xrate-price"><b>{r.basicPrice}</b><small>税込</small></div>
          </div>
        ))}
      </div>
      <p class="xb-note">※ 巣のサイズ・高さ・場所により変動。<b>現地で確定見積</b>をお伝えし、ご納得後に作業。事前見積金額からの追加請求はありません。</p>
      <p class="xpay">お支払い：<b>現金・クレジットカード・PayPay・銀行振込・後払い</b> に対応</p>
    </section>

    <CtaDual id="rate_cta" lead="この料金で即日対応。今すぐご相談ください" />

    <!-- 他社見積もり比較（中間マージンゼロ＝価格優位） -->
    <section class="xb-sec xb-sec-tint" id="vs-quote" aria-labelledby="s-vsquote">
      <h2 class="xb-h" id="s-vsquote"><span>他社のお見積もりから、最大<b class="xvs-off">50%OFF</b>も</span></h2>
      <p class="xb-lead">紹介サイトや仲介業者を通すと<b>中間マージン</b>が上乗せされます。当社は受付から駆除まで<b>すべて自社で完結</b>。そのぶん<b>価格をおさえられます</b>。</p>
      <div class="xvs">
        <div class="xvs-card xvs-other">
          <span class="xvs-tag">紹介サイト・仲介経由</span>
          <p class="xvs-pt">受付会社 → 仲介手数料 → 下請け<br /><b>中間マージンが上乗せ</b></p>
        </div>
        <div class="xvs-card xvs-ours">
          <span class="xvs-tag xvs-tag-on">当社（自社施工）</span>
          <p class="xvs-pt">受付も駆除も<b>自社で完結</b><br /><b>中間マージン 0円</b></p>
        </div>
      </div>
      <p class="xvs-lead2"><b>いま、他社のお見積もりで「高いな」と感じていませんか？</b><br />そのお見積もりを、まずは見せてください。安くできるか、その場でお答えします。</p>
      <CtaDual id="vsquote_cta" lead="他社のお見積もりが高いと感じたら、まずはご相談を" />
      <p class="xb-note">※ 削減率は蜂の種類・巣の状況・他社のお見積もり内容により異なります。実際のお見積もり比較に基づく実績であり、すべての案件で50%お安くなることを保証するものではありません。</p>
    </section>

    <!-- 選ばれる理由 -->
    <section class="xb-sec xb-sec-tint" id="scam-warning" aria-labelledby="s-why">
      <h2 class="xb-h" id="s-why"><span>選ばれる理由</span></h2>
      <div class="xb-why">
        {strengthsShown.map((s) => (
          <div class="xb-card xb-why-card">
            <span class="xb-num">{s.num}</span>
            <div class="xb-why-body">
              <h3 set:html={s.title}></h3>
              <p>{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 安心の3つのお約束 -->
    <section class="xb-sec" id="promise" aria-labelledby="s-promise">
      <h2 class="xb-h" id="s-promise"><span>安心の3つのお約束</span></h2>
      <div class="xpromise">
        {promiseCards.map((p) => (
          <div class="xb-card xpromise-card">
            <span class="xpromise-ic" aria-hidden="true">✓</span>
            <div class="xpromise-body">
              <h3>{p.label}</h3>
              <p>{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 蜂の種類 -->
    <section class="xb-sec" id="bee-types" aria-labelledby="s-bee">
      <h2 class="xb-h" id="s-bee"><span>対応する蜂の種類</span></h2>
      <p class="xb-lead">それぞれ危険度・営巣場所が異なります。<b>種類が分からなくても</b>現地で判別から承ります。</p>
      <div class="xbee-grid">
        {beeShown.map((b) => {
          const d = dangerMap[b.dangerLevel] ?? dangerMap.low;
          return (
            <article class="xbee">
              <div class="xbee-photo">
                <img src={assetPath(`images/bee-types/${b.imageBase}.webp`)} width="320" height="200"
                  alt={`${b.name}（${d.label}）`} loading="lazy" decoding="async" />
                <span class={`xbee-badge xbee-badge-${d.cls}`}>{d.label}</span>
              </div>
              <div class="xbee-body">
                <h3 class="xbee-name">{b.name}</h3>
                <div class="xbee-meter" role="img" aria-label={`危険度 ${b.dangerBars} / 5`}>
                  {[1,2,3,4,5].map((i) => (
                    <i class={i <= b.dangerBars ? `on on-${d.cls}` : ""}></i>
                  ))}
                </div>
                <p class="xbee-desc">{b.description}</p>
                <dl class="xbee-meta">
                  <div><dt>活動</dt><dd>{b.activeMonths}</dd></div>
                  <div><dt>営巣</dt><dd>{b.nestLocation}</dd></div>
                </dl>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 蜂の巣ができやすい場所 -->
    <section class="xb-sec xb-sec-tint" id="spots" aria-labelledby="s-spots">
      <h2 class="xb-h" id="s-spots"><span>蜂の巣ができやすい場所</span></h2>
      <p class="xb-lead">下記のような場所にも対応します。<b>高所・狭所・屋根裏・土の中</b>など、自力では危険な場所こそプロにお任せください。場所が分からなくても現地で調査します。</p>
      <ul class="xspots">
        <li>軒下</li><li>屋根裏・天井裏</li><li>ベランダ</li><li>エアコン室外機</li><li>換気口・換気扇</li><li>壁の中・戸袋</li><li>床下</li><li>庭木・生垣</li><li>物置・倉庫</li><li>土の中</li>
      </ul>
    </section>

    <!-- 施工事例 -->
    <section class="xb-sec xb-sec-tint" id="cases" aria-labelledby="s-case">
      <h2 class="xb-h" id="s-case"><span>施工事例</span></h2>
      <div class="xb-cases">
        {casesShown.map((c) => (
          <div class="xb-card xb-case-card">
            <img src={assetPath(`images/cases/${c.imageBase}.webp`)} width="320" height="220"
              alt={`${c.area} ${c.title}`} loading="lazy" decoding="async" />
            <div class="xb-case-body">
              <div class="xb-case-tags"><span class="xb-tag">{c.beeType}</span><span class="xb-tag">{c.area}</span><span class="xb-tag">{c.location}</span></div>
              <h3>{c.title}</h3>
              <p class="xb-case-status"><span class="xb-case-check">✓</span>駆除完了・現地確定見積で対応</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- お客様の声 -->
    <section class="xb-sec" aria-labelledby="s-voice">
      <h2 class="xb-h" id="s-voice"><span>お客様の声</span></h2>
      <div class="xb-voices">
        {voices.map((v) => (
          <div class="xb-card xb-voice-card">
            <div class="xb-voice-head">
              <span class="xb-avatar">{v.initial}</span>
              <span class="xb-voice-meta">{v.area}・{v.ageBracket}<small>{v.service}</small></span>
              <span class="xb-stars" aria-label={`${v.rating}点`}>{"★".repeat(v.rating)}</span>
            </div>
            <p>{v.comment}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaDual id="proof_cta" lead="施工実績多数・1年保証付き。お気軽にご相談ください" />

    <!-- 他社との比較 -->
    <section class="xb-sec xb-sec-tint" aria-labelledby="s-cmp">
      <h2 class="xb-h" id="s-cmp"><span>他社との違い</span></h2>
      <div class="xb-card xb-cmp">
        <table>
          <thead><tr><th></th><th class="xb-cmp-us">当社</th><th>一般業者</th><th>仲介サイト</th></tr></thead>
          <tbody>
            {compareRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="xb-cmp-us"><span class={`xb-st xb-st-${row.us.state}`}>{row.us.text}</span></td>
                <td><span class={`xb-st xb-st-${row.general.state}`}>{row.general.text}</span></td>
                <td><span class={`xb-st xb-st-${row.intermediary.state}`}>{row.intermediary.text}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 駆除の流れ -->
    <section class="xb-sec" aria-labelledby="s-flow">
      <h2 class="xb-h" id="s-flow"><span>ご相談から駆除完了までの流れ</span></h2>
      <ol class="xb-flow">
        {flowSteps.map((st) => (
          <li class="xb-card xb-flow-step">
            <span class="xb-num">{st.num}</span>
            <div><h3>{st.title}</h3><p>{st.description}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 戻り蜂・再発防止 -->
    <section class="xb-sec" id="prevention" aria-labelledby="s-prevention">
      <h2 class="xb-h" id="s-prevention"><span>戻り蜂対策・再発防止まで</span></h2>
      <p class="xb-lead">巣を撤去しても、エサ採りに出ていた<b>戻り蜂</b>や、同じ場所への再営巣が起こることがあります。当社は撤去後に<b>忌避処理・侵入経路の対策</b>まで行い、<b>1年間の再発保証</b>をお付けします（保証条件は作業時にご説明します）。</p>
    </section>

    <!-- 対応エリア -->
    <section class="xb-sec xb-sec-tint" id="area" aria-labelledby="s-area">
      <h2 class="xb-h" id="s-area"><span>対応エリア</span></h2>
      <div class="xb-areas">
        {areas.map((a) => (
          <div class="xb-area-block">
            <b class="xb-area-pref">{a.prefecture}</b>
            <div class="xb-area-cities">{a.cities.map((c) => (<span>{c}</span>))}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="xb-sec" aria-labelledby="s-faq">
      <h2 class="xb-h" id="s-faq"><span>よくあるご質問</span></h2>
      <div class="xb-faq">
        {faqs.map((f) => (
          <details class="xb-card xb-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 最終CTA（電話＋LINE） -->
    <section class="xb-cta-sec" id="contact" aria-label="お問い合わせ">
      <p class="xb-cta-lead">まずはお気軽にご相談ください</p>
      <div class="xb-cta-btns">
        <a href={company.phoneTelLink} class="xb-cta-btn xb-cta-tel" data-cta="footer_tel" aria-label={`電話で相談 ${company.phoneDisplay}`}>
          <svg class="xic"><use href="#i-phone" /></svg>
          <span><b class="font-num">{company.phoneDisplay}</b><small>24時間365日受付・通話無料・タップで発信</small></span>
        </a>
