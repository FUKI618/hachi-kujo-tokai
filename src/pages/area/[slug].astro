---
/**
 * 広告専用 地域着地ページ（メインLPのデザインを転写・noindex）
 * landing-areas.ts から getStaticPaths で生成。honest厳守: 市名＋実在近隣＋全社共通の正直な料金/保証のみ。
 * デザイン: index.astro のブランド言語（cream地・ピル型グラデ見出し・温色tint・赤アクセント）を移植。
 * 画像は既存webp流用（汎用イメージ）。捏造実績/件数/口コミなし。
 */
import Layout from "../../layouts/Layout.astro";
import { landingAreas } from "../../data/landing-areas";
import { company } from "../../data/company";
import { rates } from "../../data/rates";
import { faqs } from "../../data/faq";
import { promiseCards } from "../../data/scam-warning";
import { beeTypes } from "../../data/bee-types";
import { assetPath } from "../../lib/site";
import CtaDual from "../../components/CtaDual.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export function getStaticPaths() {
  return landingAreas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}
const { area } = Astro.props;
const { city, prefecture, nearby } = area;
const title = `${city}の蜂の巣駆除｜最短30分・基本1,680円〜・追加0円｜${company.name}`;
const description = `${city}の蜂の巣駆除なら${company.name}。スズメバチ・アシナガバチ・ミツバチを最短30分で当日対応。基本1,680円〜、出張費・見積り0円、確定見積からの追加請求なし・1年保証。24時間365日受付。`;

const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi", "スズメバチ": "suzumebachi", "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi", "クマバチ・その他": "kumabachi",
};
const dangerMap: Record<string, { label: string; cls: string }> = {
  highest: { label: "攻撃性 最大", cls: "max" }, high: { label: "攻撃性 大", cls: "high" },
  medium: { label: "攻撃性 中", cls: "mid" }, low: { label: "攻撃性 小", cls: "low" },
};
const beeShown = beeTypes.slice(0, 6);
const faqsShown = faqs.slice(0, 8);
const heroImg = assetPath("images/generated/emergency-hero-full.webp");
---

<Layout title={title} description={description} noindex={true}>
  <div class="ar">
    <!-- HERO（本体LPの画像ヒーローをそのまま移植：モバイル焼込み画像＋PC専用） -->
    <h1 class="x-sr">{prefecture}{city}の蜂の巣駆除｜即日スピード解決・最短30分で現場到着・基本1,680円〜（税込）・1年保証・追加0円の明朗会計・24時間365日受付 {company.phoneDisplay}</h1>
    <div class="xhero">
      <img src={heroImg} width="1024" height="1536"
        alt={`${prefecture}${city}の蜂の巣駆除 即日スピード解決｜最短30分で現場到着・基本1,680円〜（税込）・1年保証・追加0円の明朗会計【${company.name}】電話${company.phoneDisplay}`}
        loading="eager" decoding="async" fetchpriority="high" />
      <div class="xbrand-patch" aria-hidden="true">
        <span class="bname">{company.name}</span>
        <span class="btag">蜂の巣駆除のプロ集団</span>
      </div>
      <div class="xnow-patch" aria-hidden="true"><span>ただ今</span><span>受付中</span></div>
      <a class="xtel xtel-cta" href={company.phoneTelLink} data-cta="hero_tel"
        aria-label={`今すぐ電話で相談 ${company.phoneDisplay}・24時間受付・最短30分で出動`}></a>
      <a class="xtel xtel-head" href={company.phoneTelLink} data-cta="header_tel"
        aria-label={`電話で相談 ${company.phoneDisplay}・24時間受付中`}></a>
    </div>
    <section class="xhero-pc" aria-label={`${city}の蜂の巣駆除 即日スピード解決｜最短30分・基本1,680円〜`}>
      <div class="xhpc-wrap">
        <img class="xhpc-mock" src={assetPath("images/generated/hero-pc-chirashi.webp")} width="1376" height="768"
          alt={`${prefecture}${city}の蜂の巣駆除 即日スピード解決｜最短30分で到着・基本1,680円〜（税込）・見積出張キャンセル0円・1年保証｜${company.name} 電話${company.phoneDisplay}`}
          loading="eager" decoding="async" fetchpriority="high" />
        <a class="xhpc-tap xhpc-tap-tel" href={company.phoneTelLink} data-cta="hero_tel" aria-label={`今すぐ電話で相談 ${company.phoneDisplay}・タップで発信`}></a>
        <a class="xhpc-tap xhpc-tap-line" href={company.lineUrl} data-cta="hero_line" target="_blank" rel="noopener" aria-label="LINEで無料相談・写真見積"></a>
      </div>
    </section>

    <CtaDual id="area_top" lead={`${city}で蜂の巣を見つけたら、まずはお電話を`} />

    <section class="ar-sec">
      <div class="ar-h"><span>{city}とその近郊に対応</span></div>
      <p class="ar-lead"><b>{company.name}</b>は<b>{prefecture}{city}</b>を含む名古屋近郊エリアに24時間365日対応。{city}周辺では<b>{nearby.join("・")}</b>などにも最短30分で出動します。ご自宅・店舗・施設のどこに巣があっても、まずはお電話かLINEでご相談ください。</p>
    </section>

    <section class="ar-sec ar-tint">
      <div class="ar-h"><span>蜂の巣駆除 料金（{city}）</span></div>
      <ul class="ar-free">
        <li><span class="ar-free-l">出張費</span><span class="ar-free-z">0<small>円</small></span></li>
        <li><span class="ar-free-l">見積り</span><span class="ar-free-z">0<small>円</small></span></li>
        <li><span class="ar-free-l">キャンセル</span><span class="ar-free-z">0<small>円</small></span></li>
        <li><span class="ar-free-l">追加請求</span><span class="ar-free-z">0<small>円</small></span></li>
      </ul>
      <div class="ar-rate-card">
        {rates.map((r) => (
          <div class="ar-rate-row">
            <img class="ar-rate-thumb" src={assetPath(`images/bee-types/${rateImg[r.beeType] ?? "dorobachi"}.webp`)} width="74" height="48" alt={`${r.beeType}の蜂の巣駆除`} loading="lazy" decoding="async" />
            <div class="ar-rate-info"><b class="ar-rate-name">{r.beeType}</b><span class="ar-rate-cond">{r.workCondition}</span></div>
            <div class="ar-rate-price"><b>{r.basicPrice}</b><small>税込</small></div>
          </div>
        ))}
      </div>
      <p class="ar-note">※ 巣のサイズ・高さ・場所により変動。<b>現地で確定見積</b>をお伝えし、ご納得後に作業。事前見積金額からの追加請求はありません。</p>
    </section>

    <section class="ar-sec">
      <div class="ar-h"><span>その蜂、放置は危険です</span></div>
      <p class="ar-lead">スズメバチは巣に近づくだけで突然襲ってくることがあり、日本では毎年<b>15〜21人</b>が蜂刺されで亡くなっています（厚労省人口動態統計）。{city}で巣やハチを見かけたら、<b>近づかず</b>すぐにご相談ください。</p>
      <div class="ar-danger">
        <figure class="ar-card ar-dcard">
          <img src={assetPath("images/danger/hornet-menace.webp")} width="1200" height="1200" alt="今にも襲いかかるスズメバチ（イメージ）" loading="lazy" decoding="async" />
          <figcaption>刺激しなくても、巣に近づくだけで攻撃してくることがあります。</figcaption>
        </figure>
        <figure class="ar-card ar-dcard">
          <img src={assetPath("images/danger/resident-flee.webp")} width="1200" height="1200" alt="蜂に驚いて逃げる住人（イメージ）" loading="lazy" decoding="async" />
          <figcaption>巣が大きくなる前の早期対応が、いちばん安全で確実です。</figcaption>
        </figure>
      </div>
      <p class="ar-note">※ 写真はイメージです。</p>
    </section>

    <section class="ar-sec ar-tint">
      <div class="ar-h"><span>対応する蜂の種類</span></div>
      <div class="ar-bee">
        {beeShown.map((b) => {
          const d = dangerMap[b.dangerLevel] ?? dangerMap.low;
          return (
            <article class="ar-card ar-bcard">
              <div class="ar-bphoto">
                <img src={assetPath(`images/bee-types/${b.imageBase}.webp`)} width="320" height="200" alt={`${b.name}（${d.label}）`} loading="lazy" decoding="async" />
                <span class={`ar-badge ar-badge-${d.cls}`}>{d.label}</span>
              </div>
              <div class="ar-bbody"><h3>{b.name}</h3><p>{b.description}</p></div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="ar-sec">
      <div class="ar-h"><span>安心の3つのお約束</span></div>
      <div class="ar-promise">
        {promiseCards.map((p) => (
          <div class="ar-card ar-pcard"><span class="ar-pic" aria-hidden="true">✓</span><div><h3>{p.label}</h3><p>{p.body}</p></div></div>
        ))}
      </div>
    </section>

    <CtaDual id="area_mid" lead={`${city}対応・他社のお見積もりが高いと感じたらご相談を`} />

    <section class="ar-sec ar-tint">
      <div class="ar-h"><span>よくあるご質問</span></div>
      <div class="ar-faq">
        {faqsShown.map((f) => (
          <details class="ar-card ar-fitem"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </section>

    <CtaDual id="area_btm" lead={`${city}の蜂の巣駆除は今すぐご連絡ください`} />
  </div>
</Layout>
<SiteFooter />

<style>
  .ar { --red:#a60101; --ink:#241608; --cream:#fdfcf6; --line:rgba(20,12,4,.10);
    max-width:480px; margin-inline:auto; background:var(--cream); color:var(--ink);
    font-family:"Noto Sans JP","Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif; }
  .ar section { padding:26px 16px; }
  .ar-tint { background:#fff6ec; }

  /* hero（本体LP .xhero/.xhero-pc をそのまま移植） */
  .x-sr { position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  .xhero { position:relative; width:100%; max-width:480px; margin-inline:auto; background:#fdfcf6; container-type:inline-size; }
  .xhero img { width:100%; height:auto; display:block; }
  .xhero .xtel { position:absolute; display:block; }
  .xtel-cta  { left:6%;  top:43.2%; width:88%; height:11.1%; }
  .xtel-head { left:59%; top:4.8%;  width:38%; height:4.8%; }
  .xbrand-patch { position:absolute; left:15.6%; top:6.6%; width:43%; height:6.6%;
    background:#fdfcf6; display:flex; flex-direction:column; justify-content:center; gap:.3cqw; pointer-events:none; }
  .xbrand-patch .bname { font-weight:900; color:#0e0e0d; font-size:3.1cqw; line-height:1; letter-spacing:-.02em; white-space:nowrap; }
  .xbrand-patch .btag { font-weight:700; color:#5a5a5a; font-size:1.7cqw; line-height:1; white-space:nowrap; }
  .xnow-patch { position:absolute; left:82.8%; top:53.2%; width:10.6%; height:4.6%;
    background:linear-gradient(180deg,#dc2a02,#ce0801); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.15cqw; pointer-events:none; overflow:hidden; }
  .xnow-patch span { font-weight:800; color:#fff; font-size:2.4cqw; line-height:1; letter-spacing:-.01em; white-space:nowrap; }
  .xhero-pc { display:none; }

  /* signature pill header (transcribed from index .xb-h) */
  .ar-h { display:flex; justify-content:center; margin:0 0 16px; }
  .ar-h span { display:inline-block; background:linear-gradient(180deg,#b81810,#8c1108); color:#fff;
    font-size:1.06rem; font-weight:900; letter-spacing:.01em; padding:.5rem 1.1rem; border-radius:9999px;
    box-shadow:0 4px 12px rgba(150,20,12,.28); text-align:center; }
  .ar-lead { font-size:.86rem; line-height:1.75; margin:0; }
  .ar-lead b { color:var(--red); font-weight:900; }
  .ar-note { font-size:.72rem; color:#6b5d4a; line-height:1.6; margin:12px 2px 0; text-align:center; }
  .ar-card { background:#fff; border:1px solid var(--line); border-radius:14px; box-shadow:0 3px 12px rgba(20,12,4,.06); }

  /* 料金 */
  .ar-free { list-style:none; margin:0 0 14px; padding:0; display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  .ar-free li { display:flex; flex-direction:column; align-items:center; gap:2px; background:#fff; border:1px solid var(--line); border-radius:10px; padding:.55rem .2rem; }
  .ar-free-l { font-size:.6rem; font-weight:800; color:#5b4f3d; }
  .ar-free-z { font-size:1.45rem; font-weight:900; color:#0a7d28; line-height:1; }
  .ar-free-z small { font-size:.62rem; margin-left:1px; }
  .ar-rate-card { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; box-shadow:0 3px 12px rgba(20,12,4,.06); }
  .ar-rate-row { display:flex; align-items:center; gap:.85rem; padding:.95rem; border-bottom:1px solid var(--line); }
  .ar-rate-row:last-child { border-bottom:0; }
  .ar-rate-thumb { width:74px; height:48px; border-radius:8px; object-fit:contain; flex-shrink:0; border:1px solid var(--line); background:#fff; padding:2px; }
  .ar-rate-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
  .ar-rate-name { font-size:1rem; font-weight:900; line-height:1.2; }
  .ar-rate-cond { font-size:.66rem; color:#8a7c68; line-height:1.5; }
  .ar-rate-price { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; line-height:1; }
  .ar-rate-price b { font-size:1.3rem; font-weight:900; color:#e2231a; font-variant-numeric:tabular-nums; }
  .ar-rate-price small { font-size:.58rem; color:#8a7c68; margin-top:4px; font-weight:700; }

  /* 危険 2カラム */
  .ar-danger { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:14px; }
  .ar-dcard { margin:0; overflow:hidden; display:flex; flex-direction:column; }
  .ar-dcard img { width:100%; height:160px; object-fit:cover; display:block; }
  .ar-dcard figcaption { padding:.7rem .8rem .85rem; font-size:.74rem; line-height:1.55; color:#46402f; font-weight:600; }

  /* 蜂の種類 */
  .ar-bee { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .ar-bcard { overflow:hidden; display:flex; flex-direction:column; }
  .ar-bphoto { position:relative; }
  .ar-bphoto img { width:100%; height:120px; object-fit:cover; display:block; }
  .ar-badge { position:absolute; left:8px; top:8px; font-size:.6rem; font-weight:900; color:#fff; padding:.18rem .5rem; border-radius:999px; }
  .ar-badge-max { background:#9a0d0d; } .ar-badge-high { background:#c4150c; } .ar-badge-mid { background:#d9730a; } .ar-badge-low { background:#0a7d28; }
  .ar-bbody { padding:.7rem .8rem .85rem; }
  .ar-bbody h3 { margin:0 0 .3rem; font-size:.92rem; font-weight:900; }
  .ar-bbody p { margin:0; font-size:.72rem; line-height:1.6; color:#3f3526; }

  /* 約束 */
  .ar-promise { display:grid; grid-template-columns:1fr; gap:10px; }
  .ar-pcard { display:flex; gap:.7rem; align-items:flex-start; padding:.9rem .8rem; }
  .ar-pic { flex-shrink:0; width:1.8rem; height:1.8rem; border-radius:50%; background:var(--red); color:#fff; font-weight:900; display:flex; align-items:center; justify-content:center; font-size:1rem; line-height:1; }
  .ar-pcard h3 { margin:0 0 .25rem; font-size:.88rem; font-weight:800; }
  .ar-pcard p { margin:0; font-size:.78rem; line-height:1.65; color:#3f3526; }

  /* FAQ */
  .ar-faq { display:flex; flex-direction:column; gap:8px; }
  .ar-fitem { padding:.1rem; }
  .ar-fitem summary { cursor:pointer; font-weight:700; font-size:.85rem; padding:.7rem .8rem; list-style:none; }
  .ar-fitem summary::-webkit-details-marker { display:none; }
  .ar-fitem p { margin:0; padding:0 .8rem .8rem; font-size:.8rem; line-height:1.75; color:#3f3526; }

  /* PC: 中央カード化（index .lp-card 相当） */
  @media (min-width:900px){
    .ar { max-width:900px; margin:24px auto; background:#fff; border-radius:20px; box-shadow:0 20px 60px rgba(20,12,4,.12); overflow:hidden; }
    /* PCは焼込みヒーローを隠し、PC専用ヒーローを全幅表示（本体LPと同一挙動） */
    .xhero { display:none; }
    .xhero-pc { display:block; background:linear-gradient(180deg,#cfe8fb 0%,#eaf6ff 62%,#f4fbff 100%); padding:0 0 2px; }
    .xhpc-wrap { position:relative; max-width:1320px; margin:0 auto; line-height:0; }
    .xhpc-mock { width:100%; height:auto; display:block; }
    .xhpc-tap { position:absolute; display:block; z-index:2; -webkit-tap-highlight-color:transparent; border-radius:14px; }
    .xhpc-tap-tel  { left:57.5%; top:68.5%; width:41.5%; height:16.5%; }
    .xhpc-tap-line { left:65.5%; top:85%;  width:31.5%; height:10%; }
    .ar-danger, .ar-bee { max-width:760px; margin-inline:auto; }
    .ar-bee { grid-template-columns:repeat(3,1fr); }
    .ar-promise { grid-template-columns:repeat(3,1fr); max-width:820px; margin-inline:auto; }
    .ar-rate-card, .ar-free, .ar-faq { max-width:680px; margin-inline:auto; }
  }
</style>
