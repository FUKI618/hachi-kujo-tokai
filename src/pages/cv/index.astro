  .px-final { position: relative; overflow: hidden; background: radial-gradient(120% 100% at 50% 0%, #2a2118, var(--ink)); text-align: center; padding: 2.6rem 0 3rem; border-top: 2px solid var(--gold); }
  .px-final-hornet { position: absolute; left: -1.5rem; bottom: -1rem; width: clamp(120px, 32vw, 200px); height: auto; opacity: .5; transform: rotate(-8deg); pointer-events: none; z-index: 0; }
