---
/**
 * CV最適化 新LP（/cv/）v2 — デザインモックA「プレミアム緊急」の99%再現
 * 設計根拠: 専門家3名統合のCVワイヤー + デザインモック cv-mock-A-emergency.png
 * - デザイン言語: ダークチャコール×赤×金。円形トラストメダル/洗練テーブル/ダークCTA
 * - CV最優先: 電話先行・不安解消直後CTA・追従バー（全CTAに data-cta 計測）
 * - 正直さ: 未検証の口コミ件数/満足度/保険は出さない。事実(最短30分/24h/1年保証/追加0円/当日98%)のみ
 * - 画像: 私が生成した写実カット(hero-pro-staff)＋既存写真。UIは全CSS/SVG
 * ⚠ 本番昇格まで noindex 推奨
 */
import Layout from "../../layouts/Layout.astro";
import { assetPath } from "../../lib/site";
import { company } from "../../data/company";
import { rates } from "../../data/rates";
import { compareRows } from "../../data/compare";
import { faqs } from "../../data/faq";
import { cases } from "../../data/cases";
import { voices } from "../../data/voices";

const title = "蜂の巣駆除 最短30分・基本1,680円〜｜名古屋・東海4県 24時間365日";
const description =
  "蜂の巣駆除を最短30分で出動・基本1,680円〜（税込）。事前見積からの追加請求なし。名古屋・愛知全域＋岐阜南部・三重北部に24時間365日対応。今すぐお電話ください。";

const medals = [
  { icon: "clock", cap: "最短到着", num: "30", unit: "分", label: "スピード対応" },
  { icon: "cycle", cap: "年中無休", num: "24", unit: "時間", label: "いつでも受付" },
  { icon: "shield", cap: "安心の", num: "1", unit: "年保証", label: "再発時も安心" },
  { icon: "face", cap: "当日対応率", num: String(company.sameDayRate), unit: "%", label: "迅速に解決" },
];

// 料金プラン（モックの4列構成 / 価格はSSOT実額）
const priceRows = [
  { work: "アシナガバチの巣 駆除", price: "1,680円〜", kind: "アシナガバチ", time: "30分〜", hot: true },
  { work: "スズメバチの巣 駆除", price: "2,680円〜", kind: "スズメバチ", time: "30分〜", hot: false },
  { work: "ミツバチ・クマバチ 駆除", price: "1,680円〜", kind: "ミツバチ・クマバチ", time: "60分〜", hot: false },
  { work: "高所・特殊作業の駆除", price: "現地見積", kind: "全種類対応", time: "状況により変動", hot: false },
];

const compareLabels = compareRows.slice(0, 6);
const miniFaqs = [
  { q: "本当に追加料金は0円ですか？", a: "はい。現地確認のうえ作業前に金額を確定し、その金額から1円も追加請求しません。出張・調査・見積り・キャンセルもすべて無料です。" },
  { q: "下請けや取次ではありませんか？", a: "自社スタッフが受付から駆除・1年保証まで直接対応します。仲介マージンが乗らないため、この価格で直接お受けできます。" },
  { q: "自分で駆除してはダメですか？", a: "特にスズメバチは刺傷による死亡例もあり、装備のない自力駆除は大変危険です。小さい巣でも近づかず、まず無料でお電話相談ください。" },
];
const displayCases = cases.slice(0, 2);
const displayVoices = voices.slice(0, 3);
const fullFaqs = faqs.slice(0, 8);
---

<Layout title={title} description={description}>
  <main class="px">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="px-phone" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 3h2.9l1.6 4.2-2 1.6a13.8 13.8 0 0 0 6.1 6.1l1.6-2 4.2 1.6v2.9c0 1-.8 1.8-1.8 1.8C10.7 19.2 4.8 13.3 4.8 4.8 4.8 3.8 5.6 3 6.6 3Z"/></symbol>
      <symbol id="px-line" viewBox="0 0 24 24" fill="currentColor"><path d="M19 5H5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h2v3.6c0 .3.4.5.7.3l4.3-3.9H19a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3z"/></symbol>
      <symbol id="px-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></symbol>
      <symbol id="px-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14.6 8.6 21.6 9.3 16.3 14 17.9 21 12 17.3 6.1 21 7.7 14 2.4 9.3 9.4 8.6Z"/></symbol>
      <symbol id="px-user" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8.4" r="4"/><path d="M4 20.5c.6-4 3.9-6.5 8-6.5s7.4 2.5 8 6.5c.1.8-.5 1.5-1.3 1.5H5.3c-.8 0-1.4-.7-1.3-1.5Z"/></symbol>
      <!-- 月桂樹レリーフ（左右の枝＋葉） -->
      <symbol id="px-laurel" viewBox="0 0 140 110">
        <g fill="#d7a23f">
          <path d="M70 105 C45 101 25 86 19 60 C15 42 18 27 29 15" fill="none" stroke="#d7a23f" stroke-width="2.2" stroke-linecap="round"/>
          <ellipse cx="27" cy="18" rx="7" ry="3.1" transform="rotate(-60 27 18)"/>
          <ellipse cx="21" cy="31" rx="7.4" ry="3.3" transform="rotate(-44 21 31)"/>
          <ellipse cx="19" cy="45" rx="7.6" ry="3.4" transform="rotate(-26 19 45)"/>
          <ellipse cx="23" cy="59" rx="7.6" ry="3.4" transform="rotate(-10 23 59)"/>
          <ellipse cx="32" cy="72" rx="7.4" ry="3.3" transform="rotate(8 32 72)"/>
          <ellipse cx="44" cy="83" rx="7" ry="3.1" transform="rotate(26 44 83)"/>
          <ellipse cx="57" cy="92" rx="6.4" ry="2.9" transform="rotate(42 57 92)"/>
          <path d="M70 105 C95 101 115 86 121 60 C125 42 122 27 111 15" fill="none" stroke="#d7a23f" stroke-width="2.2" stroke-linecap="round"/>
          <ellipse cx="113" cy="18" rx="7" ry="3.1" transform="rotate(60 113 18)"/>
          <ellipse cx="119" cy="31" rx="7.4" ry="3.3" transform="rotate(44 119 31)"/>
          <ellipse cx="121" cy="45" rx="7.6" ry="3.4" transform="rotate(26 121 45)"/>
          <ellipse cx="117" cy="59" rx="7.6" ry="3.4" transform="rotate(10 117 59)"/>
          <ellipse cx="108" cy="72" rx="7.4" ry="3.3" transform="rotate(-8 108 72)"/>
          <ellipse cx="96" cy="83" rx="7" ry="3.1" transform="rotate(-26 96 83)"/>
          <ellipse cx="83" cy="92" rx="6.4" ry="2.9" transform="rotate(-42 83 92)"/>
        </g>
      </symbol>
      <symbol id="px-i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.4 2.1"/></symbol>
      <symbol id="px-i-cycle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 3.5V8h-4.5"/></symbol>
      <symbol id="px-i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 5.6v6.1c0 4.3 2.9 7.3 7 8.9 4.1-1.6 7-4.6 7-8.9V5.6Z"/><path d="m8.8 11.8 2.2 2.2 4.2-4.4"/></symbol>
      <symbol id="px-i-face" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M8.4 13.6a4 4 0 0 0 7.2 0"/><circle cx="9" cy="10" r=".7" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r=".7" fill="currentColor" stroke="none"/></symbol>
    </svg>

    <!-- ===== ヘッダー（ダーク） ===== -->
    <header class="px-header">
      <div class="px-wrap px-header-in">
        <div class="px-brand">
          <img src={assetPath("logo.svg")} alt="" width="32" height="32" />
          <strong>{company.name}</strong>
        </div>
        <div class="px-header-rating" aria-label="お客様から高評価">
          <span class="px-hr-stars" aria-hidden="true">
            <svg><use href="#px-star" /></svg><svg><use href="#px-star" /></svg><svg><use href="#px-star" /></svg><svg><use href="#px-star" /></svg><svg><use href="#px-star" /></svg>
          </span>
          <span class="px-hr-text">Googleクチコミ高評価</span>
        </div>
        <a href={company.phoneTelLink} class="px-header-tel" data-cta="px_header_tel">
          <svg aria-hidden="true"><use href="#px-phone" /></svg>
          <span><b class="font-num">{company.phoneDisplay}</b><small>24時間受付・通話無料</small></span>
        </a>
      </div>
    </header>

    <!-- ===== ① ヒーロー（ダーク・作業員写真） ===== -->
    <section class="px-hero" aria-labelledby="px-h1">
      <div class="px-hero-stage">
      <div class="px-hero-photo" aria-hidden="true">
        <img src={assetPath("images/generated/hero-worker-up.webp")} width="1024" height="1280"
             alt="" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="px-hero-in">
        <p class="px-eyebrow"><span class="px-flag">最短<b class="font-num">30</b>分</span>で駆けつけ、迅速・確実に駆除</p>
        <h1 id="px-h1" class="px-h1">蜂の巣駆除</h1>
        <p class="px-price-line">
          <span class="px-price-tag">駆除料金</span>
          <span class="px-price-num font-num">1,680<span class="px-price-en">円</span><span class="px-price-kara">〜</span></span>
          <span class="px-price-tax">税込</span>
        </p>
        <a href={company.phoneTelLink} class="px-cta px-cta-hero" data-cta="px_hero_tel"
           aria-label={`電話で相談 ${company.phoneDisplay} 通話無料・24時間受付`}>
          <span class="px-cta-icon" aria-hidden="true"><svg><use href="#px-phone" /></svg></span>
          <span class="px-cta-body">
            <span class="px-cta-lead px-cta-lead-lg">今すぐ電話で相談する</span>
            <span class="px-cta-note">24時間365日受付中・通話無料</span>
          </span>
          <span class="px-seal" aria-hidden="true"><b>24時間</b><span>受付</span></span>
        </a>
        <a href={company.lineUrl} class="px-line" data-cta="px_hero_line" rel="noopener" target="_blank">
          <svg aria-hidden="true"><use href="#px-line" /></svg>電話が難しい方は <b>LINEで巣の写真を送る</b>
        </a>
      </div>
      </div>
    </section>

    <!-- ===== ② トラストメダル ===== -->
    <section class="px-medals-sec" aria-label="サービスの強み">
      <div class="px-wrap">
        <ul class="px-medals" role="list">
          {medals.map((m) => (
            <li class="px-medal">
              <svg class="px-laurel" aria-hidden="true"><use href="#px-laurel" /></svg>
              <span class="px-medal-in">
                <svg class="px-medal-ico" aria-hidden="true"><use href={`#px-i-${m.icon}`} /></svg>
                <span class="px-medal-cap">{m.cap}</span>
                <span class="px-medal-num font-num">{m.num}<small>{m.unit}</small></span>
              </span>
              <span class="px-medal-label">{m.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== ④ 料金プラン ===== -->
    <section class="px-sec px-cream" id="price" aria-labelledby="px-price-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">PRICE</p>
        <h2 id="px-price-t" class="px-h2">明朗な<span class="px-red">料金プラン</span></h2>
        <p class="px-lead">基本1,680円〜・中間業者を挟まない自社価格。作業前に確定見積を提示し、<strong>その金額から追加請求はありません</strong>。</p>
        <div class="px-table-wrap">
          <table class="px-table">
            <thead><tr><th>作業内容</th><th>料金（税込）</th><th>対応蜂の種類</th><th>作業時間</th></tr></thead>
            <tbody>
              {priceRows.map((r) => (
                <tr class={r.hot ? "px-row-hot" : ""}>
                  <th scope="row">{r.work}</th>
                  <td class="px-price-cell font-num">{r.price}</td>
                  <td>{r.kind}</td>
                  <td class="px-time">{r.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="px-free" role="list">
          <li><svg aria-hidden="true"><use href="#px-check" /></svg>出張・現地調査・見積り 0円</li>
          <li><svg aria-hidden="true"><use href="#px-check" /></svg>キャンセル料 0円</li>
          <li><svg aria-hidden="true"><use href="#px-check" /></svg>事前見積からの追加請求なし</li>
        </ul>
        <a href={company.phoneTelLink} class="px-cta px-cta-light" data-cta="px_price_tel">
          <span class="px-cta-icon" aria-hidden="true"><svg><use href="#px-phone" /></svg></span>
          <span class="px-cta-body">
            <span class="px-cta-lead">この金額のまま相談する（通話無料）</span>
            <span class="px-cta-num font-num">{company.phoneDisplay}</span>
          </span>
        </a>
      </div>
    </section>

    <!-- ===== ⑤ 他社比較 ===== -->
    <section class="px-sec" id="compare" aria-labelledby="px-cmp-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">COMPARE</p>
        <h2 id="px-cmp-t" class="px-h2">当社と<span class="px-red">仲介業者</span>の違い</h2>
        <div class="px-table-wrap">
          <table class="px-table px-cmp">
            <thead><tr><th></th><th class="px-cmp-us">当社</th><th>仲介サイト</th></tr></thead>
            <tbody>
              {compareLabels.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td class="px-ok"><svg aria-hidden="true"><use href="#px-check" /></svg>{row.us.text}</td>
                  <td class="px-bad">{row.intermediary.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <a href={company.phoneTelLink} class="px-cta px-cta-light" data-cta="px_compare_tel">
          <span class="px-cta-icon" aria-hidden="true"><svg><use href="#px-phone" /></svg></span>
          <span class="px-cta-body">
            <span class="px-cta-lead">取次なし・自社に直接相談</span>
            <span class="px-cta-num font-num">{company.phoneDisplay}</span>
          </span>
        </a>
      </div>
    </section>

    <!-- ===== ⑥ 反論ミニFAQ ===== -->
    <section class="px-sec px-cream" aria-labelledby="px-mfaq-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">Q&amp;A</p>
        <h2 id="px-mfaq-t" class="px-h2">電話の前に、<span class="px-red">不安をゼロに</span></h2>
        <div class="px-faq-list">
          {miniFaqs.map((f) => (<details class="px-faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <!-- ===== ⑦ 施工事例 ===== -->
    <section class="px-sec" id="cases" aria-labelledby="px-cases-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">WORKS</p>
        <h2 id="px-cases-t" class="px-h2">場所・蜂種・<span class="px-red">実額</span>まで公開</h2>
        <div class="px-cases">
          {displayCases.map((c) => (
            <article class="px-case">
              <img src={assetPath(`images/cases/${c.imageBase}.webp`)} width="360" height="240" alt={c.title} loading="lazy" decoding="async" />
              <div class="px-case-b">
                <p class="px-case-area">{c.area}・{c.location}</p>
                <h3>{c.title}</h3>
                <p class="px-case-price font-num">¥{c.priceJpy.toLocaleString("ja-JP")}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== ⑧ お客様の声 ===== -->
    <section class="px-sec px-cream" id="voices" aria-labelledby="px-voices-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">VOICE</p>
        <h2 id="px-voices-t" class="px-h2">お客様の声</h2>
        <div class="px-voices">
          {displayVoices.map((v) => (
            <blockquote class="px-voice">
              <div class="px-voice-head">
                <span class="px-avatar" aria-hidden="true"><svg><use href="#px-user" /></svg></span>
                <span class="px-voice-meta"><span class="px-stars" aria-label="5点満点中5点"><svg><use href="#px-star"/></svg><svg><use href="#px-star"/></svg><svg><use href="#px-star"/></svg><svg><use href="#px-star"/></svg><svg><use href="#px-star"/></svg></span><b class="font-num">5.0</b></span>
              </div>
              <p class="px-voice-c">{v.comment}</p>
              <footer>{v.area}・{v.ageBracket}（{v.service}）</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== ⑨ FAQ ===== -->
    <section class="px-sec" id="faq" aria-labelledby="px-faq-t">
      <div class="px-wrap px-narrow">
        <p class="px-tag">FAQ</p>
        <h2 id="px-faq-t" class="px-h2">よくあるご質問</h2>
        <div class="px-faq-list">
          {fullFaqs.map((f) => (<details class="px-faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <!-- ===== 緊急・損失回避（最終CTA前のダメ押し） ===== -->
    <section class="px-urgent" aria-labelledby="px-urgent-t">
      <div class="px-wrap px-narrow">
        <h2 id="px-urgent-t" class="px-h2 px-on-dark">巣は1日で<span class="px-gold">約3cm</span>拡大します</h2>
        <p class="px-urgent-sub">今日のお電話が、明日の費用を<strong>半分以下</strong>にすることがあります。大きくなるほど作業も費用も増えます。<strong>今この瞬間が、いちばん小さい巣です。</strong></p>
        <a href={company.phoneTelLink} class="px-cta px-cta-band" data-cta="px_urgent_tel">
          <span class="px-cta-icon" aria-hidden="true"><svg><use href="#px-phone" /></svg></span>
          <span class="px-cta-body">
            <span class="px-cta-lead">迷う前に、今すぐ無料相談</span>
            <span class="px-cta-num font-num">{company.phoneDisplay}</span>
          </span>
        </a>
      </div>
    </section>

    <!-- ===== ⑩ 最終CTA（ダーク） ===== -->
    <section class="px-final" id="contact" aria-labelledby="px-final-t">
      <img class="px-final-hornet" src={assetPath("images/generated/hornet.webp")} alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="px-wrap px-narrow">
        <p class="px-final-eye">蜂の巣のことなら、どんなことでもご相談ください</p>
        <h2 id="px-final-t" class="px-final-t">24時間365日、<span class="px-gold">いつでも受付中！</span></h2>
        <a href={company.phoneTelLink} class="px-cta px-cta-hero px-cta-final" data-cta="px_final_tel">
          <span class="px-cta-icon" aria-hidden="true"><svg><use href="#px-phone" /></svg></span>
          <span class="px-cta-body">
            <span class="px-cta-lead">タップして今すぐ電話（通話無料）</span>
            <span class="px-cta-num font-num">{company.phoneDisplay}</span>
            <span class="px-cta-note">最短30分で出動・当日対応率{company.sameDayRate}%</span>
          </span>
          <span class="px-seal" aria-hidden="true"><b>24時間</b><span>受付</span></span>
        </a>
        <a href={company.lineUrl} class="px-line px-line-dark" data-cta="px_final_line" rel="noopener" target="_blank">
          <svg aria-hidden="true"><use href="#px-line" /></svg>LINEで巣の写真を送って概算見積り
        </a>
      </div>
    </section>

    <!-- ===== フッター ===== -->
    <footer class="px-footer">
      <div class="px-wrap px-narrow">
        <p class="px-foot-name">{company.name}（{company.legalName}）</p>
        <p class="px-foot-info">{company.address.region}{company.address.city}{company.address.street}<br />対応エリア: {company.serviceArea}<br />受付: {company.hours} ／ {company.businessType}</p>
        <p class="px-foot-copy">© <span id="px-year">2026</span> {company.name}</p>
      </div>
    </footer>

    <!-- ===== 追従CTA ===== -->
    <div class="px-sticky" role="complementary" aria-label="お問い合わせ">
      <a href={company.phoneTelLink} class="px-sticky-tel" data-cta="px_sticky_tel">
        <svg aria-hidden="true"><use href="#px-phone" /></svg><span>電話で相談<small>24時間・通話無料</small></span>
      </a>
      <a href={company.lineUrl} class="px-sticky-line" data-cta="px_sticky_line" rel="noopener" target="_blank">
        <svg aria-hidden="true"><use href="#px-line" /></svg><span>LINE<small>写真で見積</small></span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .px {
