---
import { getCollection } from "astro:content";
import { company } from "../../data/company";
import { assetPath } from "../../lib/site";
import SiteFooter from "../../components/SiteFooter.astro";

const posts = (await getCollection("column")).sort(
  (a, b) => +b.data.publishDate - +a.data.publishDate,
);
const title = `蜂の知識・料金コラム｜${company.name}`;
const desc = `蜂の巣駆除の料金相場・自分でできる範囲・蜂の種類の見分け方など、${company.serviceArea}のプロが解説するコラム一覧。`;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={new URL("/column/", Astro.site).href} />
<meta name="theme-color" content="#0f766e" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
:root{--bg:#fbfaf8;--card:#fff;--ink:#1f2328;--sub:#5b6068;--line:#e7e6e2;--teal:#0f766e;--teal-bg:#e7f3f1;
  --disp:"Zen Kaku Gothic New",system-ui,sans-serif;--sans:"Noto Sans JP",system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.8}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
.topbar{border-bottom:1px solid var(--line);background:var(--card)}
.topbar .in{max-width:1040px;margin:0 auto;padding:13px 22px;display:flex;justify-content:space-between;align-items:center}
.topbar .logo{font-family:var(--disp);font-weight:900;font-size:15px;text-decoration:none;color:var(--ink)}
.topbar .pill{font-size:11px;font-weight:700;color:var(--teal);background:var(--teal-bg);padding:4px 10px;border-radius:999px}
.head{padding:34px 0 18px}
.head h1{font-family:var(--disp);font-weight:900;font-size:clamp(24px,4vw,34px)}
.head p{color:var(--sub);font-size:14px;margin-top:8px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;padding:10px 0 50px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;text-decoration:none;color:inherit;transition:.2s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-3px);box-shadow:0 16px 30px -22px rgba(15,118,110,.5)}
.card img{width:100%;height:160px;object-fit:cover}
.card .b{padding:15px 16px}
.card .cat{font-size:11px;font-weight:900;color:var(--teal);font-family:var(--disp)}
.card h2{font-family:var(--disp);font-weight:900;font-size:16px;line-height:1.5;margin:6px 0}
.card p{font-size:12.5px;color:var(--sub);line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
</style>
</head>
<body>
<header class="topbar"><div class="in"><a class="logo" href="/">{company.name}</a><span class="pill">蜂の知識</span></div></header>
<div class="wrap">
  <div class="head"><h1>蜂の知識・料金コラム</h1><p>{company.serviceArea}のプロが、料金・安全な対処・蜂の見分け方をやさしく解説します。</p></div>
  <div class="grid">
    {posts.map((p) => (
      <a class="card" href={`/column/${p.id}/`}>
        <img src={assetPath(p.data.heroImage)} alt={p.data.heroAlt} width="280" height="160" />
        <div class="b">
          <div class="cat">{p.data.category}</div>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</div>
<SiteFooter />
</body>
</html>
