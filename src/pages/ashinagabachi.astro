---
/**
 * アシナガバチ特化 集客LP (/ashinagabachi)
 * AG3-蜂種特化（アシナガバチ 駆除 系KW）の着地。クエリ⇄LP関連性を最大化しLP体験QSを上げる。
 * - index.astro / nagoya.astro は一切改変しない（QS履歴維持のため独立ページ）
 * - Layout / CtaDual / StaffCard を流用、デザインは nagoya.astro と同一（.xhero / .ng トークン）
 * - コンテンツは column/ashinagabachi-kujo.md（KW実データ+VoC検証済）の説得構造を広告着地用に凝縮
 * - honest厳守：捏造数値なし（実績数/満足度/年数/保険/静岡は出さない）
 * - noindex：広告専用着地のためdoorway/重複回避（Ad QSはnoindexでも評価される）
 */
import Layout from "../layouts/Layout.astro";
import CtaDual from "../components/CtaDual.astro";
import StaffCard from "../components/StaffCard.astro";
import LocationCard from "../components/LocationCard.astro";
import NestGrowthChart from "../components/NestGrowthChart.astro";
import { company } from "../data/company";
import { rates } from "../data/rates";
import {
  ashinagaAreas,
  ashinagaAreaNote,
  ashinagaCases,
  ashinagaVoices,
} from "../data/ashinagabachi";
import { assetPath, homePath } from "../lib/site";

const title = "アシナガバチ駆除は名古屋の自社施工が最短30分｜追加0円・1年保証｜蜂の巣駆除ファクトリー東海";
const description =
  "アシナガバチの巣の駆除は東海の自社スタッフが最短30分で直接対応。名古屋の相場8,000〜20,000円が中心、上限つきの明朗会計・見積後の追加請求0円・1年保証。玄関・ベランダ・軒下・室外機の巣、駆除すべきかの相談だけでもOK。受付は電話7時〜21時・LINE24時間。";
const a = company.address;
const rateImg: Record<string, string> = {
  "アシナガバチ": "ashinagabachi",
  "スズメバチ": "suzumebachi",
  "ミツバチ": "mitsubachi",
  "オオスズメバチ": "oosuzumebachi",
  "クマバチ・その他": "kumabachi",
};
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(homePath, siteUrl).toString();

/** 駆除すべきかの判断基準（記事の判断表を広告着地用に凝縮） */
const judge = [
  { level: "駆除推奨", tone: "danger", text: "玄関・通路・ベランダ・物干し場・室外機まわりなど、毎日人が通る場所に巣がある" },
  { level: "駆除推奨", tone: "danger", text: "小さなお子さん・ペットが遊ぶ庭や、隣家に近い場所に巣がある" },
  { level: "駆除推奨", tone: "danger", text: "同じ場所で毎日アシナガバチを見かける・1匹がうろうろしている（巣作りのサイン）" },
  { level: "様子見も可", tone: "ok", text: "開け閉めしない窓の外や、人がほとんど近づかない場所に巣がある" },
];

/** 巣の大きさ×料金の視覚図（早い＝小さい＝安い）。相場: 名古屋8,000〜20,000中心・巣は最大20cm前後 */
const ashinagaStages = [
  { term: "5〜6月", size: "小さな初期巣・〜8cm", price: "基本料金のみ", tone: "ok" as const, dot: 32 },
  { term: "7〜8月", size: "握りこぶし大・10〜15cm", price: "目安 +4,000〜5,000円", tone: "warn" as const, dot: 52 },
  { term: "9月〜", size: "最大級・〜20cm", price: "上限19,800円まで", tone: "danger" as const, dot: 66 },
];

const faq = [
  {
    q: "アシナガバチは益虫と聞きました。駆除していいのでしょうか？",
    a: "毛虫などを食べる益虫の一面は本当です。ただし玄関・ベランダ・軒下など生活動線の近くに巣がある場合は、多くの自治体も早めの駆除を推奨しています。判断に迷う場合は、巣の場所を電話でお伝えいただければ「駆除すべきかどうか」からご相談に乗ります。",
  },
  {
    q: "小さい巣なら自分で駆除できますか？",
    a: "巣が5cm以下・手が届く低さ・蜂用スプレーと防護の用意がある場合に限り、自力駆除も可能です。ただし6月以降は働き蜂が増えてこの条件から外れることがほとんどです。落とした後の幼虫の処理も含め、少しでも不安があれば無理をしないでください。見積もりは無料です。",
  },
  {
    q: "アシナガバチを一匹殺すと仲間が来るというのは本当ですか？",
    a: "アシナガバチも危険を感じると警報フェロモンを出し、巣の仲間を刺激します。巣の近くで叩き潰すのは危険です。1匹だけ飛んでいる場合は、刺激せず静かに離れてください。",
  },
  {
    q: "巣を放置するとどうなりますか？",
    a: "夏に向けて働き蜂が増え、刺されるリスクと駆除費用の両方が上がります。また巣があった場所は翌年も巣を作られやすくなります。当社は駆除とあわせて再発防止の処理まで行い、1年保証をお付けしています。",
  },
  {
    q: "駆除した後、蜂が戻ってきませんか？",
    a: "駆除時に外出していた「戻り蜂」が数日残ることがありますが、巣がなければやがていなくなります。市販スプレーは表面の成虫だけになりがちで、巣や幼虫が残ると再び営巣します。当社は巣ごと撤去し戻り蜂まで確認するので、再発しにくいのが違いです。保証期間内に同じ場所に再発したら、無料でもう一度うかがいます。",
  },
  {
    q: "賃貸・アパートのベランダに巣ができました。相談できますか？",
    a: "はい、そのままご相談ください。賃貸・アパートのベランダや共用部の巣も対応します。大家さん・管理会社への説明が必要な場合も、どう伝えればよいかからお手伝いします。",
  },
];

const ashinagaJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "アシナガバチ駆除" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "アシナガバチ駆除",
    provider: {
      "@type": "LocalBusiness",
      name: company.name,
      telephone: company.phone,
      address: {
        "@type": "PostalAddress",
        postalCode: a.postal,
        addressRegion: a.region,
        addressLocality: a.city,
        streetAddress: a.street,
      },
    },
    areaServed: [
      { "@type": "AdministrativeArea", name: "愛知県" },
      { "@type": "AdministrativeArea", name: "岐阜県南部" },
      { "@type": "AdministrativeArea", name: "三重県北部" },
    ],
    offers: { "@type": "Offer", price: 8000, priceCurrency: "JPY" },
  },
];
---

<Layout title={title} description={description} noindex={true} extraJsonLd={ashinagaJsonLd}>
  <!-- sr-only 実h1（アシナガバチ・QS） -->
    <h1 class="x-sr">アシナガバチ駆除｜東海の自社スタッフが最短30分で現場到着・名古屋の相場8,000〜20,000円が中心・上限つきの明朗会計・追加0円・1年保証・当日対応98%・受付は電話7時〜21時／LINE24時間 {company.phoneDisplay}</h1>

    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
      <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4 L8 4 L10 9 L7.5 11 C8.7 13.5 10.5 15.3 13 16.5 L15 14 L20 16 L20 19 C20 20.1 19.1 21 18 21 C10.3 21 4 14.7 4 7 C4 5.9 4.9 5 6 5"/></symbol>
    </svg>

    <!-- ===== HERO（元LPの焼込みチラシを流用・アシナガバチ化／2:3固定・%絶対配置） ===== -->
    <div class="xhero">
      <img class="xh-photo" src={assetPath("images/generated/hero-mob-photo-ashinaga.webp")} width="1024" height="418"
        alt="蜂駆除の専門スタッフが専用工具で軒下のアシナガバチの巣を取り除く様子" loading="eager" decoding="async" fetchpriority="high" />
      <div class="xh-bar" aria-hidden="true">アシナガバチ駆除・東海対応・<b>最短30分</b>で出動</div>
      <div class="xh-brand">
        <img class="xh-logo" src={assetPath("images/generated/hero-bee-logo.webp")} width="132" height="120" alt="" aria-hidden="true" />
        <span class="xh-btext"><b class="xh-bname">{company.name}</b><small class="xh-btag">アシナガバチ・蜂の巣駆除の専門対応</small></span>
        <a class="xh-headtel" href={company.phoneTelLink} data-cta="ashinaga_header_tel">
          <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
          <span class="xh-headtel-tx"><b class="font-num">{company.phoneDisplay}</b><small>受付7時〜21時</small></span>
        </a>
      </div>
      <div class="xh-banner" aria-hidden="true"><span><em>そのまま放置</em><i>すると</i><b>危険！</b></span></div>
      <p class="xh-h1 xh-h1--ag" aria-hidden="true">アシナガバチ駆除</p>
      <p class="xh-h2" aria-hidden="true">早期対応・安全駆除・清掃まで</p>
      <p class="xh-price" aria-hidden="true">
        <span class="xhp-cell"><small>最短</small><b class="xhp-num">30</b><small>分</small></span>
        <span class="xhp-div"></span>
        <span class="xhp-cell"><small>今日中に</small><b class="xhp-num">スッキリ</b></span>
      </p>
      <a class="xh-cta" href={company.phoneTelLink} data-cta="ashinaga_hero_tel">
        <svg class="xic" aria-hidden="true"><use href="#i-phone" /></svg>
        <span class="xh-cta-tx">
          <small class="xh-cta-top">＼今すぐお電話で不安も駆除／</small>
          <b class="xh-cta-num font-num">{company.phoneDisplay}</b>
          <small class="xh-cta-bot">通話無料・受付7時〜21時・タップで発信</small>
        </span>
      </a>
      <span class="xh-now" aria-hidden="true"><i class="xh-now-dot"></i><span class="xh-now-tx">ただ今受付中</span></span>
      <span class="xcpn" aria-hidden="true"><span class="xcpn-body"><b class="xcpn-l1">電話で</b><b class="xcpn-l2">10<i>%</i></b><b class="xcpn-l3">OFF</b></span></span>
      <ul class="xh-trust" aria-hidden="true">
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="13" r="8"/><path d="M12 13 V9 M12 13 l3 2 M9 3 h6"/></svg>
          <span><small>最短</small><b>30<em>分</em></b><small>で現場到着</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z"/><path class="xht-chk" d="M8.5 12 l2.5 2.5 L16 9"/></svg>
          <span><small>安心の</small><b>1<em>年</em></b><small>保証</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic"><circle cx="12" cy="12" r="9"/><text x="12" y="15.5" class="xht-y0">¥0</text></svg>
          <span><small>見積後</small><b>追加0<em>円</em></b><small>明朗会計</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" class="xht-ic xht-fill"><path d="M4 11 L12 4 L20 11 V21 H4 Z"/></svg>
          <span><small>当日対応</small><b>98<em>%</em></b><small>迅速対応</small></span>
        </li>
      </ul>
    </div>

    <div class="ng">
    <!-- 駆除すべきかの判断（アシナガバチ固有・記事の核） -->
    <section class="ng-sec">
      <h2 class="ng-h2">アシナガバチは駆除すべき？<br class="spx" />答えは「巣の場所」で決まります</h2>
      <p class="ng-note">アシナガバチは毛虫を食べる<b>益虫の一面もある蜂</b>。だから迷うのは当然です。判断基準はシンプルで、<b>生活動線の近くに巣があるかどうか</b>。おとなしい蜂でも、洗濯物に紛れた1匹に触れれば刺されます。</p>
      <ul class="ag-judge">
        {judge.map((j) => (
          <li class={`ag-j ag-j--${j.tone}`}>
            <span class="ag-j-badge">{j.level}</span>
            <span class="ag-j-text">{j.text}</span>
          </li>
        ))}
      </ul>
      <p class="ng-mini">※ 多くの自治体も「生活に支障のある場所の巣は早めの駆除」を案内しています。迷ったら巣の場所だけ教えてください。駆除すべきかからご相談に乗ります。</p>
    </section>

    <CtaDual id="ashinaga_judge_cta" lead="「駆除したほうがいい？」の相談だけでもOK" />

    <!-- 巣の特徴・時期（早いほど安い） -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">アシナガバチの巣は<br class="spx" />「早いほど安全・安価」</h2>
      <p class="ng-note">シャワーヘッド型で<b>六角形の巣穴がむき出し</b>ならアシナガバチの巣。巣は夏に向けて急成長し、<b>駆除の手間も費用も上がっていきます</b>。</p>
      <NestGrowthChart stages={ashinagaStages} cap="巣は夏に向けて急成長します。8cm前後の“今”なら基本料金のみ、10〜15cmで目安+4,000〜5,000円と、手間も費用も増えていきます（金額は目安）。早く呼ぶほど、費用も危険も抑えられます。" />
      <p class="ng-note ng-note-follow">巣ができやすいのは<b>軒下・ベランダ・室外機まわり・窓のシャッターボックス・庭木</b>。「同じ場所で毎日蜂を見かける」は巣作りのサインです。</p>
    </section>

    <!-- 料金（アシナガバチのみ・上限つきレンジ） -->
    <section class="ng-sec">
      <h2 class="ng-h2">アシナガバチ駆除 料金のご案内</h2>
      <p class="ng-note">アシナガバチは巣が小さく（最大20cm前後）、蜂の中でも<b>安価に駆除できる部類</b>。名古屋の相場は<b>8,000〜20,000円</b>が中心です。当社は標準ケースの<b>上限をはっきり決めて青天井にしません</b>。ご予算のご相談も承ります。出張費・見積り・キャンセルは<b>0円</b>です。</p>
      <div class="ng-rate2">
        <div class="ng-rate2-row">
          <span class="ng-rate2-name">アシナガバチ<small>キアシナガ・セグロアシナガほか</small></span>
          <span class="ng-rate2-price"><small>標準ケース上限</small><b>19,800円</b></span>
          <span class="ng-rate2-cap">青天井なし</span>
        </div>
      </div>
      <div class="ng-incl">
        <div class="ng-incl-col ng-incl-in">
          <b class="ng-incl-h">この料金に含まれるもの</b>
          <ul>
            <li>出張費・見積り・キャンセル 0円</li>
            <li>蜂の駆除・巣の完全撤去</li>
            <li>戻り蜂対策・巣跡の処理</li>
            <li>1年再発保証（同じ場所への再営巣に無償で再訪問）</li>
          </ul>
        </div>
        <div class="ng-incl-col ng-incl-add">
          <b class="ng-incl-h">現場によって加算されるもの</b>
          <ul>
            <li>巣の大きさ（10cm未満は基本のみ／育つほど加算）</li>
            <li>高さ・難所（ベランダ・室外機・シャッター内）</li>
            <li>殺菌・消毒の程度</li>
            <li>再発防止剤（追加の薬剤）</li>
          </ul>
        </div>
      </div>
      <p class="ng-mini"><b>お電話で概算 → 現地で総額を確定 → ご納得のうえで作業。確定後の追加請求はありません。</b><br />※ 一般的な軒下・ベランダの巣や戻り蜂の対応は、<b>上限19,800円の範囲内</b>です。上限の対象外になるのは〈高所作業車が必要・別建物や別箇所の複数施工〉などの特殊なケースのみで、その場合はお電話の概算時に先にお伝えします。<br />※ 保証の「同じ場所」＝施工箇所とおおむね同一部位への再営巣を指します。<br />※ スズメバチの巣だった場合もそのまま対応できます（見分けがつかなくても大丈夫です）。</p>
    </section>
    <style>
      .ng-rate2{border:1px solid #eadfce;border-radius:14px;overflow:hidden;background:#fff;margin:12px 0 0;box-shadow:0 2px 10px rgba(60,40,10,.06)}
      .ng-rate2-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid #f0e8da}
      .ng-rate2-row:last-child{border-bottom:none}
      .ng-rate2-name{font-weight:900;font-size:14.5px;color:#2a2118;display:flex;flex-direction:column}
      .ng-rate2-name small{font-size:10.5px;font-weight:700;color:#8a7c66;margin-top:2px}
      .ng-rate2-price{text-align:right;white-space:nowrap;line-height:1.15}
      .ng-rate2-price small{display:block;font-size:9.5px;color:#8a7c66;font-weight:700}
      .ng-rate2-price b{font-size:20px;font-weight:900;color:#c8321f;font-variant-numeric:tabular-nums}
      .ng-rate2-cap{font-size:11px;font-weight:800;color:#2f8f52;background:#eaf6ee;border-radius:999px;padding:4px 10px;white-space:nowrap}
      .ng-incl{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0 0}
      .ng-incl-col{border:1px solid #eadfce;border-radius:12px;padding:12px 14px;background:#fff}
      .ng-incl-in{border-left:4px solid #2f8f52} .ng-incl-add{border-left:4px solid #d98a1a}
      .ng-incl-h{display:block;font-size:12.5px;font-weight:900;margin-bottom:7px}
      .ng-incl-in .ng-incl-h{color:#2f8f52} .ng-incl-add .ng-incl-h{color:#c07a12}
      .ng-incl-col ul{margin:0;padding:0;list-style:none}
      .ng-incl-col li{font-size:12px;color:#4a3f2e;line-height:1.55;margin:4px 0;padding-left:16px;position:relative}
      .ng-incl-in li::before{content:"✓";position:absolute;left:0;color:#2f8f52;font-weight:900}
      .ng-incl-add li::before{content:"＋";position:absolute;left:0;color:#c07a12;font-weight:900}
      @media(max-width:520px){.ng-incl{grid-template-columns:1fr}}
      @media(max-width:400px){.ng-rate2-row{grid-template-columns:1fr auto;row-gap:4px}.ng-rate2-cap{grid-column:2;justify-self:end}}
    </style>
    </section>

    <CtaDual id="ashinaga_rate_cta" lead="早く呼ぶほど、安く・安全に終わります。写真だけの概算もOK" />

    <!-- アシナガバチの施工事例 -->
    <section class="ng-sec ng-sec-tint">
      <h2 class="ng-h2">アシナガバチの施工事例</h2>
      <div class="ng-cases">
        {ashinagaCases.map((c) => (
          <a class="ng-case" href={company.phoneTelLink} data-cta="ashinaga_case_dial" aria-label={`${c.area}の${c.beeType}駆除を電話で相談`}>
            <img src={assetPath(`images/cases/${c.imageBase}.webp`)} width="320" height="210"
              alt={`${c.area} ${c.title}`} loading="lazy" decoding="async" />
            <div class="ng-case-b">
              <div class="ng-tags"><span>{c.beeType}</span><span>{c.area}</span><span>{c.location}</span></div>
              <h3>{c.title}</h3>
              <p class="ng-case-price">現地確定見積 <b>{c.priceJpy.toLocaleString()}円</b>（税込）</p>
            </div>
          </a>
        ))}
      </div>
      <p class="ng-mini">※ 事例写真は実案件をもとにプライバシー保護のため再現したものです。金額は巣のサイズ・場所により変動します。</p>
    </section>

    <CtaDual id="ashinaga_proof_cta" lead="同じような場所に巣がある方は、今すぐご相談ください" />

    <!-- お客様の声 -->
    <section class="ng-sec">
      <h2 class="ng-h2">アシナガバチ駆除のお客様の声</h2>
