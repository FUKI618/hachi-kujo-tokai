---
import Layout from "../../layouts/Layout.astro";
import { assetPath } from "../../lib/site";
import { company } from "../../data/company";
import { rates } from "../../data/rates";
import { beeTypes } from "../../data/bee-types";
import { flowSteps } from "../../data/flow";
import { areas } from "../../data/areas";
import { faqs } from "../../data/faq";

const title = `名古屋・愛知の蜂の巣駆除｜基本1,680円〜・最短30分｜${company.name}`;
const description =
  "名古屋・愛知の蜂の巣駆除。24時間365日受付、最短30分で出動。出張・現地調査・見積り無料。作業前に確定金額をご提示し、同意なく作業しません。";

const featuredBees = beeTypes.slice(0, 4);
const featuredFaqs = [faqs[0], faqs[1], faqs[4], faqs[8], faqs[18]];
---

<Layout title={title} description={description}>
  <div class="cv-page">
    <header class="cv-header">
      <div class="cv-shell cv-header-inner">
        <a class="cv-brand" href="/improved/" aria-label="改善版LPのトップへ">
          <img src={assetPath("logo.svg")} width="48" height="48" alt="" />
          <span>
            <small>名古屋・愛知の蜂の巣駆除</small>
            <strong>{company.name}</strong>
          </span>
        </a>
        <div class="cv-header-actions">
          <a class="cv-header-line" href={company.lineUrl} data-cta="improved_header_line">
            LINE相談
          </a>
          <a class="cv-header-tel" href={company.phoneTelLink} data-cta="improved_header_tel">
            <small>24時間受付</small>
            <strong>{company.phoneDisplay}</strong>
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="cv-hero" aria-labelledby="improved-hero-title">
        <div class="cv-shell">
          <p class="cv-hero-alert"><span>最短30分</span> 名古屋・近郊へ即日出動</p>

          <div class="cv-hero-grid">
            <div class="cv-hero-copy">
              <p class="cv-kicker">蜂を見つけたら、近づかずにお電話ください</p>
              <h1 id="improved-hero-title">
                危険な蜂の巣を<br />
                <em>今日、安全に駆除。</em>
              </h1>
              <ul class="cv-hero-points" aria-label="主な安心材料">
                <li>出張・現地調査・見積り <strong>0円</strong></li>
                <li>作業前に <strong>確定金額を提示</strong></li>
                <li>同一箇所の再営巣 <strong>1年保証</strong></li>
              </ul>
            </div>

            <figure class="cv-hero-visual">
              <img
                src={assetPath("images/generated/hero-action.webp")}
                width="768"
                height="512"
                alt="防護装備で蜂の巣を駆除するスタッフのイメージ"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <figcaption>※写真はイメージです</figcaption>
              <span class="cv-hero-badge">24時間<br /><strong>365日</strong><br />受付</span>
            </figure>
          </div>

          <div class="cv-offer" aria-label="料金と無料項目">
            <div class="cv-offer-price">
              <span>蜂の巣駆除 基本料金</span>
              <strong><small>税込</small>1,680<em>円〜</em></strong>
            </div>
            <div class="cv-offer-free">
              <b>無料</b>
              <span>出張費</span>
              <span>現地調査</span>
              <span>見積り</span>
              <span>作業前キャンセル</span>
            </div>
            <p>
              ※蜂の種類、巣の大きさ・高さ・場所により料金は変動します。
              現地確認後、作業前に確定金額をお伝えします。
            </p>
          </div>

          <div class="cv-hero-cta" aria-label="お問い合わせ">
            <a class="cv-call" href={company.phoneTelLink} data-cta="improved_hero_tel">
              <span class="cv-call-icon">☎</span>
              <span><small>お急ぎの方はこちら</small><strong>{company.phoneDisplay}</strong><em>通話無料・タップで発信</em></span>
            </a>
            <a class="cv-line" href={company.lineUrl} data-cta="improved_hero_line">
              <b>LINE</b>
              <span><strong>巣の写真を送って相談</strong><small>所在地と写真で概算をご案内</small></span>
            </a>
          </div>
        </div>
      </section>

      <section class="cv-problem">
        <div class="cv-shell">
          <h2>こんな状況でも、そのままご相談ください</h2>
          <div class="cv-problem-grid">
            <div><img src={assetPath("images/generated/emergency-nest-eaves.webp")} alt="軒下の蜂の巣のイメージ" width="320" height="220" loading="lazy" /><strong>軒下・ベランダに巣</strong></div>
            <div><img src={assetPath("images/bee-types/suzumebachi.webp")} alt="スズメバチ" width="320" height="220" loading="lazy" /><strong>大きな蜂が出入り</strong></div>
            <div><img src={assetPath("images/generated/clean-eaves-after-removal.webp")} alt="屋根まわりのイメージ" width="320" height="220" loading="lazy" /><strong>屋根裏・室外機まわり</strong></div>
          </div>
          <p>蜂の種類や巣の場所が分からなくても問題ありません。状況の確認から対応します。</p>
        </div>
      </section>

      <section class="cv-section cv-price" id="price" aria-labelledby="improved-price-title">
        <div class="cv-shell">
          <p class="cv-section-label">PRICE</p>
          <h2 id="improved-price-title">駆除料金の目安</h2>
          <p class="cv-section-lead">安い下限額だけで契約を迫りません。現地で状態を確認し、作業前に総額をご説明します。</p>

          <div class="cv-price-table">
            {rates.map((rate) => (
              <article>
                <div>
                  <strong>{rate.beeType}</strong>
                  <small>{rate.workCondition}</small>
                </div>
                <p>{rate.basicPrice}</p>
              </article>
            ))}
          </div>

          <div class="cv-price-note">
            <strong>料金が変わる主な条件</strong>
            <span>蜂の種類</span><span>巣の大きさ</span><span>高さ</span><span>屋根裏・壁内などの難所</span>
          </div>

          <div class="cv-inline-cta">
            <p><strong>料金だけ知りたい方も歓迎。</strong>見積り後に断っても費用はかかりません。</p>
            <a href={company.phoneTelLink} data-cta="improved_price_tel">無料で料金を確認する <span>☎ {company.phoneDisplay}</span></a>
          </div>
        </div>
      </section>

      <section class="cv-section cv-reasons" aria-labelledby="improved-reasons-title">
        <div class="cv-shell">
          <p class="cv-section-label">WHY US</p>
          <h2 id="improved-reasons-title">ご相談前の3つの安心</h2>
          <div class="cv-reason-grid">
            <article>
              <span>01</span>
              <h3>自社スタッフが直接対応</h3>
              <p>受付だけ行う全国仲介ではなく、名古屋・愛知の自社スタッフが現地対応。中間マージンを抑えます。</p>
            </article>
            <article>
              <span>02</span>
              <h3>作業前に金額を確定</h3>
              <p>内容と金額をご説明し、ご納得いただいてから作業開始。範囲変更が必要な場合も先にご相談します。</p>
            </article>
            <article>
              <span>03</span>
              <h3>駆除後も1年保証</h3>
              <p>同一箇所に同種の蜂が再営巣した場合は、保証範囲として無料で再駆除します。</p>
            </article>
          </div>
        </div>
      </section>

      <section class="cv-section cv-bees" id="bee-types" aria-labelledby="improved-bees-title">
        <div class="cv-shell">
          <p class="cv-section-label">BEE TYPES</p>
          <h2 id="improved-bees-title">危険な蜂から小型の巣まで対応</h2>
          <div class="cv-bee-grid">
            {featuredBees.map((bee) => (
              <article>
                <img src={assetPath(`images/bee-types/${bee.imageBase}.webp`)} alt={bee.name} width="240" height="180" loading="lazy" decoding="async" />
                <div>
                  <h3>{bee.name}</h3>
                  <p>{bee.nestLocation}</p>
                  <strong>{bee.priceRange}</strong>
                </div>
              </article>
            ))}
          </div>
          <p class="cv-bee-note">種類が分からない場合は、近づかずに写真またはお電話で状況をお知らせください。</p>
        </div>
      </section>

      <section class="cv-band">
        <div class="cv-shell">
          <p>蜂の巣を見つけたら、まず安全な場所へ</p>
          <h2>今すぐ作業を決める必要はありません。<br />無料見積りからご相談ください。</h2>
          <div>
            <a href={company.phoneTelLink} data-cta="improved_mid_tel">☎ {company.phoneDisplay}<small>24時間365日受付</small></a>
            <a href={company.lineUrl} data-cta="improved_mid_line">LINEで写真相談<small>写真と所在地を送信</small></a>
          </div>
        </div>
      </section>

      <section class="cv-section cv-safety" id="scam-warning" aria-labelledby="improved-safety-title">
        <div class="cv-shell">
          <p class="cv-section-label">BEFORE ORDER</p>
          <h2 id="improved-safety-title">業者選びで確認すること</h2>
          <div class="cv-safety-grid">
            <article>
              <b>確認 1</b>
              <h3>総額を作業前に聞く</h3>
              <p>基本料金だけで判断せず、巣の大きさ・高さ・作業範囲を含む総額を確認してください。</p>
            </article>
            <article>
              <b>確認 2</b>
              <h3>追加作業の扱いを聞く</h3>
              <p>追加作業が必要になった場合、作業前に説明と再見積りがあるか確認してください。</p>
            </article>
            <article>
              <b>確認 3</b>
              <h3>断った場合の費用を聞く</h3>
              <p>当社は作業前のキャンセル料、出張費、現地調査費、見積り料は0円です。</p>
            </article>
          </div>
        </div>
      </section>

      <section class="cv-section cv-government" id="vs-government" aria-labelledby="improved-government-title">
        <div class="cv-shell cv-government-inner">
          <div>
            <p class="cv-section-label">CITY OFFICE</p>
            <h2 id="improved-government-title">市役所が駆除しない場合も対応</h2>
            <p>自治体の多くは相談・業者紹介・防護服貸出が中心です。すぐに現地対応が必要な場合は当社へご相談ください。</p>
          </div>
          <a href={company.phoneTelLink} data-cta="improved_government_tel">対応可否を電話で確認</a>
        </div>
      </section>

      <section class="cv-section cv-flow" id="flow" aria-labelledby="improved-flow-title">
        <div class="cv-shell">
          <p class="cv-section-label">FLOW</p>
          <h2 id="improved-flow-title">ご相談から完了まで</h2>
          <ol>
            {flowSteps.map((step) => (
              <li id={`flow-step-${step.num}`}>
                <span>STEP {String(step.num).padStart(2, "0")}</span>
                <div><h3>{step.title}</h3><p>{step.description}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="cv-section cv-areas" id="area" aria-labelledby="improved-area-title">
        <div class="cv-shell">
          <p class="cv-section-label">SERVICE AREA</p>
          <h2 id="improved-area-title">名古屋市を拠点に出動</h2>
          <p class="cv-section-lead">{company.serviceArea}。到着時間は現在地と交通状況を確認して受付時にご案内します。</p>
          <div class="cv-area-grid">
            {areas.map((area) => (
              <article>
                <h3>{area.prefecture}</h3>
                <p>{area.cities.slice(0, 10).join("・")}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cv-section cv-faq" id="faq" aria-labelledby="improved-faq-title">
        <div class="cv-shell">
          <p class="cv-section-label">FAQ</p>
          <h2 id="improved-faq-title">よくあるご質問</h2>
          <div class="cv-faq-list">
            {featuredFaqs.map((faq, index) => (
              <details open={index === 0}>
                <summary><span>Q</span>{faq.q}</summary>
                <div><b>A</b><p>{faq.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="cv-contact" id="contact" aria-labelledby="improved-contact-title">
        <div class="cv-shell">
          <p>出張・現地調査・見積り無料</p>
          <h2 id="improved-contact-title">蜂の種類が分からなくても大丈夫です</h2>
          <p class="cv-contact-copy">安全な場所から、見えた状況だけお伝えください。受付後、対応可能時刻をご案内します。</p>
          <div class="cv-contact-grid">
            <a href={company.phoneTelLink} data-cta="improved_contact_tel">
              <small>お急ぎの方・電話で相談</small>
              <strong>☎ {company.phoneDisplay}</strong>
              <span>24時間365日受付・通話無料</span>
            </a>
            <a href={company.lineUrl} data-cta="improved_contact_line">
              <small>写真で状況を伝えたい方</small>
              <strong>LINEで無料相談</strong>
              <span>巣の写真と所在地を送信</span>
            </a>
          </div>
          <ul>
            <li>作業前キャンセル0円</li>
            <li>確定見積り後に作業</li>
            <li>作業完了後にお支払い</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="cv-footer">
      <div class="cv-shell">
        <strong>{company.name}</strong>
        <p>{company.legalName} ／ {company.address.region}{company.address.city}{company.address.street}</p>
        <nav aria-label="フッターナビゲーション">
          <a href="/legal/">特定商取引法に基づく表示</a>
          <a href="/privacy-policy/">プライバシーポリシー</a>
          <a href="/">現在のLPを見る</a>
        </nav>
      </div>
    </footer>

    <nav class="cv-fixed" aria-label="固定お問い合わせ">
      <a href={company.phoneTelLink} data-cta="improved_fixed_tel"><span>☎</span><b>今すぐ電話</b><small>24時間受付</small></a>
      <a href={company.lineUrl} data-cta="improved_fixed_line"><span>LINE</span><b>写真で相談</b><small>見積り無料</small></a>
    </nav>
  </div>
</Layout>

<script is:inline>
  (function () {
    function alignHashTarget() {
      if (!location.hash || location.hash.length < 2) return;
      var target;
      try {
        target = document.querySelector(location.hash);
      } catch (_) {
        return;
      }
      if (!target) return;
      var header = document.querySelector(".cv-header");
      var offset = header ? header.offsetHeight + 8 : 8;
      var top = target.getBoundingClientRect().top + window.scrollY - offset;
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo(0, Math.max(0, top));
      document.documentElement.style.removeProperty("scroll-behavior");
    }

    document.addEventListener("DOMContentLoaded", alignHashTarget);
    window.addEventListener("load", function () {
      setTimeout(alignHashTarget, 180);
    });
  })();
</script>

<style is:global>
  :root {
    --cv-red: #c91f1f;
    --cv-red-dark: #971313;
    --cv-yellow: #ffc400;
    --cv-ink: #111923;
    --cv-cream: #fff8e8;
    --cv-green: #06c755;
    --cv-line: #e6dfd0;
  }

  body { background: #fff; }
  .cv-page { color: var(--cv-ink); background: #fff; padding-bottom: 74px; }
  .cv-shell { width: min(100% - 32px, 1060px); margin-inline: auto; }

  .cv-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.98);
    border-bottom: 3px solid var(--cv-yellow);
    box-shadow: 0 4px 18px rgba(17,25,35,.1);
  }
  .cv-header-inner { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cv-brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .cv-brand img { width: 42px; height: 42px; flex: 0 0 auto; }
  .cv-brand span { display: grid; min-width: 0; line-height: 1.25; }
  .cv-brand small { color: #6d7480; font-size: .67rem; font-weight: 700; }
  .cv-brand strong { font-size: clamp(.78rem, 2.5vw, 1.02rem); white-space: nowrap; }
  .cv-header-actions { display: flex; align-items: center; gap: 8px; }
  .cv-header-line { display: none; background: var(--cv-green); color: #fff; padding: 9px 13px; border-radius: 8px; font-weight: 900; }
  .cv-header-tel { display: grid; text-align: right; line-height: 1.08; color: var(--cv-red); }
  .cv-header-tel small { color: #5d6570; font-size: .66rem; font-weight: 700; }
  .cv-header-tel strong { font-family: var(--font-num); font-size: clamp(1rem, 4vw, 1.35rem); white-space: nowrap; }

  .cv-hero {
    overflow: hidden;
    padding: 12px 0 22px;
    background:
      linear-gradient(135deg, rgba(255,196,0,.95), rgba(255,144,0,.95)),
      repeating-linear-gradient(60deg, rgba(100,50,0,.08) 0 1px, transparent 1px 22px);
  }
  .cv-hero-alert {
    margin: 0 0 12px;
    padding: 7px 12px;
    border-radius: 8px;
    background: var(--cv-ink);
    color: #fff;
    font-size: .86rem;
    font-weight: 900;
    text-align: center;
  }
  .cv-hero-alert span { display: inline-block; margin-right: 8px; padding: 2px 8px; background: var(--cv-red); border-radius: 4px; font-size: 1.05rem; }
  .cv-hero-grid { display: grid; gap: 12px; }
  .cv-kicker { margin: 0 0 5px; font-size: .78rem; font-weight: 900; }
  .cv-hero h1 { margin: 0; font-size: clamp(1.75rem, 8.1vw, 3.5rem); line-height: 1.12; letter-spacing: -.04em; font-weight: 900; }
  .cv-hero h1 em { color: #fff; font-style: normal; text-shadow: 2px 2px 0 var(--cv-red-dark), -1px -1px 0 var(--cv-red-dark); }
  .cv-hero-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; padding: 0; margin: 11px 0 0; list-style: none; }
  .cv-hero-points li { padding: 6px 4px; border: 2px solid var(--cv-ink); border-radius: 7px; background: #fff; text-align: center; font-size: .65rem; font-weight: 700; line-height: 1.35; }
  .cv-hero-points strong { display: block; color: var(--cv-red); font-size: .77rem; }
  .cv-hero-visual { position: relative; margin: 0; border: 5px solid #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(68,35,0,.24); }
  .cv-hero-visual img { width: 100%; height: 188px; object-fit: cover; object-position: center 42%; }
  .cv-hero-visual figcaption { position: absolute; bottom: 4px; left: 7px; color: #fff; font-size: .6rem; text-shadow: 0 1px 3px #000; }
  .cv-hero-badge { position: absolute; top: 7px; right: 7px; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--cv-red); border: 3px solid #fff; color: #fff; text-align: center; line-height: 1.05; font-size: .65rem; font-weight: 900; transform: rotate(5deg); }
  .cv-hero-badge strong { font-size: 1rem; }

  .cv-offer { margin-top: 10px; padding: 10px; border: 3px solid var(--cv-ink); border-radius: 10px; background: #fff; box-shadow: 4px 4px 0 var(--cv-ink); }
  .cv-offer-price { display: flex; align-items: flex-end; justify-content: center; gap: 8px; line-height: 1; }
  .cv-offer-price > span { padding-bottom: 5px; font-size: .76rem; font-weight: 900; }
  .cv-offer-price strong { color: var(--cv-red); font-family: var(--font-num); font-size: clamp(2.4rem, 12vw, 4rem); letter-spacing: -.05em; }
  .cv-offer-price strong small { margin-right: 3px; color: var(--cv-ink); font-size: .58rem; letter-spacing: 0; }
  .cv-offer-price strong em { margin-left: 3px; font: 900 .9rem var(--font-sans); font-style: normal; letter-spacing: 0; }
  .cv-offer-free { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 8px; padding: 7px; background: var(--cv-cream); font-size: .67rem; font-weight: 800; }
  .cv-offer-free b { padding: 2px 7px; border-radius: 999px; background: var(--cv-yellow); color: var(--cv-ink); }
  .cv-offer p { margin: 6px 0 0; color: #59616d; font-size: .62rem; line-height: 1.45; }

  .cv-hero-cta { display: grid; grid-template-columns: 1.35fr .9fr; gap: 7px; margin-top: 11px; }
  .cv-call, .cv-line { min-height: 72px; border-radius: 10px; color: #fff; box-shadow: 0 5px 0 rgba(0,0,0,.22); }
  .cv-call { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 7px 8px; background: linear-gradient(#dc2a2a, #a90f0f); }
  .cv-call-icon { font-size: 1.45rem; }
  .cv-call > span:last-child { display: grid; line-height: 1.05; }
  .cv-call small { font-size: .62rem; font-weight: 900; }
  .cv-call strong { font-family: var(--font-num); font-size: clamp(1.05rem, 4.6vw, 1.45rem); white-space: nowrap; }
  .cv-call em { font-size: .57rem; font-style: normal; }
